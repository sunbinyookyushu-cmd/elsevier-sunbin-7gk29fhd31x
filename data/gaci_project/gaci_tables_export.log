. *------------------------------------------------------------------------------
. * TAB2: heterogeneity (robust), 3 outcomes per subgroup
. *------------------------------------------------------------------------------
. capture program drop _t2

. program define _t2
  1.     args lbl cond
  2.     foreach yv in trade_share trade_intensity ln_tradevol {
  3.         local extra ""
  4.         if "`yv'" == "ln_tradevol" local extra "lngdp"
  5.         capture noisily quietly ivreghdfe `yv' lnpop ln_sea_ma `extra' (lng = feyrer_int) if `cond', absorb(isocode y) robust
  6.         if _rc == 0 {
  7.             noisily di "TAB2|`lbl'|`yv'|" _b[lng] "|" _se[lng] "|" 2*ttail(e(df_r), abs(_b[lng]/_se[lng])) "|" e(widstat) "|" e(N)
  8.         }
  9.     }
 10. end

