. *------------------------------------------------------------------------------
. * TAB1: main (loop over outcome x treatment). extra control lngdp for ln_tradevol.
. *------------------------------------------------------------------------------
. capture program drop _t1

. program define _t1
  1.     args yv treat extra
  2.     quietly {
  3.         reghdfe `yv' `treat' lnpop ln_sea_ma `extra', absorb(isocode y) vce(robust)
  4.         local ob = _b[`treat']
  5.         local op = 2*ttail(e(df_r), abs(_b[`treat']/_se[`treat']))
  6.         ivreghdfe `yv' lnpop ln_sea_ma `extra' (`treat' = feyrer_int), absorb(isocode y) robust
  7.         local b  = _b[`treat']
  8.         local sr = _se[`treat']
  9.         local pr = 2*ttail(e(df_r), abs(`b'/`sr'))
 10.         local F  = e(widstat)
 11.         local N  = e(N)
 12.         ivreghdfe `yv' lnpop ln_sea_ma `extra' (`treat' = feyrer_int), absorb(isocode y) cluster(isocode)
 13.         local sc = _se[`treat']
 14.         local pc = 2*ttail(e(df_r), abs(_b[`treat']/`sc'))
 15.     }
 16.     noisily di "TAB1|`yv'|`treat'|`b'|`sr'|`pr'|`sc'|`pc'|`F'|`ob'|`op'|`N'"
 17. end

