. encode c, gen(isocode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. 
. gen g_int = merch_intensity              // openness

. gen g_vol = merch_intensity + lngdp      // volume

. gen g_gdp = lngdp                        // GDP

. gen post  = (y>=2010)

. 
. capture which ivreghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
.     ssc install ivreghdfe, replace
. }

. capture which esttab

. if _rc {
.     ssc install estout, replace
. }

. 
. eststo clear

. 
. * ---------- (A) pre / post 2010 split ----------
. foreach yv in g_int g_vol g_gdp {
  2.     ivreghdfe `yv' lnpop (ln_gaci_cwm = tourism_int) if y<2010, ///
>         absorb(isocode y) robust
  3.     eststo pre_`yv'
  4.     estadd scalar KPF = e(widstat)
  5. 
.     ivreghdfe `yv' lnpop (ln_gaci_cwm = tourism_int) if y>=2010, ///
>         absorb(isocode y) robust
  6.     eststo post_`yv'
  7.     estadd scalar KPF = e(widstat)
  8. }
