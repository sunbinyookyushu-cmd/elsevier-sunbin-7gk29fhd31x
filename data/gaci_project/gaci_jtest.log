. do gaci_jtest.do 

. *============================================================================
> ==
. * gaci_jtest.do  --  Overidentification (Hansen/Sargan J) test with BOTH inst
> ruments
. *   instruments : lnz (leave-out market access) + ln_unesco_nat (natural heri
> tage)
. *   logic       : 2 instruments, 1 endogenous -> overidentified -> J test of 
> joint
. *                 exclusion validity.  Shown for treatment = lng and = ln_gac
> i_cwm,
. *                 both robust(no cluster) [Sargan] and cluster(isocode) [Hans
> en J].
. *   read-with   : the two JUST-identified betas (lnz-only vs UNESCO-only) are
>  printed
. *                 first; if they disagree, J rejects (at least one exclusion 
> fails).
. *   FE          : region + year (absorb regcode y)
. *============================================================================
> ==
. clear all

. set more off

. version 14

. cd "C:/Users/sunbi/managi-lab Dropbox/Sunbin Yoo/Research Box ^-^/2026/GACI"
C:\Users\sunbi\managi-lab Dropbox\Sunbin Yoo\Research Box ^-^\2026\GACI

. import delimited "gaci_panel.csv", clear varnames(1) encoding("utf-8")
(34 vars, 4,714 obs)

. ds c reg, not
y             lncap         lnz_own       deg_mean      regimp_sum
trade_share   gaci_cwmean   lnpc          eig_sum       regimp_mean
ln_tradevol   gaci_mean     lnpop         eig_mean      cap_sum
lngdp         ln_unesco     lnland        close_sum     cap_mean
lng           unesco_cum    abslat        close_mean
ln_gaci_cwm   unesco_cum~t  n_air         betw_sum
ln_gaci_mean  lnz           deg_sum       betw_mean

. destring `r(varlist)', replace force
y already numeric; no replace
trade_share already numeric; no replace
ln_tradevol already numeric; no replace
lngdp already numeric; no replace
lng already numeric; no replace
ln_gaci_cwm already numeric; no replace
ln_gaci_mean already numeric; no replace
lncap already numeric; no replace
gaci_cwmean already numeric; no replace
gaci_mean already numeric; no replace
ln_unesco already numeric; no replace
unesco_cum already numeric; no replace
unesco_cum_nat already numeric; no replace
lnz already numeric; no replace
lnz_own already numeric; no replace
lnpc already numeric; no replace
lnpop already numeric; no replace
lnland already numeric; no replace
abslat already numeric; no replace
n_air already numeric; no replace
deg_sum already numeric; no replace
deg_mean already numeric; no replace
eig_sum already numeric; no replace
eig_mean already numeric; no replace
close_sum already numeric; no replace
close_mean already numeric; no replace
betw_sum already numeric; no replace
betw_mean already numeric; no replace
regimp_sum already numeric; no replace
regimp_mean already numeric; no replace
cap_sum already numeric; no replace
cap_mean already numeric; no replace

. encode c, gen(isocode)

. encode reg, gen(regcode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. gen trade_intensity = ln_tradevol - lngdp

. replace ln_unesco = ln(1 + unesco_cum)
(4,714 real changes made)

. gen ln_unesco_nat = ln(1 + unesco_cum_nat)

. 
