. capture program drop _hcell

. program define _hcell
  1.     args lbl cond
  2.     foreach yv in merch_intensity merch_share {
  3.         capture noisily quietly ivreghdfe `yv' lnpop (lng = tourism_int) if `cond', absorb(isocode y) robust
  4.         if _rc == 0 {
  5.             local b  = _b[lng]
  6.             local se = _se[lng]
  7.             local p  = 2*ttail(e(df_r), abs(`b'/`se'))
  8.             local F  = e(widstat)
  9.             noisily di "REST|" %-16s "`yv'" "|" %-12s "`lbl'" "|b=" %10.4f `b' "|se=" %9.4f `se' "|p=" %6.4f `p' "|KPF=" %8.2f `F' "|N=" %5.0f e(N)
 10.         }
 11.         else noisily di "REST|`yv'|`lbl'|FAILED rc=" _rc
 12.     }
 13. end

. 
