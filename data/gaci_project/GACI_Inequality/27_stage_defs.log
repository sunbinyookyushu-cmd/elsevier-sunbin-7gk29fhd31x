(file _stage_defs_results.csv not found)

. file write `fh' "defn,group,outcome,b,se,p,kpf,N,Nc" _n

. capture program drop runone

. program define runone
  1.     args fh defn grp yv cond
  2.     quietly count if `cond' & !missing(`yv', ln_gaci_max, feyrer_int, lnpop)
  3.     if r(N) < 60 exit
  4.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if `cond', absorb(isocode y) cluster(isocode)
  5.     if _rc exit
  6.     local b = _b[ln_gaci_max]
  7.     local se = _se[ln_gaci_max]
  8.     local p = 2*normal(-abs(`b'/`se'))
  9.     quietly levelsof isocode if e(sample), local(cc)
 10.     local nc : word count `cc'
 11.     file write `fh' "`defn',`grp',`yv',`b',`se',`p',`=e(widstat)',`=e(N)',`nc'" _n
 12. end

. local OUTS "ln_gini_mkt ln_apt_all ln_apt_top_bot ln_spt_b50 ln_spt_d10"

. foreach yv of local OUTS {
  2.     foreach dv in g_max96_t3 g_max9600_t3 g_maxall_t3 g_cwm96_t3 g_sum96_t3 g_share96_t3 g_airma96_t3 g_max96_wcont {
  3.         runone `fh' "`dv'" "1_low" `yv' "`dv' == 1"
  4.         runone `fh' "`dv'" "2_mid" `yv' "`dv' == 2"
  5.         runone `fh' "`dv'" "3_high" `yv' "`dv' == 3"
  6.     }
  7.     runone `fh' "g_max96_q4" "1_q1" `yv' "g_max96_q4 == 1"
  8.     runone `fh' "g_max96_q4" "2_q2" `yv' "g_max96_q4 == 2"
  9.     runone `fh' "g_max96_q4" "3_q3" `yv' "g_max96_q4 == 3"
 10.     runone `fh' "g_max96_q4" "4_q4" `yv' "g_max96_q4 == 4"
 11.     runone `fh' "g_max96_med" "1_below" `yv' "g_max96_med == 1"
 12.     runone `fh' "g_max96_med" "2_above" `yv' "g_max96_med == 2"
 13. }
