. 
. * ---- country-level bases ----
. foreach v in gaci_max gaci_cwmean gaci_sum share_max ln_air_ma {
  2.     bysort isocode (y): gen byte f_ = sum(!missing(`v')) == 1 & !missing(`v')
  3.     gen t_ = `v' if f_
  4.     bysort isocode (t_): gen `v'_96 = t_[1]
  5.     drop f_ t_
  6.     egen `v'_all = mean(`v'), by(isocode)
  7.     gen t2_ = `v' if y <= 2000
  8.     egen `v'_9600 = mean(t2_), by(isocode)
  9.     drop t2_
 10. }
