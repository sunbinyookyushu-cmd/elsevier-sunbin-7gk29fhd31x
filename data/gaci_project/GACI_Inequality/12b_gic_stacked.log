. drop if missing(ln_apt) | missing(ln_gaci_max) | missing(feyrer_int) | missing(lnpop)
(256 observations deleted)

. egen cg = group(isocode grp)

. egen yg = group(y grp)

. egen ygc = group(y grp contid)

. forvalues g = 1/12 {
  2.     gen x`g' = ln_gaci_max * (grp == `g')
  3.     gen z`g' = feyrer_int * (grp == `g')
  4.     gen w`g' = tourism_int * (grp == `g')
  5.     gen p`g' = lnpop * (grp == `g')
  6. }

. global XL ""

. global ZL ""

. global WL ""

. global PL ""

. global PL10 ""

. forvalues g = 1/12 {
  2.     global XL "$XL x`g'"
  3.     global ZL "$ZL z`g'"
  4.     global WL "$WL w`g'"
  5.     global PL "$PL p`g'"
  6.     if `g' <= 10 global PL10 "$PL10 p`g'"
  7. }

. * centred decile rank for the trend specification (deciles only)
. gen rankc = grp - 5.5

. gen xr = ln_gaci_max * rankc

. gen zr = feyrer_int * rankc

. gen wr = tourism_int * rankc

. 
. tempname fh

