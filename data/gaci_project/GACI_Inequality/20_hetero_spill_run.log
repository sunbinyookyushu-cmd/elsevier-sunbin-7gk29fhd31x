. tempname H

. file open `H' using "_hetero_co2form_results.csv", write replace

. file write `H' "panel,group,outcome,b,se,p,kpf,N,Nc" _n

. 
. capture program drop runcell

. program define runcell
  1.     args fh panel grp yv cond
  2.     quietly count if `cond' & !missing(`yv', ln_gaci_max, feyrer_int, lnpop)
  3.     if r(N) < 60 {
  4.         di as err "SKIP `panel' `grp' `yv': N = " r(N)
  5.         exit
  6.     }
  7.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if `cond', absorb(isocode y) cluster(isocode)
  8.     if _rc exit
  9.     local b = _b[ln_gaci_max]
 10.     local se = _se[ln_gaci_max]
 11.     local p = 2*normal(-abs(`b'/`se'))
 12.     quietly levelsof isocode if e(sample), local(cc)
 13.     local nc : word count `cc'
 14.     file write `fh' "`panel',`grp',`yv',`b',`se',`p',`=e(widstat)',`=e(N)',`nc'" _n
 15. end

. 
. foreach yv in ln_gini_mkt ln_gini_disp ln_apt_top_bot ln_apt_d10 ln_spt_b50 {
  2.     * A) baseline income terciles
.     runcell `H' "A_income" "inc_low" `yv' "inc3 == 1"
  3.     runcell `H' "A_income" "inc_mid" `yv' "inc3 == 2"
  4.     runcell `H' "A_income" "inc_high" `yv' "inc3 == 3"
  5.     capture drop hi_ ma_x_ iv_x_
  6.     gen byte hi_ = inc3 == 3 if !missing(inc3)
  7.     gen ma_x_ = ln_gaci_max * hi_
  8.     gen iv_x_ = feyrer_int * hi_
  9.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_max ma_x_ = feyrer_int iv_x_), absorb(isocode y) cluster(isocode)
 10.     if _rc == 0 file write `H' "A_income,interact_top_x_gaci,`yv',`=_b[ma_x_]',`=_se[ma_x_]',`=2*normal(-abs(_b[ma_x_]/_se[ma_x_]))',`=e(widstat)',`=e(N)',." _n
 11.     * B) baseline connectivity terciles
.     runcell `H' "B_conn" "con_low" `yv' "con3 == 1"
 12.     runcell `H' "B_conn" "con_mid" `yv' "con3 == 2"
 13.     runcell `H' "B_conn" "con_high" `yv' "con3 == 3"
 14.     capture drop hi_ ma_x_ iv_x_
 15.     gen byte hi_ = con3 == 3 if !missing(con3)
 16.     gen ma_x_ = ln_gaci_max * hi_
 17.     gen iv_x_ = feyrer_int * hi_
 18.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_max ma_x_ = feyrer_int iv_x_), absorb(isocode y) cluster(isocode)
 19.     if _rc == 0 file write `H' "B_conn,interact_top_x_gaci,`yv',`=_b[ma_x_]',`=_se[ma_x_]',`=2*normal(-abs(_b[ma_x_]/_se[ma_x_]))',`=e(widstat)',`=e(N)',." _n
 20.     * C) baseline market-Gini terciles
.     runcell `H' "C_gini" "gini_low" `yv' "gin3 == 1"
 21.     runcell `H' "C_gini" "gini_mid" `yv' "gin3 == 2"
 22.     runcell `H' "C_gini" "gini_high" `yv' "gin3 == 3"
 23.     capture drop hi_ ma_x_ iv_x_
 24.     gen byte hi_ = gin3 == 3 if !missing(gin3)
 25.     gen ma_x_ = ln_gaci_max * hi_
 26.     gen iv_x_ = feyrer_int * hi_
 27.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_max ma_x_ = feyrer_int iv_x_), absorb(isocode y) cluster(isocode)
 28.     if _rc == 0 file write `H' "C_gini,interact_top_x_gaci,`yv',`=_b[ma_x_]',`=_se[ma_x_]',`=2*normal(-abs(_b[ma_x_]/_se[ma_x_]))',`=e(widstat)',`=e(N)',." _n
 29.     * D) temporal split
.     runcell `H' "D_time" "full" `yv' "1"
 30.     runcell `H' "D_time" "1996_2007" `yv' "y <= 2007"
 31.     runcell `H' "D_time" "2010_2023_ex2020_21" `yv' "y >= 2010 & !inlist(y, 2020, 2021)"
 32.     runcell `H' "D_time" "2010_2023" `yv' "y >= 2010"
 33.     runcell `H' "D_time" "excl_2020_2023" `yv' "y <= 2019"
 34.     * E) macro regions
.     runcell `H' "E_region" "Europe" `yv' "is_EU == 1"
 35.     runcell `H' "E_region" "Asia" `yv' "is_AS == 1"
 36.     runcell `H' "E_region" "Africa" `yv' "is_AF == 1"
 37.     runcell `H' "E_region" "LatAm" `yv' "is_LA == 1"
 38.     runcell `H' "E_region" "MiddleEast" `yv' "is_ME == 1"
 39.     runcell `H' "E_region" "excl_Europe" `yv' "is_EU == 0"
 40.     runcell `H' "E_region" "excl_LatAm" `yv' "is_LA == 0"
 41. }
