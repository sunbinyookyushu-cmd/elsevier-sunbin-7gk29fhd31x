. file close `H'

. 
. * =====================================================================
. * Spillovers
. * =====================================================================
. tempname S

. file open `S' using "_spill_results.csv", write replace
(file _spill_results.csv not found)

. file write `S' "panel,item,var,outcome,b,se,p,kpf,N" _n

. capture program drop postone

. program define postone
  1.     args fh panel item v yv
  2.     local bb = _b[`v']
  3.     local sse = _se[`v']
  4.     local pp = 2*normal(-abs(`bb'/`sse'))
  5.     file write `fh' "`panel',`item',`v',`yv',`bb',`sse',`pp',`=e(widstat)',`=e(N)'" _n
  6. end

. 
. foreach yv in ln_gini_mkt ln_gini_disp ln_apt_top_bot {
  2.     * A1 own as exogenous control, neighbour instrumented (inverse distance)
.     capture noisily ivreghdfe `yv' ln_gaci_max lnpop (nbr_g_inv = nbr_f_inv), absorb(isocode y) cluster(isocode)
  3.     if _rc == 0 {
  4.         postone `S' A own_exog_control nbr_g_inv `yv'
  5.         postone `S' A own_exog_control ln_gaci_max `yv'
  6.     }
  7.     * A2 hybrid: own shifter in reduced form
.     capture noisily ivreghdfe `yv' feyrer_int lnpop (nbr_g_inv = nbr_f_inv), absorb(isocode y) cluster(isocode)
  8.     if _rc == 0 {
  9.         postone `S' A hybrid_rf_control nbr_g_inv `yv'
 10.         postone `S' A hybrid_rf_control feyrer_int `yv'
 11.     }
 12.     * A3 joint IV under alternative W (own instrumented by own shifter, neighbour by neighbours' shifters)
.     foreach W in inv contig knn5 b1 k500 k1000 {
 13.         capture noisily ivreghdfe `yv' lnpop has_contig (ln_gaci_max nbr_g_`W' = feyrer_int nbr_f_`W'), absorb(isocode y) cluster(isocode)
 14.         if _rc == 0 {
 15.             postone `S' A joint_`W' ln_gaci_max `yv'
 16.             postone `S' A joint_`W' nbr_g_`W' `yv'
 17.         }
 18.     }
 19.     * A4 single-endogenous neighbour effect under each W, hybrid control
.     foreach W in inv contig knn5 b1 k500 k1000 {
 20.         capture noisily ivreghdfe `yv' feyrer_int lnpop has_contig (nbr_g_`W' = nbr_f_`W'), absorb(isocode y) cluster(isocode)
 21.         if _rc == 0 postone `S' A single_`W' nbr_g_`W' `yv'
 22.     }
 23.     * B distance bands jointly and singly; kernel grid
.     capture noisily ivreghdfe `yv' feyrer_int lnpop has_b1 has_b2 has_b3 has_b4 has_b5 (nbr_g_b1 nbr_g_b2 nbr_g_b3 nbr_g_b4 nbr_g_b5 = nbr_f_b1 nbr_f_b2 nbr_f_b3 nbr_f_b4 nbr_f_b5), absorb(isocode y) cluster(isocode)
 24.     if _rc == 0 {
 25.         foreach b in b1 b2 b3 b4 b5 {
 26.             postone `S' B bands_joint nbr_g_`b' `yv'
 27.         }
 28.     }
 29.     foreach b in contig b1 b2 b3 b4 b5 {
 30.         capture noisily ivreghdfe `yv' feyrer_int lnpop has_`b' (nbr_g_`b' = nbr_f_`b'), absorb(isocode y) cluster(isocode)
 31.         if _rc == 0 postone `S' B band_single nbr_g_`b' `yv'
 32.     }
 33.     foreach lam in 250 500 1000 2000 5000 {
 34.         capture noisily ivreghdfe `yv' feyrer_int lnpop (nbr_g_k`lam' = nbr_f_k`lam'), absorb(isocode y) cluster(isocode)
 35.         if _rc == 0 postone `S' B kernel nbr_g_k`lam' `yv'
 36.     }
 37.     * C regional: within vs outside sub-region / bloc; sub-region x year FE with contiguity
.     capture noisily ivreghdfe `yv' feyrer_int lnpop has_inreg (nbr_g_inreg nbr_g_outreg = nbr_f_inreg nbr_f_outreg), absorb(isocode y) cluster(isocode)
 38.     if _rc == 0 {
 39.         postone `S' C subregion_inout nbr_g_inreg `yv'
 40.         postone `S' C subregion_inout nbr_g_outreg `yv'
 41.     }
 42.     capture noisily ivreghdfe `yv' feyrer_int lnpop has_inbloc (nbr_g_inbloc nbr_g_outbloc = nbr_f_inbloc nbr_f_outbloc), absorb(isocode y) cluster(isocode)
 43.     if _rc == 0 {
 44.         postone `S' C bloc_inout nbr_g_inbloc `yv'
 45.         postone `S' C bloc_inout nbr_g_outbloc `yv'
 46.     }
 47.     capture noisily ivreghdfe `yv' lnpop has_contig (ln_gaci_max nbr_g_contig = feyrer_int nbr_f_contig), absorb(isocode sry) cluster(isocode)
 48.     if _rc == 0 {
 49.         postone `S' C contig_joint_subregXyear ln_gaci_max `yv'
 50.         postone `S' C contig_joint_subregXyear nbr_g_contig `yv'
 51.     }
 52.     capture noisily ivreghdfe `yv' feyrer_int lnpop has_contig (nbr_g_contig = nbr_f_contig), absorb(isocode sry) cluster(isocode)
 53.     if _rc == 0 postone `S' C contig_hybrid_subregXyear nbr_g_contig `yv'
 54. }
(dropped 2 singleton observations)
(MWFE estimator converged in 6 iterations)

