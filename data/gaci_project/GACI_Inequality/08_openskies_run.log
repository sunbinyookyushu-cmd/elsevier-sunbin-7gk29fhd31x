(906 observations deleted)

. gen cont = substr(reg,1,2)

. encode cont, gen(contid)

. * baseline (first observed year) income and inequality terciles, fixed per country
. bysort isocode (y): gen basepc = lnpc[1]

. bysort isocode (y): gen basegini = gini_mkt[1]

. bysort isocode (y): gen baseshare = share_max[1]

. bysort isocode (y): gen firsty = y[1]

. preserve

. bysort isocode: keep if _n==1
(3,571 observations deleted)

. xtile inc3 = basepc, nq(3)

. xtile gini3 = basegini, nq(3)

. gen conc2 = (baseshare > 0.5)

. keep isocode inc3 gini3 conc2

. tempfile grp

. save `grp'
file C:\Users\sunbi\AppData\Local\Temp\ST_ba08_000002.tmp saved

. restore

. merge m:1 isocode using `grp', nogen
(label isocode already defined)

    Result                           # of obs.
    -----------------------------------------
    not matched                             0
    matched                             3,737  
    -----------------------------------------

. gen post2010 = (y>=2010)

. gen midinc = (inc3==2)

. gen highinc = (inc3==3)

. foreach v in ln_gaci_max ln_gaci_cwm ln_gaci_sum feyrer_int tourism_int {
  2.     gen `v'_mid = `v'*midinc
  3.     gen `v'_high = `v'*highinc
  4.     gen `v'_post = `v'*post2010
  5.     gen `v'_conc = `v'*conc2
  6.     gen `v'_g2 = `v'*(gini3==2)
  7.     gen `v'_g3 = `v'*(gini3==3)
  8. }

. gen tophub = inlist(c,"DEU","USA","FRA","NLD","GBR") | inlist(c,"CHN","CAN","SGP","ARE","THA")

. sort isocode y

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. 
end of do-file

. * Open Skies staggered adoption: drop always-treated (applied before 1997)
. drop if os_year<=1996 & !missing(os_year)
(346 observations deleted)

. gen treated = !missing(os_year)

. * event-time dummies, window -6..+10 with binned endpoints, omit t=-1
. gen evt = os_evt
(910 missing values generated)

. replace evt = -6 if evt < -6 & !missing(evt)
(528 real changes made)

. replace evt = 10 if evt > 10 & !missing(evt)
(609 real changes made)

. forvalues k = 6(-1)2 {
  2.     gen ev_m`k' = (evt==-`k')
  3. }

. forvalues k = 0/10 {
  2.     gen ev_p`k' = (evt==`k')
  3. }

. tempname fh

. file open `fh' using "_openskies_results.csv", write replace
(note: file _openskies_results.csv not found)

. file write `fh' "block,outcome,term,b,se,p,kpf,N" _n

. foreach yv in ln_gaci_max ln_gaci_cwm ln_gaci_sum ln_gini_mkt ln_gini_disp ln_bot50_wid ln_top10_wid {
  2.     * A. TWFE DiD
.     reghdfe `yv' post_os lnpop, absorb(isocode y) cluster(isocode)
  3.     local b = _b[post_os]
  4.     local se = _se[post_os]
  5.     local p = 2*ttail(e(df_r), abs(`b'/`se'))
  6.     local nn = e(N)
  7.     file write `fh' "did,`yv',post_os,`b',`se',`p',.,`nn'" _n
  8.     reghdfe `yv' post_os lnpop, absorb(isocode contid#y) cluster(isocode)
  9.     local b = _b[post_os]
 10.     local se = _se[post_os]
 11.     local p = 2*ttail(e(df_r), abs(`b'/`se'))
 12.     local nn = e(N)
 13.     file write `fh' "did_contyear,`yv',post_os,`b',`se',`p',.,`nn'" _n
 14.     * B. event study (TWFE)
.     reghdfe `yv' ev_m6 ev_m5 ev_m4 ev_m3 ev_m2 ev_p0-ev_p10 lnpop, absorb(isocode y) cluster(isocode)
 15.     local nn = e(N)
 16.     foreach t in ev_m6 ev_m5 ev_m4 ev_m3 ev_m2 ev_p0 ev_p1 ev_p2 ev_p3 ev_p4 ev_p5 ev_p6 ev_p7 ev_p8 ev_p9 ev_p10 {
 17.         local b = _b[`t']
 18.         local se = _se[`t']
 19.         local p = 2*ttail(e(df_r), abs(`b'/`se'))
 20.         file write `fh' "es,`yv',`t',`b',`se',`p',.,`nn'" _n
 21.     }
 22.     test ev_m6 ev_m5 ev_m4 ev_m3 ev_m2
 23.     file write `fh' "es_pretrend_F,`yv',joint_pre,`r(F)',.,`r(p)',.,`nn'" _n
 24. }
