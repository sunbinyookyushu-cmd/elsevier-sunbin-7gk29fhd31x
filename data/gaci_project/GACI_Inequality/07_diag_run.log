. keep if !missing(gini_mkt)
(906 observations deleted)

. gen cont = substr(reg,1,2)

. encode cont, gen(contid)

. * baseline (first observed year) income and inequality terciles, fixed per country
. bysort isocode (y): gen basepc = lnpc[1]

. bysort isocode (y): gen basegini = gini_mkt[1]

. bysort isocode (y): gen baseshare = share_max[1]

. bysort isocode (y): gen firsty = y[1]

. preserve

. bysort isocode: keep if _n==1
(3,571 observations deleted)

. xtile inc3 = basepc, nq(3)

. xtile gini3 = basegini, nq(3)

. gen conc2 = (baseshare > 0.5)

. keep isocode inc3 gini3 conc2

. tempfile grp

. save `grp'
file C:\Users\sunbi\AppData\Local\Temp\ST_c40_000002.tmp saved

. restore

. merge m:1 isocode using `grp', nogen
(label isocode already defined)

    Result                           # of obs.
    -----------------------------------------
    not matched                             0
    matched                             3,737  
    -----------------------------------------

. gen post2010 = (y>=2010)

. gen midinc = (inc3==2)

. gen highinc = (inc3==3)

. foreach v in ln_gaci_max ln_gaci_cwm ln_gaci_sum feyrer_int tourism_int {
  2.     gen `v'_mid = `v'*midinc
  3.     gen `v'_high = `v'*highinc
  4.     gen `v'_post = `v'*post2010
  5.     gen `v'_conc = `v'*conc2
  6.     gen `v'_g2 = `v'*(gini3==2)
  7.     gen `v'_g3 = `v'*(gini3==3)
  8. }

. gen tophub = inlist(c,"DEU","USA","FRA","NLD","GBR") | inlist(c,"CHN","CAN","SGP","ARE","THA")

. sort isocode y

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. 
end of do-file

. * exposure x trend controls (shift-share validity checks)
. gen at_basepc = a_t*basepc

. gen at_basegini = a_t*basegini

. gen at_lnland = a_t*lnland

. gen at_abslat = a_t*abslat

. gen at_seama = a_t*ln_sea_ma

. bysort isocode (y): gen basetrade = trade_share[1]

. gen at_basetrade = a_t*basetrade

. tempname fh

. file open `fh' using "_diag_results.csv", write replace
(note: file _diag_results.csv not found)

. file write `fh' "block,outcome,spec,term,b,se,p,kpf,N" _n

. * A. per-continent first stage and reduced form, both IVs
. levelsof cont, local(cl)
`"AF"' `"AS"' `"EU"' `"LA"' `"ME"' `"NA"' `"SW"'

. foreach ivv in feyrer_int tourism_int {
  2.     foreach cc of local cl {
  3.         capture reghdfe ln_gaci_max `ivv' lnpop if cont=="`cc'", absorb(isocode y) vce(robust)
  4.         if _rc==0 {
  5.             local b = _b[`ivv']
  6.             local se = _se[`ivv']
  7.             local p = 2*ttail(e(df_r), abs(`b'/`se'))
  8.             local nn = e(N)
  9.             test `ivv'
 10.             local F = r(F)
 11.             file write `fh' "fs_cont,ln_gaci_max,`ivv',`cc',`b',`se',`p',`F',`nn'" _n
 12.             reghdfe ln_gini_mkt `ivv' lnpop if cont=="`cc'", absorb(isocode y) vce(robust)
 13.             local b = _b[`ivv']
 14.             local se = _se[`ivv']
 15.             local p = 2*ttail(e(df_r), abs(`b'/`se'))
 16.             local nn = e(N)
 17.             file write `fh' "rf_cont,ln_gini_mkt,`ivv',`cc',`b',`se',`p',.,`nn'" _n
 18.         }
 19.     }
 20. }

