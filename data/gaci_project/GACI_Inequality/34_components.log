. tempname fh

. file open `fh' using "_components_results.csv", write replace
(file _components_results.csv not found)

. file write `fh' "block,item,outcome,term,b,se,p,kpf,N" _n

. capture program drop wr

. program define wr
  1.     args fh blk item yv term kp
  2.     local b = _b[`term']
  3.     local se = _se[`term']
  4.     local p = 2*normal(-abs(`b'/`se'))
  5.     file write `fh' "`blk',`item',`yv',`term',`b',`se',`p',`kp',`=e(N)'" _n
  6. end

. local COMP "gaci cap deg eig close betw regimp"

. * ---- A. first stages ----
. foreach k of local COMP {
  2.     quietly reghdfe ln_hub_`k' feyrer_int lnpop, absorb(isocode y) vce(cluster isocode)
  3.     wr `fh' A firststage ln_hub_`k' feyrer_int .
  4. }

. * ---- B. each component as treatment ----
. foreach yv in ln_gini_mkt ln_gini_disp ln_spt_b50 ln_apt_top_bot {
  2.     foreach k of local COMP {
  3.         capture noisily ivreghdfe `yv' lnpop (ln_hub_`k' = feyrer_int), absorb(isocode y) cluster(isocode)
  4.         if _rc == 0 wr `fh' B iv_single `yv' ln_hub_`k' `=e(widstat)'
  5.         quietly reghdfe `yv' ln_hub_`k' lnpop, absorb(isocode y) vce(cluster isocode)
  6.         wr `fh' B ols_single `yv' ln_hub_`k' .
  7.     }
  8.     * ---- C. horse race: topology component instrumented, capacity as control; capacity instrumented, component as control ----
.     foreach k in deg eig close betw {
  9.         capture noisily ivreghdfe `yv' lnpop ln_hub_cap (ln_hub_`k' = feyrer_int), absorb(isocode y) cluster(isocode)
 10.         if _rc == 0 {
 11.             wr `fh' C topo_iv_cap_ctrl_`k' `yv' ln_hub_`k' `=e(widstat)'
 12.             wr `fh' C topo_iv_cap_ctrl_`k' `yv' ln_hub_cap `=e(widstat)'
 13.         }
 14.         capture noisily ivreghdfe `yv' lnpop ln_hub_`k' (ln_hub_cap = feyrer_int), absorb(isocode y) cluster(isocode)
 15.         if _rc == 0 {
 16.             wr `fh' C cap_iv_topo_ctrl_`k' `yv' ln_hub_cap `=e(widstat)'
 17.             wr `fh' C cap_iv_topo_ctrl_`k' `yv' ln_hub_`k' `=e(widstat)'
 18.         }
 19.     }
 20.     * ---- D. OLS with all components jointly ----
.     quietly reghdfe `yv' ln_hub_cap ln_hub_deg ln_hub_eig ln_hub_close ln_hub_betw lnpop, absorb(isocode y) vce(cluster isocode)
 21.     foreach k in cap deg eig close betw {
 22.         wr `fh' D ols_joint `yv' ln_hub_`k' .
 23.     }
 24.     * ---- E. hub component vs rest-of-network component (OLS, joint) ----
.     foreach k in cap betw eig {
 25.         quietly reghdfe `yv' ln_hub_`k' ln_rest_`k' lnpop, absorb(isocode y) vce(cluster isocode)
 26.         wr `fh' E ols_hub_vs_rest_`k' `yv' ln_hub_`k' .
 27.         wr `fh' E ols_hub_vs_rest_`k' `yv' ln_rest_`k' .
 28.     }
 29. }
