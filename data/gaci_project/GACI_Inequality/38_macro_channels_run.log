         Delta: 1 unit

. keep if !missing(gini_mkt)
(906 observations deleted)

. capture drop ln_spt_b50

. gen ln_spt_b50 = ln_apt_b50 - ln_apt_all
(21 missing values generated)

. gen ln_apt_top_bot = (ln_apt_d6 + ln_apt_d7 + ln_apt_d8 + ln_apt_d9 + ln_apt_d10)/5 - (ln_apt_d1 + ln_apt_d2 + ln_apt_d3 + ln_apt_d4 + ln_apt_d5)/5
(24 missing values generated)

. capture gen ln_labsh = ln(labsh)

. capture gen ln_priv_credit = ln(priv_credit) if priv_credit > 0

. capture gen ln_largest_city = ln(largest_city_sh) if largest_city_sh > 0

. capture gen ln_hitech = ln(hitech_exp_sh) if hitech_exp_sh > 0

. capture gen ln_ict_serv = ln(ict_serv_exp_sh) if ict_serv_exp_sh > 0

. capture gen ln_serv_exp_sh = ln(serv_exp_sh) if serv_exp_sh > 0

. tempname fh

. file open `fh' using "_macro_channels_results.csv", write replace

. file write `fh' "block,item,outcome,term,b,se,p,kpf,N" _n

. capture program drop wr

. program define wr
  1.     args fh blk item yv term kp
  2.     local b = _b[`term']
  3.     local se = _se[`term']
  4.     local p = 2*normal(-abs(`b'/`se'))
  5.     file write `fh' "`blk',`item',`yv',`term',`b',`se',`p',`kp',`=e(N)'" _n
  6. end

. local CH "ln_share_topreg ln_theil_reg share_topreg ln_largest_city primacy urban sh_diff sh_homog sh_hivw sh_x_hivw3 sh_capital sh_interm ln_tr_diff ln_tr_hivw ln_nprod ln_nflow ln_hitech ln_ict_serv ln_serv_exp_sh labsh ln_labsh ln_priv_credit gfcf_gd
> p resource_rents remit_gdp ind_va"

. * ---- A. a-paths ----
. foreach mv of local CH {
  2.     capture confirm variable `mv'
  3.     if _rc continue
  4.     quietly count if !missing(`mv', ln_gaci_max, feyrer_int, lnpop)
  5.     if r(N) < 100 continue
  6.     capture noisily ivreghdfe `mv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
  7.     if _rc == 0 wr `fh' A apath `mv' ln_gaci_max `=e(widstat)'
  8.     quietly reghdfe `mv' ln_gaci_max lnpop, absorb(isocode y) vce(cluster isocode)
  9.     wr `fh' A apath_ols `mv' ln_gaci_max .
 10. }
