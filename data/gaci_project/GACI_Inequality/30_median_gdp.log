. tempname fh

. file open `fh' using "_median_gdp_results.csv", write replace
(file _median_gdp_results.csv not found)

. file write `fh' "group,outcome,model,b,se,p,kpf,N,Nc" _n

. capture program drop runone

. program define runone
  1.     args fh grp yv cond
  2.     quietly count if `cond' & !missing(`yv', ln_gaci_max, feyrer_int, lnpop)
  3.     if r(N) < 60 exit
  4.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if `cond', absorb(isocode y) cluster(isocode)
  5.     if _rc exit
  6.     local b = _b[ln_gaci_max]
  7.     local se = _se[ln_gaci_max]
  8.     local p = 2*normal(-abs(`b'/`se'))
  9.     quietly levelsof isocode if e(sample), local(cc)
 10.     local nc : word count `cc'
 11.     file write `fh' "`grp',`yv',IV,`b',`se',`p',`=e(widstat)',`=e(N)',`nc'" _n
 12.     quietly reghdfe `yv' ln_gaci_max lnpop if `cond', absorb(isocode y) vce(cluster isocode)
 13.     local b = _b[ln_gaci_max]
 14.     local se = _se[ln_gaci_max]
 15.     local p = 2*ttail(e(df_r), abs(`b'/`se'))
 16.     file write `fh' "`grp',`yv',OLS,`b',`se',`p',.,`=e(N)',`nc'" _n
 17. end

. foreach yv in ln_gdppc lngdp ln_apt_all ln_gini_mkt ln_gini_disp {
  2.     runone `fh' "full" `yv' "1"
  3.     runone `fh' "med_below" `yv' "med2 == 1"
  4.     runone `fh' "med_above" `yv' "med2 == 2"
  5.     runone `fh' "ter_low" `yv' "ter3 == 1"
  6.     runone `fh' "ter_mid" `yv' "ter3 == 2"
  7.     runone `fh' "ter_high" `yv' "ter3 == 3"
  8.     runone `fh' "q1" `yv' "qua4 == 1"
  9.     runone `fh' "q2" `yv' "qua4 == 2"
 10.     runone `fh' "q3" `yv' "qua4 == 3"
 11.     runone `fh' "q4" `yv' "qua4 == 4"
 12. }
