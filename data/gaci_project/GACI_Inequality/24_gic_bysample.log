. tempname fh

. file open `fh' using "_gic_bysample_results.csv", write replace

. file write `fh' "sample,outcome,b,se,p,kpf,N,Nc" _n

. capture program drop runone

. program define runone
  1.     args fh smp yv cond
  2.     quietly count if `cond' & !missing(`yv', ln_gaci_max, feyrer_int, lnpop)
  3.     if r(N) < 60 exit
  4.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if `cond', absorb(isocode y) cluster(isocode)
  5.     if _rc exit
  6.     local b = _b[ln_gaci_max]
  7.     local se = _se[ln_gaci_max]
  8.     local p = 2*normal(-abs(`b'/`se'))
  9.     quietly levelsof isocode if e(sample), local(cc)
 10.     local nc : word count `cc'
 11.     file write `fh' "`smp',`yv',`b',`se',`p',`=e(widstat)',`=e(N)',`nc'" _n
 12. end

. local OUTS "ln_gini_mkt ln_gini_disp ln_apt_all ln_apt_top_bot"

. foreach g of local GRP {
  2.     local OUTS "`OUTS' ln_apt_`g' ln_spt_`g'"
  3. }

. foreach yv of local OUTS {
  2.     runone `fh' "full" `yv' "1"
  3.     runone `fh' "con_low" `yv' "con3 == 1"
  4.     runone `fh' "con_mid" `yv' "con3 == 2"
  5.     runone `fh' "con_high" `yv' "con3 == 3"
  6.     runone `fh' "con_lowmid" `yv' "con3 <= 2"
  7.     runone `fh' "era_1996_2007" `yv' "y <= 2007"
  8.     runone `fh' "era_2010_2023x" `yv' "y >= 2010 & !inlist(y, 2020, 2021)"
  9.     runone `fh' "con_mid_era1" `yv' "con3 == 2 & y <= 2007"
 10.     runone `fh' "inc_low" `yv' "inc3 == 1"
 11.     runone `fh' "inc_mid" `yv' "inc3 == 2"
 12.     runone `fh' "inc_high" `yv' "inc3 == 3"
 13.     runone `fh' "gdp_low" `yv' "gdp3 == 1"
 14.     runone `fh' "gdp_mid" `yv' "gdp3 == 2"
 15.     runone `fh' "gdp_high" `yv' "gdp3 == 3"
 16. }
