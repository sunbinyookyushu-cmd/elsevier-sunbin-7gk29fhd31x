. encode c, gen(isocode)

. xtset isocode y

Panel variable: isocode (unbalanced)
 Time variable: y, 1996 to 2023, but with gaps
         Delta: 1 unit

. keep if !missing(gini_mkt)
(906 observations deleted)

. capture drop ln_spt_b50

. gen ln_spt_b50 = ln_apt_b50 - ln_apt_all
(21 missing values generated)

. capture drop ln_spt_d10

. gen ln_spt_d10 = ln_apt_d10 - ln_apt_all
(21 missing values generated)

. tempname fh

. file open `fh' using "_mediators2_results.csv", write replace
(file _mediators2_results.csv not found)

. file write `fh' "block,item,outcome,term,b,se,p,kpf,N" _n

. capture program drop wr

. program define wr
  1.     args fh blk item yv term kp
  2.     local b = _b[`term']
  3.     local se = _se[`term']
  4.     local p = 2*normal(-abs(`b'/`se'))
  5.     file write `fh' "`blk',`item',`yv',`term',`b',`se',`p',`kp',`=e(N)'" _n
  6. end

. local MED "emp_fin_sh emp_prof_sh emp_ict_sh emp_re_sh emp_kibs_sh emp_accom_sh emp_transp_sh emp_pub_sh occ_mgr_sh occ_prof_sh occ_top_sh occ_elem_sh informal_rt net_mig_rate transfers_sh_exp"

. foreach mv of local MED {
  2.     capture confirm variable `mv'
  3.     if _rc continue
  4.     quietly count if !missing(`mv', ln_gaci_max, feyrer_int, lnpop)
  5.     if r(N) < 150 continue
  6.     capture noisily ivreghdfe `mv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
  7.     if _rc == 0 wr `fh' A apath `mv' ln_gaci_max `=e(widstat)'
  8.     quietly reghdfe `mv' ln_gaci_max lnpop, absorb(isocode y) vce(cluster isocode)
  9.     wr `fh' A apath_ols `mv' ln_gaci_max .
 10.     * headline on the same sample
.     capture noisily ivreghdfe ln_gini_mkt lnpop (ln_gaci_max = feyrer_int) if !missing(`mv'), absorb(isocode y) cluster(isocode)
 11.     if _rc == 0 wr `fh' A samplegini `mv' ln_gaci_max `=e(widstat)'
 12.     foreach yv in ln_gini_mkt ln_spt_b50 ln_spt_d10 {
 13.         capture noisily ivreghdfe `yv' lnpop `mv' (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
 14.         if _rc == 0 {
 15.             wr `fh' B `mv' `yv' ln_gaci_max `=e(widstat)'
 16.             wr `fh' B `mv' `yv' `mv' `=e(widstat)'
 17.         }
 18.         quietly reghdfe `yv' `mv' ln_gaci_max lnpop, absorb(isocode y) vce(cluster isocode)
 19.         wr `fh' B_ols `mv' `yv' `mv' .
 20.     }
 21. }
