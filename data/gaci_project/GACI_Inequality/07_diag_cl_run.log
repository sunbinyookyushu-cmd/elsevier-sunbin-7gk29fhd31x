. * B. pooled variants
. foreach yv in ln_gini_mkt ln_gini_disp {
  2.     foreach ivv in feyrer_int tourism_int {
  3.         * B1. continent x year FE
.         ivreghdfe `yv' lnpop (ln_gaci_max = `ivv'), absorb(isocode contid#y) cluster(isocode)
  4.         local b = _b[ln_gaci_max]
  5.         local se = _se[ln_gaci_max]
  6.         local p = 2*normal(-abs(`b'/`se'))
  7.         local kp = e(widstat)
  8.         local nn = e(N)
  9.         file write `fh' "pooled,`yv',`ivv',cont_x_year,`b',`se',`p',`kp',`nn'" _n
 10.         * B2. continent x year FE, drop LA
.         ivreghdfe `yv' lnpop (ln_gaci_max = `ivv') if cont!="LA", absorb(isocode contid#y) cluster(isocode)
 11.         local b = _b[ln_gaci_max]
 12.         local se = _se[ln_gaci_max]
 13.         local p = 2*normal(-abs(`b'/`se'))
 14.         local kp = e(widstat)
 15.         local nn = e(N)
 16.         file write `fh' "pooled,`yv',`ivv',cont_x_year_dropLA,`b',`se',`p',`kp',`nn'" _n
 17.         * B3. exposure x trend controls
.         ivreghdfe `yv' lnpop at_basepc at_basegini at_lnland at_abslat (ln_gaci_max = `ivv'), absorb(isocode y) cluster(isocode)
 18.         local b = _b[ln_gaci_max]
 19.         local se = _se[ln_gaci_max]
 20.         local p = 2*normal(-abs(`b'/`se'))
 21.         local kp = e(widstat)
 22.         local nn = e(N)
 23.         file write `fh' "pooled,`yv',`ivv',exposure_trends,`b',`se',`p',`kp',`nn'" _n
 24.         ivreghdfe `yv' lnpop at_basepc at_basegini at_lnland at_abslat at_seama at_basetrade (ln_gaci_max = `ivv'), absorb(isocode contid#y) cluster(isocode)
 25.         local b = _b[ln_gaci_max]
 26.         local se = _se[ln_gaci_max]
 27.         local p = 2*normal(-abs(`b'/`se'))
 28.         local kp = e(widstat)
 29.         local nn = e(N)
 30.         file write `fh' "pooled,`yv',`ivv',exposure_trends_contyear,`b',`se',`p',`kp',`nn'" _n
 31.         * B4. income-tercile x year FE and baseline-gini tercile x year FE
.         ivreghdfe `yv' lnpop (ln_gaci_max = `ivv'), absorb(isocode inc3#y gini3#y) cluster(isocode)
 32.         local b = _b[ln_gaci_max]
 33.         local se = _se[ln_gaci_max]
 34.         local p = 2*normal(-abs(`b'/`se'))
 35.         local kp = e(widstat)
 36.         local nn = e(N)
 37.         file write `fh' "pooled,`yv',`ivv',inc3_gini3_x_year,`b',`se',`p',`kp',`nn'" _n
 38.         * B5. all of the above
.         ivreghdfe `yv' lnpop at_basepc at_basegini at_lnland at_abslat at_seama (ln_gaci_max = `ivv'), absorb(isocode contid#y inc3#y gini3#y) cluster(isocode)
 39.         local b = _b[ln_gaci_max]
 40.         local se = _se[ln_gaci_max]
 41.         local p = 2*normal(-abs(`b'/`se'))
 42.         local kp = e(widstat)
 43.         local nn = e(N)
 44.         file write `fh' "pooled,`yv',`ivv',kitchen_sink,`b',`se',`p',`kp',`nn'" _n
 45.         * B6. OLS counterparts
.         reghdfe `yv' ln_gaci_max lnpop, absorb(isocode contid#y inc3#y gini3#y) vce(cluster isocode)
 46.         local b = _b[ln_gaci_max]
 47.         local se = _se[ln_gaci_max]
 48.         local p = 2*ttail(e(df_r), abs(`b'/`se'))
 49.         local nn = e(N)
 50.         file write `fh' "pooled,`yv',OLS,kitchen_sink_FE,`b',`se',`p',.,`nn'" _n
 51.     }
 52.     * B7. both IVs, continent x year FE + exposure trends, Hansen J
.     ivreghdfe `yv' lnpop at_basepc at_basegini at_lnland at_abslat at_seama (ln_gaci_max = feyrer_int tourism_int), absorb(isocode contid#y) cluster(isocode)
 53.     local b = _b[ln_gaci_max]
 54.     local se = _se[ln_gaci_max]
 55.     local p = 2*normal(-abs(`b'/`se'))
 56.     local kp = e(widstat)
 57.     local nn = e(N)
 58.     local jp = e(jp)
 59.     file write `fh' "pooled,`yv',both,contyear_exposure_J,`b',`se',`p',`kp',`nn'" _n
 60.     file write `fh' "pooled,`yv',both,hansen_p,`jp',.,.,.,`nn'" _n
 61.     * B8. drop each continent under continent x year FE (feyrer)
.     foreach cc of local cl {
 62.         ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if cont!="`cc'", absorb(isocode contid#y) cluster(isocode)
 63.         local b = _b[ln_gaci_max]
 64.         local se = _se[ln_gaci_max]
 65.         local p = 2*normal(-abs(`b'/`se'))
 66.         local kp = e(widstat)
 67.         local nn = e(N)
 68.         file write `fh' "loo_contyear,`yv',feyrer_int,drop_`cc',`b',`se',`p',`kp',`nn'" _n
 69.     }
 70. }
