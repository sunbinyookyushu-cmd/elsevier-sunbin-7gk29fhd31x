. encode c, gen(isocode)

. xtset isocode y

Panel variable: isocode (unbalanced)
 Time variable: y, 1996 to 2023, but with gaps
         Delta: 1 unit

. keep if !missing(gini_mkt)
(906 observations deleted)

. gen ln_apt_top_bot = (ln_apt_d6 + ln_apt_d7 + ln_apt_d8 + ln_apt_d9 + ln_apt_d10)/5 - (ln_apt_d1 + ln_apt_d2 + ln_apt_d3 + ln_apt_d4 + ln_apt_d5)/5
(24 missing values generated)

. capture drop ln_spt_b50

. gen ln_spt_b50 = ln_apt_b50 - ln_apt_all
(21 missing values generated)

. capture drop ln_spt_d10

. gen ln_spt_d10 = ln_apt_d10 - ln_apt_all
(21 missing values generated)

. gen ln_tour_arr = ln(tour_arrivals) if tour_arrivals > 0
(666 missing values generated)

. gen gaci_rest = gaci_sum - gaci_max

. gen ln_gaci_rest = ln(gaci_rest) if gaci_rest > 0
(599 missing values generated)

. gen wedge_pts = gini_mkt - gini_disp

. gen ln_wedge_ratio = ln(gini_mkt) - ln(gini_disp)

. 
. tempname fh

. file open `fh' using "_mech_results.csv", write replace
(file _mech_results.csv not found)

. file write `fh' "block,item,outcome,term,b,se,p,kpf,N" _n

. capture program drop wr

. program define wr
  1.     args fh blk item yv term kp
  2.     local b = _b[`term']
  3.     local se = _se[`term']
  4.     local p = 2*normal(-abs(`b'/`se'))
  5.     file write `fh' "`blk',`item',`yv',`term',`b',`se',`p',`kp',`=e(N)'" _n
  6. end

. 
. * ---------------- A. hub vs rest of network ----------------
. foreach yv in ln_gini_mkt ln_gini_disp ln_spt_b50 ln_apt_top_bot {
  2.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
  3.     if _rc == 0 wr `fh' A baseline `yv' ln_gaci_max `=e(widstat)'
  4.     capture noisily ivreghdfe `yv' lnpop ln_gaci_rest (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
  5.     if _rc == 0 {
  6.         wr `fh' A hub_ctrl_rest `yv' ln_gaci_max `=e(widstat)'
  7.         wr `fh' A hub_ctrl_rest `yv' ln_gaci_rest `=e(widstat)'
  8.     }
  9.     capture noisily ivreghdfe `yv' lnpop ln_gaci_sum (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
 10.     if _rc == 0 {
 11.         wr `fh' A hub_ctrl_sum `yv' ln_gaci_max `=e(widstat)'
 12.         wr `fh' A hub_ctrl_sum `yv' ln_gaci_sum `=e(widstat)'
 13.     }
 14.     capture noisily ivreghdfe `yv' lnpop ln_gaci_max (ln_gaci_rest = feyrer_int), absorb(isocode y) cluster(isocode)
 15.     if _rc == 0 {
 16.         wr `fh' A rest_iv_ctrl_hub `yv' ln_gaci_rest `=e(widstat)'
 17.         wr `fh' A rest_iv_ctrl_hub `yv' ln_gaci_max `=e(widstat)'
 18.     }
 19.     quietly reghdfe `yv' ln_share_max ln_gaci_sum lnpop, absorb(isocode y) vce(cluster isocode)
 20.     wr `fh' A ols_share_max `yv' ln_share_max .
 21.     wr `fh' A ols_share_max `yv' ln_gaci_sum .
 22.     quietly reghdfe `yv' ln_hhi ln_gaci_sum lnpop, absorb(isocode y) vce(cluster isocode)
 23.     wr `fh' A ols_hhi `yv' ln_hhi .
 24. }
