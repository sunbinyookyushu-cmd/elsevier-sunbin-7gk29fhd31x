. gen post2010 = (y>=2010)

. gen midinc = (inc3==2)

. gen highinc = (inc3==3)

. foreach v in ln_gaci_max ln_gaci_cwm ln_gaci_sum feyrer_int tourism_int {
  2.     gen `v'_mid = `v'*midinc
  3.     gen `v'_high = `v'*highinc
  4.     gen `v'_post = `v'*post2010
  5.     gen `v'_conc = `v'*conc2
  6.     gen `v'_g2 = `v'*(gini3==2)
  7.     gen `v'_g3 = `v'*(gini3==3)
  8. }

. 
end of do-file

. tempname fh

. file open `fh' using "_conc_mech_results.csv", write replace
(note: file _conc_mech_results.csv not found)

. file write `fh' "block,outcome,term,model,b,se,p,kpf,N" _n

. foreach yv in ln_gini_mkt ln_gini_disp {
  2.     * --- Concentration block ---
.     reghdfe `yv' ln_share_max lnpop, absorb(isocode y) vce(robust)
  3.     local b = _b[ln_share_max]
  4.     local se = _se[ln_share_max]
  5.     local p = 2*ttail(e(df_r), abs(_b[ln_share_max]/_se[ln_share_max]))
  6.     local nn = e(N)
  7.     file write `fh' "conc,`yv',ln_share_max,OLS_alone,`b',`se',`p',.,`nn'" _n
  8.     reghdfe `yv' ln_share_max ln_gaci_sum lnpop, absorb(isocode y) vce(robust)
  9.     local nn = e(N)
 10.     foreach t in ln_share_max ln_gaci_sum {
 11.         local b = _b[`t']
 12.         local se = _se[`t']
 13.         local p = 2*ttail(e(df_r), abs(_b[`t']/_se[`t']))
 14.         file write `fh' "conc,`yv',`t',OLS_withsum,`b',`se',`p',.,`nn'" _n
 15.     }
 16.     reghdfe `yv' ln_hhi ln_gaci_sum lnpop, absorb(isocode y) vce(robust)
 17.     local nn = e(N)
 18.     foreach t in ln_hhi ln_gaci_sum {
 19.         local b = _b[`t']
 20.         local se = _se[`t']
 21.         local p = 2*ttail(e(df_r), abs(_b[`t']/_se[`t']))
 22.         file write `fh' "conc,`yv',`t',OLS_hhi,`b',`se',`p',.,`nn'" _n
 23.     }
 24.     reghdfe `yv' ln_gaci_max ln_gaci_mean lnpop, absorb(isocode y) vce(robust)
 25.     local nn = e(N)
 26.     foreach t in ln_gaci_max ln_gaci_mean {
 27.         local b = _b[`t']
 28.         local se = _se[`t']
 29.         local p = 2*ttail(e(df_r), abs(_b[`t']/_se[`t']))
 30.         file write `fh' "conc,`yv',`t',OLS_max_mean,`b',`se',`p',.,`nn'" _n
 31.     }
 32.     * IV: max instrumented, sum as control
.     ivreghdfe `yv' lnpop ln_gaci_sum (ln_gaci_max = feyrer_int), absorb(isocode y) robust
 33.     local kp = e(widstat)
 34.     local nn = e(N)
 35.     foreach t in ln_gaci_max ln_gaci_sum {
 36.         local b = _b[`t']
 37.         local se = _se[`t']
 38.         local p = 2*normal(-abs(_b[`t']/_se[`t']))
 39.         file write `fh' "conc,`yv',`t',IV_max_ctrl_sum,`b',`se',`p',`kp',`nn'" _n
 40.     }
 41.     * IV: two endogenous (max, sum) with two instruments
.     ivreghdfe `yv' lnpop (ln_gaci_max ln_gaci_sum = feyrer_int tourism_int), absorb(isocode y) robust
 42.     local kp = e(widstat)
 43.     local nn = e(N)
 44.     foreach t in ln_gaci_max ln_gaci_sum {
 45.         local b = _b[`t']
 46.         local se = _se[`t']
 47.         local p = 2*normal(-abs(_b[`t']/_se[`t']))
 48.         file write `fh' "conc,`yv',`t',IV_two_endog,`b',`se',`p',`kp',`nn'" _n
 49.     }
 50.     * IV interaction: concentrated (baseline share_max>0.5) vs distributed systems
.     ivreghdfe `yv' lnpop (ln_gaci_max ln_gaci_max_conc = feyrer_int feyrer_int_conc), absorb(isocode y) robust
 51.     local kp = e(widstat)
 52.     local nn = e(N)
 53.     foreach t in ln_gaci_max ln_gaci_max_conc {
 54.         local b = _b[`t']
 55.         local se = _se[`t']
 56.         local p = 2*normal(-abs(_b[`t']/_se[`t']))
 57.         file write `fh' "conc,`yv',`t',IV_x_conc,`b',`se',`p',`kp',`nn'" _n
 58.     }
 59.     lincom ln_gaci_max + ln_gaci_max_conc
 60.     file write `fh' "conc,`yv',conc_total,IV_x_conc,`r(estimate)',`r(se)',`r(p)',.,`nn'" _n
 61.     * --- Mechanism block: mediator on connectivity (2SLS), then c vs c-prime ---
.     foreach m in emp_srv emp_ind emp_agr primacy urban ln_gdppc trade_gdp fdi_gdp tax_gdp ter_enr unemp {
 62.         capture ivreghdfe `m' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) robust
 63.         if _rc==0 {
 64.             local b = _b[ln_gaci_max]
 65.             local se = _se[ln_gaci_max]
 66.             local p = 2*normal(-abs(_b[ln_gaci_max]/_se[ln_gaci_max]))
 67.             local kp = e(widstat)
 68.             local nn = e(N)
 69.             file write `fh' "mech_a,`m',ln_gaci_max,IV,`b',`se',`p',`kp',`nn'" _n
 70.             ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if !missing(`m'), absorb(isocode y) robust
 71.             local c0 = _b[ln_gaci_max]
 72.             local n0 = e(N)
 73.             ivreghdfe `yv' lnpop `m' (ln_gaci_max = feyrer_int), absorb(isocode y) robust
 74.             local b = _b[ln_gaci_max]
 75.             local se = _se[ln_gaci_max]
 76.             local p = 2*normal(-abs(_b[ln_gaci_max]/_se[ln_gaci_max]))
 77.             local bm = _b[`m']
 78.             local sem = _se[`m']
 79.             local pm = 2*normal(-abs(_b[`m']/_se[`m']))
 80.             local kp = e(widstat)
 81.             local nn = e(N)
 82.             file write `fh' "mech_c,`yv'_`m',c,IV,`c0',.,.,.,`n0'" _n
 83.             file write `fh' "mech_c,`yv'_`m',cprime,IV,`b',`se',`p',`kp',`nn'" _n
 84.             file write `fh' "mech_c,`yv'_`m',b_mediator,IV,`bm',`sem',`pm',.,`nn'" _n
 85.         }
 86.     }
 87. }
