. * ---------------------------------------------------------------- F. heterogeneity
. foreach yv in ln_gdppc ln_avg_bot50_wid ln_avg_top10_wid {
  2.     ivreghdfe `yv' lnpop (ln_gaci_max ln_gaci_max_mid ln_gaci_max_high = feyrer_int feyrer_int_mid feyrer_int_high), absorb(isocode y) cluster(isocode)
  3.     local kp = e(widstat)
  4.     local nn = e(N)
  5.     foreach t in ln_gaci_max ln_gaci_max_mid ln_gaci_max_high {
  6.         local bb = _b[`t']
  7.         local ss = _se[`t']
  8.         local pp = 2*normal(-abs(`bb'/`ss'))
  9.         file write `fh' "inc3,`yv',`t',feyrer_int,interaction,`bb',`ss',`pp',`kp',.,`nn'" _n
 10.     }
 11.     lincom ln_gaci_max + ln_gaci_max_mid
 12.     file write `fh' "inc3,`yv',mid_total,feyrer_int,interaction,`r(estimate)',`r(se)',`r(p)',.,.,`nn'" _n
 13.     lincom ln_gaci_max + ln_gaci_max_high
 14.     file write `fh' "inc3,`yv',high_total,feyrer_int,interaction,`r(estimate)',`r(se)',`r(p)',.,.,`nn'" _n
 15.     ivreghdfe `yv' lnpop (ln_gaci_max ln_gaci_max_post = feyrer_int feyrer_int_post), absorb(isocode y) cluster(isocode)
 16.     local kp = e(widstat)
 17.     local nn = e(N)
 18.     foreach t in ln_gaci_max ln_gaci_max_post {
 19.         local bb = _b[`t']
 20.         local ss = _se[`t']
 21.         local pp = 2*normal(-abs(`bb'/`ss'))
 22.         file write `fh' "post2010,`yv',`t',feyrer_int,interaction,`bb',`ss',`pp',`kp',.,`nn'" _n
 23.     }
 24.     lincom ln_gaci_max + ln_gaci_max_post
 25.     file write `fh' "post2010,`yv',post_total,feyrer_int,interaction,`r(estimate)',`r(se)',`r(p)',.,.,`nn'" _n
 26.     levelsof cont, local(cl)
 27.     foreach cc of local cl {
 28.         capture ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if cont=="`cc'", absorb(isocode y) cluster(isocode)
 29.         if _rc==0 {
 30.             local bb = _b[ln_gaci_max]
 31.             local ss = _se[ln_gaci_max]
 32.             local pp = 2*normal(-abs(`bb'/`ss'))
 33.             local kp = e(widstat)
 34.             local nn = e(N)
 35.             file write `fh' "continent,`yv',ln_gaci_max,feyrer_int,`cc',`bb',`ss',`pp',`kp',.,`nn'" _n
 36.         }
 37.     }
 38. }
