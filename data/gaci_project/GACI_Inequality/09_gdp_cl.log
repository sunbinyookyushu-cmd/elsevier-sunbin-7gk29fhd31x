. * ---------------------------------------------------------------- A. main table twin
. foreach ivv in feyrer_int tourism_int {
  2. foreach tr in ln_gaci_max ln_gaci_cwm ln_gaci_sum {
  3.     foreach yv of local GY {
  4.         reghdfe `yv' `tr' lnpop, absorb(isocode y) vce(cluster isocode)
  5.         local bb = _b[`tr']
  6.         local ss = _se[`tr']
  7.         local pp = 2*ttail(e(df_r), abs(`bb'/`ss'))
  8.         local nn = e(N)
  9.         file write `fh' "main,`yv',`tr',`ivv',OLS,`bb',`ss',`pp',.,.,`nn'" _n
 10.         ivreghdfe `yv' lnpop (`tr' = `ivv'), absorb(isocode y) cluster(isocode)
 11.         local bb = _b[`tr']
 12.         local ss = _se[`tr']
 13.         local pp = 2*normal(-abs(`bb'/`ss'))
 14.         local kp = e(widstat)
 15.         local nn = e(N)
 16.         file write `fh' "main,`yv',`tr',`ivv',IV,`bb',`ss',`pp',`kp',.,`nn'" _n
 17.         ivreghdfe `yv' lnpop (`tr' = `ivv'), absorb(isocode y) cluster(isocode)
 18.         local bb = _b[`tr']
 19.         local ss = _se[`tr']
 20.         local pp = 2*normal(-abs(`bb'/`ss'))
 21.         local kp = e(widstat)
 22.         local nn = e(N)
 23.         file write `fh' "main,`yv',`tr',`ivv',IVcl,`bb',`ss',`pp',`kp',.,`nn'" _n
 24.     }
 25. }
 26. }
