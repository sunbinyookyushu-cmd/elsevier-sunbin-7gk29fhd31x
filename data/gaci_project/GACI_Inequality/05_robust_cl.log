. * I. RF quintile: reduced-form by quintile of baseline gini and baseline income
. foreach base in basegini basepc {
  2.     preserve
  3.     bysort isocode: keep if _n==1
  4.     xtile q5_`base' = `base', nq(5)
  5.     keep isocode q5_`base'
  6.     tempfile qq
  7.     save `qq'
  8.     restore
  9.     merge m:1 isocode using `qq', nogen
 10.     forvalues q = 1/5 {
 11.         reghdfe ln_gini_mkt feyrer_int lnpop if q5_`base'==`q', absorb(isocode y) vce(cluster isocode)
 12.         local b = _b[feyrer_int]
 13.         local se = _se[feyrer_int]
 14.         local p = 2*ttail(e(df_r), abs(`b'/`se'))
 15.         local nn = e(N)
 16.         file write `fh' "rfq_`base',ln_gini_mkt,q`q',`b',`se',`p',.,.,`nn'" _n
 17.     }
 18. }
