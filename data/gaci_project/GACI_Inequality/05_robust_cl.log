. file write `fh' "block,outcome,spec,b,se,p,kpf,hansenp,N" _n

. foreach yv in ln_gini_mkt ln_gini_disp {
  2.     * A. controls sensitivity
.     local i = 0
  3.     foreach ctrl in "none" "ln_gdppc" "urban" "ter_enr" "trade_gdp" "tax_gdp" "ln_sea_ma" "ln_gdppc urban ter_enr trade_gdp" {
  4.         local i = `i' + 1
  5.         local cv = "`ctrl'"
  6.         if "`ctrl'"=="none" local cv = ""
  7.         ivreghdfe `yv' lnpop `cv' (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
  8.         local b = _b[ln_gaci_max]
  9.         local se = _se[ln_gaci_max]
 10.         local p = 2*normal(-abs(`b'/`se'))
 11.         local kp = e(widstat)
 12.         local nn = e(N)
 13.         file write `fh' "controls,`yv',ctrl`i',`b',`se',`p',`kp',.,`nn'" _n
 14.     }
 15.     * B. instrument set: over-identified (Feyrer + tourism), Hansen J
.     ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int tourism_int), absorb(isocode y) cluster(isocode)
 16.     local b = _b[ln_gaci_max]
 17.     local se = _se[ln_gaci_max]
 18.     local p = 2*normal(-abs(`b'/`se'))
 19.     local kp = e(widstat)
 20.     local jp = e(jp)
 21.     local nn = e(N)
 22.     file write `fh' "overid,`yv',feyrer_tourism,`b',`se',`p',`kp',`jp',`nn'" _n
 23.     ivreghdfe `yv' lnpop (ln_gaci_max = tourism_int), absorb(isocode y) cluster(isocode)
 24.     local b = _b[ln_gaci_max]
 25.     local se = _se[ln_gaci_max]
 26.     local p = 2*normal(-abs(`b'/`se'))
 27.     local kp = e(widstat)
 28.     local nn = e(N)
 29.     file write `fh' "overid,`yv',tourism_only,`b',`se',`p',`kp',.,`nn'" _n
 30.     * C. reduced form
.     reghdfe `yv' feyrer_int lnpop, absorb(isocode y) vce(cluster isocode)
 31.     local b = _b[feyrer_int]
 32.     local se = _se[feyrer_int]
 33.     local p = 2*ttail(e(df_r), abs(`b'/`se'))
 34.     local nn = e(N)
 35.     file write `fh' "rf,`yv',feyrer_rf,`b',`se',`p',.,.,`nn'" _n
 36.     * D. SE variants
.     ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
 37.     local b = _b[ln_gaci_max]
 38.     local se = _se[ln_gaci_max]
 39.     local p = 2*normal(-abs(`b'/`se'))
 40.     local kp = e(widstat)
 41.     local nn = e(N)
 42.     file write `fh' "se,`yv',cluster_country,`b',`se',`p',`kp',.,`nn'" _n
 43.     ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(contid y)
 44.     local b = _b[ln_gaci_max]
 45.     local se = _se[ln_gaci_max]
 46.     local p = 2*normal(-abs(`b'/`se'))
 47.     local kp = e(widstat)
 48.     local nn = e(N)
 49.     file write `fh' "se,`yv',cluster_cont_year,`b',`se',`p',`kp',.,`nn'" _n
 50.     ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) dkraay(3)
 51.     local b = _b[ln_gaci_max]
 52.     local se = _se[ln_gaci_max]
 53.     local p = 2*normal(-abs(`b'/`se'))
 54.     local kp = e(widstat)
 55.     local nn = e(N)
 56.     file write `fh' "se,`yv',driscoll_kraay3,`b',`se',`p',`kp',.,`nn'" _n
 57.     * E. sample exclusions
.     ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if tophub==0, absorb(isocode y) cluster(isocode)
 58.     local b = _b[ln_gaci_max]
 59.     local se = _se[ln_gaci_max]
 60.     local p = 2*normal(-abs(`b'/`se'))
 61.     local kp = e(widstat)
 62.     local nn = e(N)
 63.     file write `fh' "sample,`yv',drop_top10_hubs,`b',`se',`p',`kp',.,`nn'" _n
 64.     ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if y<=2019, absorb(isocode y) cluster(isocode)
 65.     local b = _b[ln_gaci_max]
 66.     local se = _se[ln_gaci_max]
 67.     local p = 2*normal(-abs(`b'/`se'))
 68.     local kp = e(widstat)
 69.     local nn = e(N)
 70.     file write `fh' "sample,`yv',pre2020,`b',`se',`p',`kp',.,`nn'" _n
 71.     ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if !inlist(y,2008,2009,2020,2021), absorb(isocode y) cluster(isocode)
 72.     local b = _b[ln_gaci_max]
 73.     local se = _se[ln_gaci_max]
 74.     local p = 2*normal(-abs(`b'/`se'))
 75.     local kp = e(widstat)
 76.     local nn = e(N)
 77.     file write `fh' "sample,`yv',drop_crises,`b',`se',`p',`kp',.,`nn'" _n
 78.     levelsof cont, local(cl)
 79.     foreach cc of local cl {
 80.         ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if cont!="`cc'", absorb(isocode y) cluster(isocode)
 81.         local b = _b[ln_gaci_max]
 82.         local se = _se[ln_gaci_max]
 83.         local p = 2*normal(-abs(`b'/`se'))
 84.         local kp = e(widstat)
 85.         local nn = e(N)
 86.         file write `fh' "loo_cont,`yv',drop_`cc',`b',`se',`p',`kp',.,`nn'" _n
 87.     }
 88.     * F. alternative FE: continent x year
.     ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode contid#y) cluster(isocode)
 89.     local b = _b[ln_gaci_max]
 90.     local se = _se[ln_gaci_max]
 91.     local p = 2*normal(-abs(`b'/`se'))
 92.     local kp = e(widstat)
 93.     local nn = e(N)
 94.     file write `fh' "fe,`yv',cont_x_year,`b',`se',`p',`kp',.,`nn'" _n
 95.     * G. country-specific linear trends
.     ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y isocode#c.y) cluster(isocode)
 96.     local b = _b[ln_gaci_max]
 97.     local se = _se[ln_gaci_max]
 98.     local p = 2*normal(-abs(`b'/`se'))
 99.     local kp = e(widstat)
100.     local nn = e(N)
101.     file write `fh' "fe,`yv',country_trends,`b',`se',`p',`kp',.,`nn'" _n
102. }
