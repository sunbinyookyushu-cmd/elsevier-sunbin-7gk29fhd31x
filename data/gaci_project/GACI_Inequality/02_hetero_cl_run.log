. gen post2010 = (y>=2010)

. gen midinc = (inc3==2)

. gen highinc = (inc3==3)

. foreach v in ln_gaci_max ln_gaci_cwm ln_gaci_sum feyrer_int tourism_int {
  2.     gen `v'_mid = `v'*midinc
  3.     gen `v'_high = `v'*highinc
  4.     gen `v'_post = `v'*post2010
  5.     gen `v'_conc = `v'*conc2
  6.     gen `v'_g2 = `v'*(gini3==2)
  7.     gen `v'_g3 = `v'*(gini3==3)
  8. }

. gen tophub = inlist(c,"DEU","USA","FRA","NLD","GBR") | inlist(c,"CHN","CAN","SGP","ARE","THA")

. sort isocode y

. xtset isocode y

Panel variable: isocode (unbalanced)
 Time variable: y, 1996 to 2023, but with gaps
         Delta: 1 unit

. 
end of do-file

. tempname fh

. file open `fh' using "_hetero_results_cl.csv", write replace
(file _hetero_results_cl.csv not found)

. file write `fh' "block,treat,outcome,term,b,se,p,kpf,N" _n

. foreach tr in ln_gaci_max ln_gaci_cwm {
  2. foreach yv in ln_gini_mkt ln_gini_disp {
  3.     * A. baseline-income terciles, interaction IV
.     ivreghdfe `yv' lnpop (`tr' `tr'_mid `tr'_high = feyrer_int feyrer_int_mid feyrer_int_high), absorb(isocode y) cluster(isocode)
  4.     local kp = e(widstat)
  5.     local nn = e(N)
  6.     foreach t in `tr' `tr'_mid `tr'_high {
  7.         local b = _b[`t']
  8.         local se = _se[`t']
  9.         local p = 2*normal(-abs(_b[`t']/_se[`t']))
 10.         file write `fh' "inc3,`tr',`yv',`t',`b',`se',`p',`kp',`nn'" _n
 11.     }
 12.     lincom `tr' + `tr'_mid
 13.     file write `fh' "inc3,`tr',`yv',mid_total,`r(estimate)',`r(se)',`r(p)',.,`nn'" _n
 14.     lincom `tr' + `tr'_high
 15.     file write `fh' "inc3,`tr',`yv',high_total,`r(estimate)',`r(se)',`r(p)',.,`nn'" _n
 16.     * A2. separate by tercile
.     forvalues q = 1/3 {
 17.         capture ivreghdfe `yv' lnpop (`tr' = feyrer_int) if inc3==`q', absorb(isocode y) cluster(isocode)
 18.         if _rc==0 {
 19.             local b = _b[`tr']
 20.             local se = _se[`tr']
 21.             local p = 2*normal(-abs(_b[`tr']/_se[`tr']))
 22.             local kp = e(widstat)
 23.             local nn = e(N)
 24.             file write `fh' "inc3_split,`tr',`yv',q`q',`b',`se',`p',`kp',`nn'" _n
 25.         }
 26.     }
 27.     * B. baseline-inequality terciles
.     ivreghdfe `yv' lnpop (`tr' `tr'_g2 `tr'_g3 = feyrer_int feyrer_int_g2 feyrer_int_g3), absorb(isocode y) cluster(isocode)
 28.     local kp = e(widstat)
 29.     local nn = e(N)
 30.     foreach t in `tr' `tr'_g2 `tr'_g3 {
 31.         local b = _b[`t']
 32.         local se = _se[`t']
 33.         local p = 2*normal(-abs(_b[`t']/_se[`t']))
 34.         file write `fh' "gini3,`tr',`yv',`t',`b',`se',`p',`kp',`nn'" _n
 35.     }
 36.     lincom `tr' + `tr'_g2
 37.     file write `fh' "gini3,`tr',`yv',g2_total,`r(estimate)',`r(se)',`r(p)',.,`nn'" _n
 38.     lincom `tr' + `tr'_g3
 39.     file write `fh' "gini3,`tr',`yv',g3_total,`r(estimate)',`r(se)',`r(p)',.,`nn'" _n
 40.     * C. temporal post-2010
.     ivreghdfe `yv' lnpop (`tr' `tr'_post = feyrer_int feyrer_int_post), absorb(isocode y) cluster(isocode)
 41.     local kp = e(widstat)
 42.     local nn = e(N)
 43.     foreach t in `tr' `tr'_post {
 44.         local b = _b[`t']
 45.         local se = _se[`t']
 46.         local p = 2*normal(-abs(_b[`t']/_se[`t']))
 47.         file write `fh' "post2010,`tr',`yv',`t',`b',`se',`p',`kp',`nn'" _n
 48.     }
 49.     lincom `tr' + `tr'_post
 50.     file write `fh' "post2010,`tr',`yv',post_total,`r(estimate)',`r(se)',`r(p)',.,`nn'" _n
 51.     * D. by continent (separate 2SLS)
.     levelsof cont, local(cl)
 52.     foreach cc of local cl {
 53.         capture ivreghdfe `yv' lnpop (`tr' = feyrer_int) if cont=="`cc'", absorb(isocode y) cluster(isocode)
 54.         if _rc==0 {
 55.             local b = _b[`tr']
 56.             local se = _se[`tr']
 57.             local p = 2*normal(-abs(_b[`tr']/_se[`tr']))
 58.             local kp = e(widstat)
 59.             local nn = e(N)
 60.             file write `fh' "continent,`tr',`yv',`cc',`b',`se',`p',`kp',`nn'" _n
 61.         }
 62.     }
 63. }
 64. }
