. tempname fh

. file open `fh' using "_gic_dose_results.csv", write replace

. file write `fh' "block,outcome,spec,b,se,p,kpf,N" _n

. 
. * ---------------- A. growth incidence: average income by group ----------------
. local GRP "d1 d2 d3 d4 d5 d6 d7 d8 d9 d10 t1 t01 b50 m40 all"

. foreach pre in ln_apt ln_adi {
  2.     foreach g of local GRP {
  3.         local yv `pre'_`g'
  4.         capture confirm variable `yv'
  5.         if _rc continue
  6.         quietly reghdfe `yv' ln_gaci_max lnpop, absorb(isocode y) vce(cluster isocode)
  7.         local b = _b[ln_gaci_max]
  8.         local se = _se[ln_gaci_max]
  9.         local p = 2*ttail(e(df_r), abs(`b'/`se'))
 10.         local nn = e(N)
 11.         file write `fh' "gic,`yv',OLS,`b',`se',`p',.,`nn'" _n
 12.         quietly ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
 13.         local b = _b[ln_gaci_max]
 14.         local se = _se[ln_gaci_max]
 15.         local p = 2*normal(-abs(`b'/`se'))
 16.         local kp = e(widstat)
 17.         local nn = e(N)
 18.         file write `fh' "gic,`yv',IV,`b',`se',`p',`kp',`nn'" _n
 19.         quietly ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode contid#y) cluster(isocode)
 20.         local b = _b[ln_gaci_max]
 21.         local se = _se[ln_gaci_max]
 22.         local p = 2*normal(-abs(`b'/`se'))
 23.         local kp = e(widstat)
 24.         local nn = e(N)
 25.         file write `fh' "gic,`yv',IV_contyear,`b',`se',`p',`kp',`nn'" _n
 26.         quietly ivreghdfe `yv' lnpop (ln_gaci_max = tourism_int), absorb(isocode y) cluster(isocode)
 27.         local b = _b[ln_gaci_max]
 28.         local se = _se[ln_gaci_max]
 29.         local p = 2*normal(-abs(`b'/`se'))
 30.         local kp = e(widstat)
 31.         local nn = e(N)
 32.         file write `fh' "gic,`yv',IV_tourism,`b',`se',`p',`kp',`nn'" _n
 33.     }
 34. }

. * income shares (log), pretax: use the identity ln share_g = ln apt_g - ln apt_all + const so that the
. * sample equals the level regressions (WID rounds the bottom-decile share to 0 in 271 country-years)
. foreach g of local GRP {
  2.     if "`g'"=="all" continue
  3.     local yv ln_spt_`g'
  4.     capture confirm variable ln_apt_`g'
  5.     if _rc continue
  6.     capture drop `yv'
  7.     gen `yv' = ln_apt_`g' - ln_apt_all
  8.     quietly ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
  9.     local b = _b[ln_gaci_max]
 10.     local se = _se[ln_gaci_max]
 11.     local p = 2*normal(-abs(`b'/`se'))
 12.     local kp = e(widstat)
 13.     local nn = e(N)
 14.     file write `fh' "gic_share,`yv',IV,`b',`se',`p',`kp',`nn'" _n
 15.     quietly reghdfe `yv' ln_gaci_max lnpop, absorb(isocode y) vce(cluster isocode)
 16.     local b = _b[ln_gaci_max]
 17.     local se = _se[ln_gaci_max]
 18.     local p = 2*ttail(e(df_r), abs(`b'/`se'))
 19.     local nn = e(N)
 20.     file write `fh' "gic_share,`yv',OLS,`b',`se',`p',.,`nn'" _n
 21. }
