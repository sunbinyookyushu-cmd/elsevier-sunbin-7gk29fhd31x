. tempname fh

. file open `fh' using "_wage_premia_results.csv", write replace
(file _wage_premia_results.csv not found)

. file write `fh' "outcome,model,b,se,p,kpf,N,Nc" _n

. foreach yv in prem_adv_bas prem_adv_int prem_ser_agr prem_ser_ind prem_mkt_man prem_mgr_elem prem_prof_elem prem_prof_craft gini_earn_total ln_earn_total {
  2.     capture confirm variable `yv'
  3.     if _rc continue
  4.     quietly count if !missing(`yv', ln_gaci_max, feyrer_int, lnpop)
  5.     if r(N) < 100 continue
  6.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
  7.     if _rc == 0 {
  8.         quietly levelsof isocode if e(sample), local(cc)
  9.         local nc : word count `cc'
 10.         file write `fh' "`yv',IV,`=_b[ln_gaci_max]',`=_se[ln_gaci_max]',`=2*normal(-abs(_b[ln_gaci_max]/_se[ln_gaci_max]))',`=e(widstat)',`=e(N)',`nc'" _n
 11.     }
 12.     quietly reghdfe `yv' ln_gaci_max lnpop, absorb(isocode y) vce(cluster isocode)
 13.     quietly levelsof isocode if e(sample), local(cc)
 14.     local nc : word count `cc'
 15.     file write `fh' "`yv',OLS,`=_b[ln_gaci_max]',`=_se[ln_gaci_max]',`=2*ttail(e(df_r), abs(_b[ln_gaci_max]/_se[ln_gaci_max]))',.,`=e(N)',`nc'" _n
 16.     * headline Gini on the same sample, for comparability
.     capture noisily ivreghdfe ln_gini_mkt lnpop (ln_gaci_max = feyrer_int) if !missing(`yv'), absorb(isocode y) cluster(isocode)
 17.     if _rc == 0 file write `fh' "`yv'_sample_gini,IV,`=_b[ln_gaci_max]',`=_se[ln_gaci_max]',`=2*normal(-abs(_b[ln_gaci_max]/_se[ln_gaci_max]))',`=e(widstat)',`=e(N)',." _n
 18. }
