. gen post2010 = (y>=2010)

. gen midinc = (inc3==2)

. gen highinc = (inc3==3)

. foreach v in ln_gaci_max ln_gaci_cwm ln_gaci_sum feyrer_int tourism_int {
  2.     gen `v'_mid = `v'*midinc
  3.     gen `v'_high = `v'*highinc
  4.     gen `v'_post = `v'*post2010
  5.     gen `v'_conc = `v'*conc2
  6.     gen `v'_g2 = `v'*(gini3==2)
  7.     gen `v'_g3 = `v'*(gini3==3)
  8. }

. gen tophub = inlist(c,"DEU","USA","FRA","NLD","GBR") | inlist(c,"CHN","CAN","SGP","ARE","THA")

. sort isocode y

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. 
end of do-file

. tempname fh

. file open `fh' using "_longdiff_results.csv", write replace

. file write `fh' "block,outcome,spec,b,se,p,kpf,N" _n

. foreach yv in ln_gini_mkt ln_gini_disp {
  2.     * A. horizon: lagged connectivity k=0..10, instrument lagged k
.     forvalues k = 0/10 {
  3.         ivreghdfe `yv' lnpop (L`k'.ln_gaci_max = L`k'.feyrer_int), absorb(isocode y) robust
  4.         local b = _b[L`k'.ln_gaci_max]
  5.         local se = _se[L`k'.ln_gaci_max]
  6.         local p = 2*normal(-abs(`b'/`se'))
  7.         local kp = e(widstat)
  8.         local nn = e(N)
  9.         file write `fh' "lag,`yv',k`k',`b',`se',`p',`kp',`nn'" _n
 10.     }
 11.     * A2. leads (placebo): future connectivity
.     forvalues k = 1/5 {
 12.         ivreghdfe `yv' lnpop (F`k'.ln_gaci_max = F`k'.feyrer_int), absorb(isocode y) robust
 13.         local b = _b[F`k'.ln_gaci_max]
 14.         local se = _se[F`k'.ln_gaci_max]
 15.         local p = 2*normal(-abs(`b'/`se'))
 16.         local kp = e(widstat)
 17.         local nn = e(N)
 18.         file write `fh' "lead,`yv',f`k',`b',`se',`p',`kp',`nn'" _n
 19.     }
 20.     * A3. lead conditional on current
.     ivreghdfe `yv' lnpop (ln_gaci_max F3.ln_gaci_max = feyrer_int F3.feyrer_int), absorb(isocode y) robust
 21.     local kp = e(widstat)
 22.     local nn = e(N)
 23.     local b = _b[F3.ln_gaci_max]
 24.     local se = _se[F3.ln_gaci_max]
 25.     local p = 2*normal(-abs(`b'/`se'))
 26.     file write `fh' "lead_cond,`yv',f3_given_t,`b',`se',`p',`kp',`nn'" _n
 27.     local b = _b[ln_gaci_max]
 28.     local se = _se[ln_gaci_max]
 29.     local p = 2*normal(-abs(`b'/`se'))
 30.     file write `fh' "lead_cond,`yv',t_given_f3,`b',`se',`p',`kp',`nn'" _n
 31.     * B. long differences (cross-section of changes, continent FE, robust)
.     foreach pair in "1996 2019" "1996 2023" "2000 2019" "2005 2019" "2010 2019" {
 32.         local y0 : word 1 of `pair'
 33.         local y1 : word 2 of `pair'
 34.         preserve
 35.         keep if inlist(y, `y0', `y1')
 36.         bysort isocode: keep if _N==2
 37.         bysort isocode (y): gen dY = `yv'[2]-`yv'[1]
 38.         bysort isocode (y): gen dX = ln_gaci_max[2]-ln_gaci_max[1]
 39.         bysort isocode (y): gen dZ = feyrer_int[2]-feyrer_int[1]
 40.         bysort isocode (y): gen dP = lnpop[2]-lnpop[1]
 41.         bysort isocode (y): gen dT = tourism_int[2]-tourism_int[1]
 42.         bysort isocode (y): keep if _n==1
 43.         reg dY dX dP i.contid, robust
 44.         local b = _b[dX]
 45.         local se = _se[dX]
 46.         local p = 2*ttail(e(df_r), abs(`b'/`se'))
 47.         local nn = e(N)
 48.         file write `fh' "LD_OLS,`yv',`y0'_`y1',`b',`se',`p',.,`nn'" _n
 49.         ivreg2 dY dP i.contid (dX = dZ), robust
 50.         local b = _b[dX]
 51.         local se = _se[dX]
 52.         local p = 2*normal(-abs(`b'/`se'))
 53.         local kp = e(widstat)
 54.         local nn = e(N)
 55.         file write `fh' "LD_IV,`yv',`y0'_`y1',`b',`se',`p',`kp',`nn'" _n
 56.         ivreg2 dY dP i.contid (dX = dT), robust
 57.         local b = _b[dX]
 58.         local se = _se[dX]
 59.         local p = 2*normal(-abs(`b'/`se'))
 60.         local kp = e(widstat)
 61.         local nn = e(N)
 62.         file write `fh' "LD_IVtour,`yv',`y0'_`y1',`b',`se',`p',`kp',`nn'" _n
 63.         ivreg2 dY dP i.contid (dX = dZ dT), robust
 64.         local b = _b[dX]
 65.         local se = _se[dX]
 66.         local p = 2*normal(-abs(`b'/`se'))
 67.         local kp = e(widstat)
 68.         local nn = e(N)
 69.         file write `fh' "LD_IVboth,`yv',`y0'_`y1',`b',`se',`p',`kp',`nn'" _n
 70.         restore
 71.     }
 72.     * C. stacked 5-year differences
.     preserve
 73.     gen dY = `yv' - L5.`yv'
 74.     gen dX = ln_gaci_max - L5.ln_gaci_max
 75.     gen dZ = feyrer_int - L5.feyrer_int
 76.     gen dP = lnpop - L5.lnpop
 77.     gen dT = tourism_int - L5.tourism_int
 78.     keep if !missing(dY, dX, dZ)
 79.     ivreghdfe dY dP (dX = dZ), absorb(y contid) cluster(isocode)
 80.     local b = _b[dX]
 81.     local se = _se[dX]
 82.     local p = 2*normal(-abs(`b'/`se'))
 83.     local kp = e(widstat)
 84.     local nn = e(N)
 85.     file write `fh' "D5_IV,`yv',stacked5,`b',`se',`p',`kp',`nn'" _n
 86.     ivreghdfe dY dP (dX = dT), absorb(y contid) cluster(isocode)
 87.     local b = _b[dX]
 88.     local se = _se[dX]
 89.     local p = 2*normal(-abs(`b'/`se'))
 90.     local kp = e(widstat)
 91.     local nn = e(N)
 92.     file write `fh' "D5_IVtour,`yv',stacked5,`b',`se',`p',`kp',`nn'" _n
 93.     reghdfe dY dX dP, absorb(y contid) cluster(isocode)
 94.     local b = _b[dX]
 95.     local se = _se[dX]
 96.     local p = 2*ttail(e(df_r), abs(`b'/`se'))
 97.     local nn = e(N)
 98.     file write `fh' "D5_OLS,`yv',stacked5,`b',`se',`p',.,`nn'" _n
 99.     restore
100. }
