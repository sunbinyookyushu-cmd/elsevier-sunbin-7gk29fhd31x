. tempname fh

. file open `fh' using "_median_splits_results.csv", write replace
(file _median_splits_results.csv not found)

. file write `fh' "var,group,outcome,b,se,p,kpf,N,Nc" _n

. capture program drop runone

. program define runone
  1.     args fh vv grp yv cond
  2.     quietly count if `cond' & !missing(`yv', ln_gaci_max, feyrer_int, lnpop)
  3.     if r(N) < 60 exit
  4.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int) if `cond', absorb(isocode y) cluster(isocode)
  5.     if _rc exit
  6.     local b = _b[ln_gaci_max]
  7.     local se = _se[ln_gaci_max]
  8.     local p = 2*normal(-abs(`b'/`se'))
  9.     quietly levelsof isocode if e(sample), local(cc)
 10.     local nc : word count `cc'
 11.     file write `fh' "`vv',`grp',`yv',`b',`se',`p',`=e(widstat)',`=e(N)',`nc'" _n
 12. end

. foreach yv in ln_gini_mkt ln_apt_all ln_apt_top_bot ln_spt_b50 ln_spt_d10 {
  2.     foreach v of local VARS {
  3.         runone `fh' "`v'" "below" `yv' "m_`v' == 1"
  4.         runone `fh' "`v'" "above" `yv' "m_`v' == 2"
  5.     }
  6. }
