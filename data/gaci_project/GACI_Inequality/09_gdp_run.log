. * ---------------------------------------------------------------- D. horizon and leads
. foreach yv in ln_gdppc ln_avg_bot50_wid ln_avg_top10_wid ln_ratio_avg {
  2.     forvalues k = 0/10 {
  3.         capture ivreghdfe `yv' lnpop (L`k'.ln_gaci_max = L`k'.feyrer_int), absorb(isocode y) robust
  4.         if _rc==0 {
  5.             local bb = _b[L`k'.ln_gaci_max]
  6.             local ss = _se[L`k'.ln_gaci_max]
  7.             local pp = 2*normal(-abs(`bb'/`ss'))
  8.             local kp = e(widstat)
  9.             local nn = e(N)
 10.             file write `fh' "lag,`yv',ln_gaci_max,feyrer_int,k`k',`bb',`ss',`pp',`kp',.,`nn'" _n
 11.         }
 12.     }
 13.     forvalues k = 1/5 {
 14.         capture ivreghdfe `yv' lnpop (F`k'.ln_gaci_max = F`k'.feyrer_int), absorb(isocode y) robust
 15.         if _rc==0 {
 16.             local bb = _b[F`k'.ln_gaci_max]
 17.             local ss = _se[F`k'.ln_gaci_max]
 18.             local pp = 2*normal(-abs(`bb'/`ss'))
 19.             local kp = e(widstat)
 20.             local nn = e(N)
 21.             file write `fh' "lead,`yv',ln_gaci_max,feyrer_int,f`k',`bb',`ss',`pp',`kp',.,`nn'" _n
 22.         }
 23.     }
 24. }

