. * ---------------------------------------------------------------- G. growth-conditional inequality
. * inequality response holding measured income per head fixed
. foreach yv in ln_gini_mkt ln_gini_disp {
  2.     ivreghdfe `yv' lnpop ln_gdppc (ln_gaci_max = feyrer_int), absorb(isocode y) robust
  3.     local kp = e(widstat)
  4.     local nn = e(N)
  5.     local bb = _b[ln_gaci_max]
  6.     local ss = _se[ln_gaci_max]
  7.     local pp = 2*normal(-abs(`bb'/`ss'))
  8.     file write `fh' "joint,`yv',ln_gaci_max,feyrer_int,cond_gdp,`bb',`ss',`pp',`kp',.,`nn'" _n
  9.     local bb = _b[ln_gdppc]
 10.     local ss = _se[ln_gdppc]
 11.     local pp = 2*normal(-abs(`bb'/`ss'))
 12.     file write `fh' "joint,`yv',ln_gdppc,feyrer_int,cond_gdp,`bb',`ss',`pp',.,.,`nn'" _n
 13. }
