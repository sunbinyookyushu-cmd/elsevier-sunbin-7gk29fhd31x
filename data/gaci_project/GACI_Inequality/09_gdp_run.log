. * ---------------------------------------------------------------- E. long differences
. foreach yv in ln_gdppc ln_avg_bot50_wid ln_avg_top10_wid ln_ratio_avg {
  2.     foreach pair in "1996 2019" "1996 2023" "2000 2019" "2005 2019" "2010 2019" {
  3.         local y0 : word 1 of `pair'
  4.         local y1 : word 2 of `pair'
  5.         preserve
  6.         keep if inlist(y, `y0', `y1')
  7.         bysort isocode: keep if _N==2
  8.         bysort isocode (y): gen dY = `yv'[2]-`yv'[1]
  9.         bysort isocode (y): gen dX = ln_gaci_max[2]-ln_gaci_max[1]
 10.         bysort isocode (y): gen dZ = feyrer_int[2]-feyrer_int[1]
 11.         bysort isocode (y): gen dP = lnpop[2]-lnpop[1]
 12.         bysort isocode (y): gen dT = tourism_int[2]-tourism_int[1]
 13.         bysort isocode (y): keep if _n==1
 14.         capture reg dY dX dP i.contid, robust
 15.         if _rc==0 {
 16.             local bb = _b[dX]
 17.             local ss = _se[dX]
 18.             local pp = 2*ttail(e(df_r), abs(`bb'/`ss'))
 19.             local nn = e(N)
 20.             file write `fh' "LD_OLS,`yv',ln_gaci_max,none,`y0'_`y1',`bb',`ss',`pp',.,.,`nn'" _n
 21.         }
 22.         capture ivreg2 dY dP i.contid (dX = dZ), robust
 23.         if _rc==0 {
 24.             local bb = _b[dX]
 25.             local ss = _se[dX]
 26.             local pp = 2*normal(-abs(`bb'/`ss'))
 27.             local kp = e(widstat)
 28.             local nn = e(N)
 29.             file write `fh' "LD_IV,`yv',ln_gaci_max,feyrer_int,`y0'_`y1',`bb',`ss',`pp',`kp',.,`nn'" _n
 30.         }
 31.         capture ivreg2 dY dP i.contid (dX = dT), robust
 32.         if _rc==0 {
 33.             local bb = _b[dX]
 34.             local ss = _se[dX]
 35.             local pp = 2*normal(-abs(`bb'/`ss'))
 36.             local kp = e(widstat)
 37.             local nn = e(N)
 38.             file write `fh' "LD_IVtour,`yv',ln_gaci_max,tourism_int,`y0'_`y1',`bb',`ss',`pp',`kp',.,`nn'" _n
 39.         }
 40.         restore
 41.     }
 42.     preserve
 43.     gen dY = `yv' - L5.`yv'
 44.     gen dX = ln_gaci_max - L5.ln_gaci_max
 45.     gen dZ = feyrer_int - L5.feyrer_int
 46.     gen dP = lnpop - L5.lnpop
 47.     keep if !missing(dY, dX, dZ)
 48.     capture reghdfe dY dX dP, absorb(y contid) cluster(isocode)
 49.     if _rc==0 {
 50.         local bb = _b[dX]
 51.         local ss = _se[dX]
 52.         local pp = 2*ttail(e(df_r), abs(`bb'/`ss'))
 53.         local nn = e(N)
 54.         file write `fh' "D5_OLS,`yv',ln_gaci_max,none,stacked5,`bb',`ss',`pp',.,.,`nn'" _n
 55.     }
 56.     capture ivreghdfe dY dP (dX = dZ), absorb(y contid) cluster(isocode)
 57.     if _rc==0 {
 58.         local bb = _b[dX]
 59.         local ss = _se[dX]
 60.         local pp = 2*normal(-abs(`bb'/`ss'))
 61.         local kp = e(widstat)
 62.         local nn = e(N)
 63.         file write `fh' "D5_IV,`yv',ln_gaci_max,feyrer_int,stacked5,`bb',`ss',`pp',`kp',.,`nn'" _n
 64.     }
 65.     restore
 66. }
