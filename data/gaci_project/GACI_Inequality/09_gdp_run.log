. foreach ctrl in "none" "urban" "ter_enr" "trade_gdp" "tax_gdp" "ln_sea_ma" "urban ter_enr trade_gdp" {
  2.     local ci = `ci' + 1
  3.     local cv = "`ctrl'"
  4.     if "`ctrl'"=="none" local cv = ""
  5.     foreach yv in ln_gdppc ln_avg_bot50_wid {
  6.         ivreghdfe `yv' lnpop `cv' (ln_gaci_max = feyrer_int), absorb(isocode y) robust
  7.         local bb = _b[ln_gaci_max]
  8.         local ss = _se[ln_gaci_max]
  9.         local pp = 2*normal(-abs(`bb'/`ss'))
 10.         local kp = e(widstat)
