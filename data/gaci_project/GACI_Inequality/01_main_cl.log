. foreach ivv in tourism_int feyrer_int {
  2. foreach tr in ln_gaci_cwm ln_gaci_max ln_gaci_sum {
  3.     * first stage
.     reghdfe `tr' `ivv' lnpop, absorb(isocode y) vce(cluster isocode)
  4.     local fb = _b[`ivv']
  5.     local fse = _se[`ivv']
  6.     local fp = 2*ttail(e(df_r), abs(_b[`ivv']/_se[`ivv']))
  7.     test `ivv'
  8.     local F = r(F)
  9.     file write `fh' "`ivv',`tr',firststage,FS,`fb',`fse',`fp',`F',`e(N)'" _n
 10.     foreach yv in ln_gini_mkt ln_gini_disp gini_mkt gini_disp abs_red {
 11.         reghdfe `yv' `tr' lnpop, absorb(isocode y) vce(cluster isocode)
 12.         local b = _b[`tr']
 13.         local se = _se[`tr']
 14.         local p = 2*ttail(e(df_r), abs(_b[`tr']/_se[`tr']))
 15.         file write `fh' "`ivv',`tr',`yv',OLS,`b',`se',`p',.,`e(N)'" _n
 16.         ivreghdfe `yv' lnpop (`tr' = `ivv'), absorb(isocode y) cluster(isocode)
 17.         local b = _b[`tr']
 18.         local se = _se[`tr']
 19.         local p = 2*normal(-abs(_b[`tr']/_se[`tr']))
 20.         local kp = e(widstat)
 21.         file write `fh' "`ivv',`tr',`yv',IV,`b',`se',`p',`kp',`e(N)'" _n
 22.         ivreghdfe `yv' lnpop (`tr' = `ivv'), absorb(isocode y) cluster(isocode)
 23.         local b = _b[`tr']
 24.         local se = _se[`tr']
 25.         local p = 2*normal(-abs(_b[`tr']/_se[`tr']))
 26.         local kp = e(widstat)
 27.         file write `fh' "`ivv',`tr',`yv',IVcl,`b',`se',`p',`kp',`e(N)'" _n
 28.     }
 29. }
 30. }
