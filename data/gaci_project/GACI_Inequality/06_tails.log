  2.     ivreghdfe `yv' lnpop (ln_gaci_max ln_gaci_max_mid ln_gaci_max_high = feyrer_int feyrer_int_mid feyrer_int_high), absorb(isocode y) robust
  3.     local kp = e(widstat)
  4.     local nn = e(N)
  5.     foreach t in ln_gaci_max ln_gaci_max_mid ln_gaci_max_high {
  6.         local b = _b[`t']
  7.         local se = _se[`t']
  8.         local p = 2*normal(-abs(`b'/`se'))
  9.         file write `fh' "tails_inc3,`yv',`t',IV,`b',`se',`p',`kp',`nn'" _n
 10.     }
 11.     lincom ln_gaci_max + ln_gaci_max_mid
 12.     file write `fh' "tails_inc3,`yv',mid_total,IV,`r(estimate)',`r(se)',`r(p)',.,`nn'" _n
 13.     lincom ln_gaci_max + ln_gaci_max_high
 14.     file write `fh' "tails_inc3,`yv',high_total,IV,`r(estimate)',`r(se)',`r(p)',.,`nn'" _n
 15. }
