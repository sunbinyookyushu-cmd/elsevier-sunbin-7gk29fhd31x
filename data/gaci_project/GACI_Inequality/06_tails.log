. keep if !missing(gini_mkt)
(906 observations deleted)

. gen cont = substr(reg,1,2)

. encode cont, gen(contid)

. * baseline (first observed year) income and inequality terciles, fixed per country
. bysort isocode (y): gen basepc = lnpc[1]

. bysort isocode (y): gen basegini = gini_mkt[1]

. bysort isocode (y): gen baseshare = share_max[1]

. bysort isocode (y): gen firsty = y[1]

. preserve

. bysort isocode: keep if _n==1
(3,571 observations deleted)

. xtile inc3 = basepc, nq(3)

. xtile gini3 = basegini, nq(3)

. gen conc2 = (baseshare > 0.5)

. keep isocode inc3 gini3 conc2

. tempfile grp

. save `grp'
file C:\Users\sunbi\AppData\Local\Temp\ST_c358_000002.tmp saved

. restore

. merge m:1 isocode using `grp', nogen
(label isocode already defined)

    Result                           # of obs.
    -----------------------------------------
    not matched                             0
    matched                             3,737  
    -----------------------------------------

. gen post2010 = (y>=2010)

. gen midinc = (inc3==2)

. gen highinc = (inc3==3)

. foreach v in ln_gaci_max ln_gaci_cwm ln_gaci_sum feyrer_int tourism_int {
  2.     gen `v'_mid = `v'*midinc
  3.     gen `v'_high = `v'*highinc
  4.     gen `v'_post = `v'*post2010
  5.     gen `v'_conc = `v'*conc2
  6.     gen `v'_g2 = `v'*(gini3==2)
  7.     gen `v'_g3 = `v'*(gini3==3)
  8. }

. gen tophub = inlist(c,"DEU","USA","FRA","NLD","GBR") | inlist(c,"CHN","CAN","SGP","ARE","THA")

. sort isocode y

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. 
end of do-file

. tempname fh

. file open `fh' using "_tails_results.csv", write replace

. file write `fh' "block,outcome,treat,model,b,se,p,kpf,N" _n

. * WID pretax and post-tax shares; SWIID reference
. foreach yv in ln_top10_wid ln_top1_wid ln_bot50_wid ratio_t10_b50 ln_gini_pre_wid ln_gini_post_wid ln_top10_post_wid ln_bot50_post_wid top10_wid top1_wid bot50_wid {
  2.     foreach tr in ln_gaci_max ln_gaci_cwm ln_gaci_sum {
  3.         reghdfe `yv' `tr' lnpop, absorb(isocode y) vce(robust)
  4.         local b = _b[`tr']
  5.         local se = _se[`tr']
  6.         local p = 2*ttail(e(df_r), abs(`b'/`se'))
  7.         local nn = e(N)
  8.         file write `fh' "tails,`yv',`tr',OLS,`b',`se',`p',.,`nn'" _n
  9.         ivreghdfe `yv' lnpop (`tr' = feyrer_int), absorb(isocode y) robust
 10.         local b = _b[`tr']
 11.         local se = _se[`tr']
 12.         local p = 2*normal(-abs(`b'/`se'))
 13.         local kp = e(widstat)
 14.         local nn = e(N)
 15.         file write `fh' "tails,`yv',`tr',IV,`b',`se',`p',`kp',`nn'" _n
 16.         ivreghdfe `yv' lnpop (`tr' = feyrer_int), absorb(isocode y) cluster(isocode)
 17.         local b = _b[`tr']
 18.         local se = _se[`tr']
 19.         local p = 2*normal(-abs(`b'/`se'))
 20.         local kp = e(widstat)
 21.         local nn = e(N)
 22.         file write `fh' "tails,`yv',`tr',IVcl,`b',`se',`p',`kp',`nn'" _n
 23.     }
 24. }
