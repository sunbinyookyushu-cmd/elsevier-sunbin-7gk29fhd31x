. * redistribution wedge: post-tax minus pre-tax top10 share, and pre/post gini gap
. gen wedge_top10 = top10_wid - top10_post_wid
(21 missing values generated)

. gen wedge_gini = gini_pre_wid - gini_post_wid
(21 missing values generated)

. gen wedge_swiid = gini_mkt - gini_disp

. foreach yv in wedge_top10 wedge_gini wedge_swiid {
  2.     reghdfe `yv' ln_gaci_max lnpop, absorb(isocode y) vce(robust)
  3.     local b = _b[ln_gaci_max]
  4.     local se = _se[ln_gaci_max]
  5.     local p = 2*ttail(e(df_r), abs(`b'/`se'))
  6.     local nn = e(N)
  7.     file write `fh' "wedge,`yv',ln_gaci_max,OLS,`b',`se',`p',.,`nn'" _n
  8.     ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) robust
  9.     local b = _b[ln_gaci_max]
 10.     local se = _se[ln_gaci_max]
 11.     local p = 2*normal(-abs(`b'/`se'))
 12.     local kp = e(widstat)
 13.     local nn = e(N)
 14.     file write `fh' "wedge,`yv',ln_gaci_max,IV,`b',`se',`p',`kp',`nn'" _n
 15.     ivreghdfe `yv' lnpop (ln_gaci_max = feyrer_int), absorb(isocode y) cluster(isocode)
 16.     local b = _b[ln_gaci_max]
 17.     local se = _se[ln_gaci_max]
 18.     local p = 2*normal(-abs(`b'/`se'))
 19.     local kp = e(widstat)
 20.     local nn = e(N)
 21.     file write `fh' "wedge,`yv',ln_gaci_max,IVcl,`b',`se',`p',`kp',`nn'" _n
 22. }
