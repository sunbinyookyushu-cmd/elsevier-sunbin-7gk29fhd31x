. foreach tr in ln_gaci_max ln_gaci_cwm ln_gaci_sum {
  2.     foreach yv in ln_gini_mkt ln_gini_disp ln_gini_pre_wid ln_palma ln_p90_p10 ln_p50_p10 ln_abs_gap {
  3.         capture confirm variable `yv'
  4.         if _rc continue
  5.         quietly reghdfe `yv' `tr' lnpop, absorb(isocode y) vce(cluster isocode)
  6.         file write `fh' "`tr',`yv',OLS,`=_b[`tr']',`=_se[`tr']',`=2*ttail(e(df_r), abs(_b[`tr']/_se[`tr']))',.,`=e(N)'" _n
  7.         capture noisily ivreghdfe `yv' lnpop (`tr' = feyrer_int), absorb(isocode y) cluster(isocode)
  8.         if _rc == 0 file write `fh' "`tr',`yv',IV,`=_b[`tr']',`=_se[`tr']',`=2*normal(-abs(_b[`tr']/_se[`tr']))',`=e(widstat)',`=e(N)'" _n
  9.     }
 10. }
