. encode c, gen(isocode)

. xtset isocode y

Panel variable: isocode (unbalanced)
 Time variable: y, 1996 to 2023, but with gaps
         Delta: 1 unit

. gen g_int = merch_intensity

. gen g_shr = merch_share

. gen g_vol = merch_intensity + lngdp

. gen post = (y>=2010)

. 
. capture which ivreghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
.     ssc install ivreghdfe, replace
. }

. 
. * ---- (A) pre/post split ----
. capture program drop _t

. program define _t
  1.     args lbl cond
  2.     foreach yv in g_int g_vol g_shr lnpc lngdp {
  3.         capture noisily ivreghdfe `yv' lnpop (ln_gaci_cwm = tourism_int) if `cond', absorb(isocode y) robust
  4.         if _rc==0 {
  5.             local b=_b[ln_gaci_cwm]
  6.             local se=_se[ln_gaci_cwm]
  7.             local p=2*ttail(e(df_r),abs(`b'/`se'))
  8.             noisily di "TSPL|`lbl'|`yv'|`b'|`se'|`p'|" e(widstat) "|" e(N)
  9.         }
 10.         else noisily di "TSPL|`lbl'|`yv'|FAIL|.|.|.|."
 11.     }
 12. end

. di _n "############ pre 1996-2009 ############"

