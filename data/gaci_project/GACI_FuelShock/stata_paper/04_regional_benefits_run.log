. gen T_post1 = treat_c * post1

. gen T_post2 = treat_c * post2

. reghdfe ln_nights_for tp lngdp lnpop if stk != 0 & donut == 0 & post2 == 0, absorb(fe_cm fe_t) vce(cluster iso3n)
