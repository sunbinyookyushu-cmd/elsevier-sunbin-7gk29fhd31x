. * ---------- A. ivmediate: all treated airports ----------
. foreach m in ln_deg ln_gaci {
  2.     di _n "==== ivmediate: Y = ln_co2, M = `m' ===="
  3.     ivmediate ln_co2 bp i.fe_t, mediator(`m') treatment(dose_post) instrument(tp) absorb(fe_u) vce(cluster iso3n)
  4.     di _n "==== ivmediate: Y = ln_int (CO2 per seat-km), M = `m' ===="
  5.     ivmediate ln_int bp i.fe_t, mediator(`m') treatment(dose_post) instrument(tp) absorb(fe_u) vce(cluster iso3n)
  6. }

