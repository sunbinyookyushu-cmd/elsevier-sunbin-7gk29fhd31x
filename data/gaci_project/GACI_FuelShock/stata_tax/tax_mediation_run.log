. * ---------- C. Manual three-step (conservative, mediator as control) ----------
. * total:   Y on tp;  mediator: M on tp;  direct: Y on tp and M;  indirect = total - direct (Gelbach identity)
. foreach m in ln_deg ln_gaci {
  2.     reghdfe ln_co2 tp bp, absorb(fe_u fe_t) vce(cluster iso3n)
  3.     scalar tot_`m' = _b[tp]
  4.     reghdfe `m' tp bp, absorb(fe_u fe_t) vce(cluster iso3n)
  5.     scalar pi_`m' = _b[tp]
  6.     reghdfe ln_co2 tp bp `m', absorb(fe_u fe_t) vce(cluster iso3n)
  7.     scalar dir_`m' = _b[tp]
  8.     scalar beta_`m' = _b[`m']
  9.     di _n "Gelbach, M = `m': total " tot_`m' "  direct " dir_`m' "  indirect " tot_`m' - dir_`m' "  (= pi " pi_`m' " x beta " beta_`m' ")"  "  share " (tot_`
> m' - dir_`m') / tot_`m'
 10. }
