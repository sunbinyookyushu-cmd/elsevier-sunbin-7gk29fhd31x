. encode c, gen(isocode)

. xtset isocode y

Panel variable: isocode (unbalanced)
 Time variable: y, 1996 to 2023, but with gaps
         Delta: 1 unit

. gen g_int = merch_intensity

. gen g_shr = merch_share

. gen g_vol = merch_intensity + lngdp

. 
. capture which ivreghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
.     ssc install ivreghdfe, replace
. }

. 
. * ---- (1) pooled main: natural vs ALL ----
. capture program drop _m2

. program define _m2
  1.     args treat spec yv
  2.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_cwm = `treat'), absorb(isocode y) robust
  3.     if _rc==0 {
  4.         local b=_b[ln_gaci_cwm]
  5.         local se=_se[ln_gaci_cwm]
  6.         local p=2*ttail(e(df_r),abs(`b'/`se'))
  7.         noisily di "ALLH|`spec'|`yv'|`b'|`se'|`p'|" e(widstat) "|" e(N)
  8.     }
  9.     else noisily di "ALLH|`spec'|`yv'|FAIL|.|.|.|."
 10. end

. di _n "############ POOLED MAIN: natural+mixed vs ALL heritage ############"

############ POOLED MAIN: natural+mixed vs ALL heritage ############

. foreach yv in g_int g_vol g_shr lnpc lngdp {
  2.     _m2 tourism_int natural `yv'
  3.     _m2 tourism_all allherit `yv'
  4. }
