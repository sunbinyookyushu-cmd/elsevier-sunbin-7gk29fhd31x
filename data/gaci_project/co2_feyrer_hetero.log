. * ---- results accumulator ----
. tempname H

. postfile `H' str12 panel str16 grp b se p KPF N Nc using "_feyrer_hetero_post.dta", replace
(note: file _feyrer_hetero_post.dta not found)

. 
. capture program drop runcell

. program define runcell
  1.     args H panel grp yv cond
  2.     quietly count if `cond' & !missing(`yv', ln_gaci_cwm, feyrer_int, lnpop, ln_sea_ma)
  3.     if r(N) < 60 {
  4.         di as err "SKIP `panel' `grp': N = " r(N)
  5.         exit
  6.     }
  7.     capture noisily ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int) if `cond', absorb(isocode y) robust
  8.     if _rc exit
  9.     local b = _b[ln_gaci_cwm]
 10.     local se = _se[ln_gaci_cwm]
 11.     local p = 2 * normal(-abs(`b'/`se'))
 12.     quietly levelsof isocode if e(sample), local(cc)
 13.     local nc : word count `cc'
 14.     post `H' ("`panel'") ("`grp'") (`b') (`se') (`p') (e(widstat)) (e(N)) (`nc')
 15.     di "HET [`panel'] `grp': b = " %8.3f `b' " (se " %7.3f `se' ")  KP F = " %7.1f e(widstat) "  N = " %7.0f e(N) "  countries = " `nc'
 16. end

. 
