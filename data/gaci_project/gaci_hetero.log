. 
. *============================================================================
> ==
. * A) SPLIT-SAMPLE IV  (headline spec run separately within each subgroup)
. *    each block: 2SLS coefficient on ln_gaci_cwm + estat firststage (weak-id 
> F)
. *============================================================================
> ==
. eststo clear

. 
. di _n "##################### A1. by INCOME #####################"

##################### A1. by INCOME #####################

. foreach g in 0 1 {
  2.     di _n "==== income = `g'  (0=low,1=high) ===="
  3.     ivregress 2sls trade_intensity lnpop deg_mean i.regcode i.y ///
>         (ln_gaci_cwm = lnz) if hi_inc==`g', vce(robust)
  4.     estimates store INC`g'
  5.     estat firststage
  6. }

