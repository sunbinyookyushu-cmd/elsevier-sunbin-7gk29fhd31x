. do gaci_analysis.do 

. *============================================================================
> ==
. * gaci_analysis.do   --  SINGLE master analysis file
. * Air connectivity (GACI) -> trade, IV/2SLS.  Uses ONE dataset: gaci_panel.cs
> v
. *============================================================================
> ==
. * CODEBOOK (gaci_panel.csv, 4,714 country-year, 187 countries, 1996-2023)
. * ---- id ----
. *   c reg = ISO3 country / sub-region ;  y = year
. * ---- outcomes ----
. *   ln_tradevol  ln(trade volume, USD)
. *   trade_share  trade openness = trade % GDP
. *   lngdp        ln(GDP, USD)        [used to build trade_intensity = ln_trad
> evol-lngdp]
. * ---- treatments (air connectivity), all ENDOGENOUS ----
. *   lng          ln(GACI_sum)            total connectivity (scales with size
> )
. *   ln_gaci_cwm  ln(capacity-weighted-mean GACI)   hub QUALITY, size-neutral
. *   ln_gaci_mean ln(simple-mean GACI)
. *   lncap        ln(total seat capacity)
. * ---- instruments ----
. *   ln_unesco    ln(cumulative UNESCO World Heritage sites)  [tourism channel
> ; missing if 0]
. *   unesco_cum   level count ; unesco_cum_nat = natural/mixed only
. *   lnz          ln(predicted GACI = geographic market access, pop/dist^2)  [
> Frankel-Romer]
. * ---- controls ----
. *   lnpc lnpop lnland abslat n_air
. * ---- GACI components (country sum & mean): deg_/eig_/close_/betw_/regimp_/c
> ap_ ----
. *
. * KEY FACTS (updated 2026-06-17, leave-out lnZ):
. *  - lnz is now a PROPER Frankel-Romer leave-out instrument: foreign pop / di
> st^2 with the
. *    OWN country fully excluded.  (lnz_own = old version that leaked own-coun
> try population
. *    through domestic airports; kept ONLY for comparison.)
. *  - Geographic IV (lnz) is strong in LEVELS / region+year FE (first-stage F 
> ~ 21 for lng),
. *    but COLLAPSES under COUNTRY FE (F < 1): market access has ~no within-cou
> ntry variation.
. *    => headline uses REGION+year FE (absorb regcode y), NOT country FE.
. *  - For treatment = capacity-weighted-mean GACI (ln_gaci_cwm = hub QUALITY, 
> size-neutral),
. *    lnz survives country FE a bit better (clustered F ~ 3) but still weak; r
> egion+year is
. *    the usable spec.  Headline treatment = ln_gaci_cwm, instrument = lnz.
. *  - NB deg_mean is ITSELF an endogenous connectivity component (collinear wi
> th GACI).
. *    Including it as a control conditions on a collinear mediator -> always r
> eport the
. *    with-deg_mean and without-deg_mean specs as a robustness pair.
. *  - UNESCO natural-heritage (ln_unesco_nat) kept as an alternative-exclusion
>  robustness IV.
. *============================================================================
> ==
. 
. clear all

. set more off

. version 14

. cd "C:/Users/sunbi/managi-lab Dropbox/Sunbin Yoo/Research Box ^-^/2026/GACI"
C:\Users\sunbi\managi-lab Dropbox\Sunbin Yoo\Research Box ^-^\2026\GACI

. import delimited "gaci_panel.csv", clear varnames(1) encoding("utf-8")
(34 vars, 4,714 obs)

. 
. * numeric (blanks -> missing) for ALL columns EXCEPT string IDs c, reg
. ds c reg, not
y             lncap         lnz_own       deg_mean      regimp_sum
trade_share   gaci_cwmean   lnpc          eig_sum       regimp_mean
ln_tradevol   gaci_mean     lnpop         eig_mean      cap_sum
lngdp         ln_unesco     lnland        close_sum     cap_mean
lng           unesco_cum    abslat        close_mean
ln_gaci_cwm   unesco_cum~t  n_air         betw_sum
ln_gaci_mean  lnz           deg_sum       betw_mean

. destring `r(varlist)', replace force
y already numeric; no replace
trade_share already numeric; no replace
ln_tradevol already numeric; no replace
lngdp already numeric; no replace
lng already numeric; no replace
ln_gaci_cwm already numeric; no replace
ln_gaci_mean already numeric; no replace
lncap already numeric; no replace
gaci_cwmean already numeric; no replace
gaci_mean already numeric; no replace
ln_unesco already numeric; no replace
unesco_cum already numeric; no replace
unesco_cum_nat already numeric; no replace
lnz already numeric; no replace
lnz_own already numeric; no replace
lnpc already numeric; no replace
lnpop already numeric; no replace
lnland already numeric; no replace
abslat already numeric; no replace
n_air already numeric; no replace
deg_sum already numeric; no replace
deg_mean already numeric; no replace
eig_sum already numeric; no replace
eig_mean already numeric; no replace
close_sum already numeric; no replace
close_mean already numeric; no replace
betw_sum already numeric; no replace
betw_mean already numeric; no replace
regimp_sum already numeric; no replace
regimp_mean already numeric; no replace
cap_sum already numeric; no replace
cap_mean already numeric; no replace

. encode c,   gen(isocode)

. encode reg, gen(regcode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. 
. gen trade_intensity = ln_tradevol - lngdp     // = ln(trade/GDP) = openness

. 
. * UNESCO instrument: KEEP all country-years (0 sites -> ln(1)=0), avoids sele
> cting on
. * having heritage and keeps the 0->1 extensive margin (73 countries, 1,031 ro
> ws).
. * (Originally ln_unesco = ln(cum), which set 0-site rows to missing and dropp
> ed them.
. *  To reproduce the drop-zeros version as robustness: use ln(unesco_cum) inst
> ead.)
. replace ln_unesco = ln(1 + unesco_cum)
(4,714 real changes made)

. gen ln_unesco_nat = ln(1 + unesco_cum_nat)   // NATURAL+MIXED heritage = clea
> n tourism IV

. 
. label var lng          "ln GACI_sum (connectivity, endog)"

. label var ln_gaci_cwm  "ln capacity-wtd-mean GACI (hub quality, endog)"

. label var ln_unesco    "ln cumulative UNESCO sites (IV)"

. label var lnz          "ln predicted GACI / market access (IV)"

. label var trade_intensity "ln(trade/GDP) = openness"

. 
. capture which ivreg2

. if _rc {
.     capture ssc install ranktest, replace
.     capture ssc install ivreg2, replace
. }

. capture which ivreghdfe

. if _rc {
.     capture ssc install ftools, replace
.     capture ssc install reghdfe, replace
.     capture ssc install ivreghdfe, replace
. }

. 
