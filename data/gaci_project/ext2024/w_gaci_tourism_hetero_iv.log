. *------------------------------------------------------------------------------
. * SUBSAMPLE split (binary, at median) -- for comparison. Use this instead of the
. * interaction ONLY if BOTH halves keep KP first-stage F >= ~10; otherwise it is
. * weakly identified (as the earlier region/GDP splits were) and interaction IV wins.
. *------------------------------------------------------------------------------
. capture program drop _hs

. program define _hs
  1.     args splitvar splitname
  2.     quietly summarize `splitvar', detail
  3.     local md = r(p50)
  4.     foreach half in lo hi {
  5.         if "`half'"=="lo" local cond "`splitvar' <  `md'"
  6.         else              local cond "`splitvar' >= `md'"
  7.         foreach yv in g_int g_vol g_shr lnpc lngdp {
  8.             capture noisily ivreghdfe `yv' lnpop (ln_gaci_cwm = tourism_int) if (`cond') & !missing(`splitvar'), absorb(isocode y) robust
  9.             if _rc==0 {
 10.                 local b=_b[ln_gaci_cwm]
 11.                 local se=_se[ln_gaci_cwm]
 12.                 local p=2*ttail(e(df_r),abs(`b'/`se'))
 13.                 noisily di "HET4|`splitname'|`half'|`yv'|`b'|`se'|`p'|" e(widstat) "|" e(N)
 14.             }
 15.             else noisily di "HET4|`splitname'|`half'|`yv'|FAIL|.|.|.|."
 16.         }
 17.     }
 18. end

. di _n "############ SUBSAMPLE split: remoteness (median) ############"

############ SUBSAMPLE split: remoteness (median) ############

. _hs ln_remote remote
