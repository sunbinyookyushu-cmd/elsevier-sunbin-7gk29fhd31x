. encode c, gen(isocode)

. xtset isocode y

Panel variable: isocode (unbalanced)
 Time variable: y, 1996 to 2024, but with gaps
         Delta: 1 unit

. gen g_int = merch_intensity

. gen g_shr = merch_share

. gen g_vol = merch_intensity + lngdp

. 
. capture which ivreghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
.     ssc install ivreghdfe, replace
. }

. 
. capture program drop _j

. program define _j
  1.     syntax, yv(string) insts(string) tag(string)
  2.     capture noisily ivreghdfe `yv' lnpop (ln_gaci_cwm = `insts'), absorb(isocode y) robust
  3.     if _rc==0 {
  4.         local b=_b[ln_gaci_cwm]
  5.         local se=_se[ln_gaci_cwm]
  6.         local p=2*ttail(e(df_r),abs(`b'/`se'))
  7.         local Jp=.
  8.         if !missing(e(j)) & e(jdf)>0  local Jp=chi2tail(e(jdf),e(j))
  9.         noisily di "IV3|`tag'|`yv'|`b'|`se'|`p'|" e(widstat) "|" e(j) "|" e(jdf) "|`Jp'|" e(N)
 10.     }
 11.     else noisily di "IV3|`tag'|`yv'|FAIL|.|.|.|.|.|.|."
 12. end

. 
. di _n "############ natural-only  vs  three-heritage (over-ID + Hansen J) ############"

############ natural-only  vs  three-heritage (over-ID + Hansen J) ############

. foreach yv in g_int g_vol g_shr lnpc lngdp {
  2.     _j, yv(`yv') insts(z_nat)              tag(nat)
  3.     _j, yv(`yv') insts(z_nat z_mix z_cult) tag(three)
  4. }
