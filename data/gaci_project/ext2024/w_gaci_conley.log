. gen g_int = merch_intensity

. gen g_vol = merch_intensity + lngdp

. gen g_gdp = lngdp

. 
. capture which ivreghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
.     ssc install ivreghdfe, replace
. }

. 
. tempname R

. postfile `R' str8 outc double(betaiv seiv rfcoef rfse lb10 ub10 lb20 ub20 lb30 ub30 fstar nn) using "_conley_tmp", replace
(file _conley_tmp.dta not found)

. 
. foreach yv in g_int g_vol g_gdp {
  2.     di _n "==================== OUTCOME: `yv' ===================="
  3. 
.     * ---- reduced form ----
.     reghdfe `yv' tourism_int lnpop, absorb(isocode y) vce(robust)
  4.     local rfc = _b[tourism_int]
  5.     local rfs = _se[tourism_int]
  6. 
.     * ---- baseline 2SLS (gamma = 0) ----
.     ivreghdfe `yv' lnpop (ln_gaci_cwm = tourism_int), absorb(isocode y) robust
  7.     local biv = _b[ln_gaci_cwm]
  8.     local siv = _se[ln_gaci_cwm]
  9.     local nn = e(N)
 10.     local ub0 = `biv' + 1.959964*`siv'
 11. 
.     * ---- UCI bounds at benchmark gmax = f% of the reduced form ----
.     foreach f in 10 20 30 {
 12.         local g = (`f'/100)*`rfc'
 13.         capture drop ytil
 14.         gen ytil = `yv' - `g'*tourism_int
 15.         quietly ivreghdfe ytil lnpop (ln_gaci_cwm = tourism_int), absorb(isocode y) robust
 16.         local lb`f' = _b[ln_gaci_cwm] - 1.959964*_se[ln_gaci_cwm]
 17.         local ub`f' = `ub0'
 18.         drop ytil
 19.         di "  gmax = `f'% of RF: UCI = [" %9.3f `lb`f'' ", " %9.3f `ub`f'' "]"
 20.     }
 21. 
.     * ---- breakdown fraction f* ----
.     local fstar = 0
 22.     local f = 0
 23.     local go = 1
 24.     while `go' {
 25.         local f = `f' + 0.01
 26.         if `f' > 2.001 {
 27.             local go = 0
 28.         }
 29.         else {
 30.             local g = `f'*`rfc'
 31.             capture drop ytil
 32.             gen ytil = `yv' - `g'*tourism_int
 33.             quietly ivreghdfe ytil lnpop (ln_gaci_cwm = tourism_int), absorb(isocode y) robust
 34.             local lbf = _b[ln_gaci_cwm] - 1.959964*_se[ln_gaci_cwm]
 35.             drop ytil
 36.             if `lbf' > 0 {
 37.                 local fstar = `f'
 38.             }
 39.             else {
 40.                 local go = 0
 41.             }
 42.         }
 43.     }
 44.     di "  breakdown fraction f* = " %6.2f `fstar'
 45. 
.     post `R' ("`yv'") (`biv') (`siv') (`rfc') (`rfs') (`lb10') (`ub10') (`lb20') (`ub20') (`lb30') (`ub30') (`fstar') (`nn')
 46. }

