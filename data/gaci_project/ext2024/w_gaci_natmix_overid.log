. * ---- (2) HETEROGENEITY: interaction IV with separate instruments (over-ID) ----
. capture program drop _hxj

. program define _hxj
  1.     args modvar modname
  2.     foreach yv in g_int g_vol g_shr lnpc lngdp {
  3.         capture drop cwm_m zn_m zx_m
  4.         gen double cwm_m = ln_gaci_cwm * `modvar'
  5.         gen double zn_m  = z_nat * `modvar'
  6.         gen double zx_m  = z_mix * `modvar'
  7.         capture noisily ivreghdfe `yv' lnpop (ln_gaci_cwm cwm_m = z_nat z_mix zn_m zx_m), absorb(isocode y) robust
  8.         if _rc==0 {
  9.             local F=e(widstat)
 10.             local Jp=.
 11.             if !missing(e(j)) & e(jdf)>0  local Jp=chi2tail(e(jdf),e(j))
 12.             local bm=_b[ln_gaci_cwm]
 13.             local sm=_se[ln_gaci_cwm]
 14.             local pm=2*ttail(e(df_r),abs(`bm'/`sm'))
 15.             local bi=_b[cwm_m]
 16.             local si=_se[cwm_m]
 17.             local pi=2*ttail(e(df_r),abs(`bi'/`si'))
 18.             noisily di "HNM|`modname'|`yv'|main|`bm'|`sm'|`pm'|`F'|`Jp'|" e(N)
 19.             noisily di "HNM|`modname'|`yv'|inter|`bi'|`si'|`pi'|`F'|`Jp'|" e(N)
 20.         }
 21.         else noisily di "HNM|`modname'|`yv'|FAIL|.|.|.|.|.|."
 22.         capture drop cwm_m zn_m zx_m
 23.     }
 24. end

. di _n "############ HETEROGENEITY (over-ID interaction) ############"

############ HETEROGENEITY (over-ID interaction) ############

. _hxj inc_c   income
