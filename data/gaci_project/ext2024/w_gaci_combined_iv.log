. encode c, gen(isocode)

. xtset isocode y

Panel variable: isocode (unbalanced)
 Time variable: y, 1996 to 2024, but with gaps
         Delta: 1 unit

. 
. gen g_int = merch_intensity                 // ln(goods/GDP)  = openness (MAIN)

. gen g_shr = merch_share

. gen g_vol = merch_intensity + lngdp

. 
. capture which ivreghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
.     ssc install ivreghdfe, replace
. }

. 
. capture program drop _ci

. program define _ci
  1.     syntax, yv(string) insts(string) tag(string) sample(string)
  2.     capture noisily ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = `insts') if `sample', absorb(isocode y) robust
  3.     if _rc==0 {
  4.         local b  = _b[ln_gaci_cwm]
  5.         local se = _se[ln_gaci_cwm]
  6.         local p  = 2*ttail(e(df_r), abs(`b'/`se'))
  7.         local Jp = .
  8.         if !missing(e(j)) & e(jdf)>0  local Jp = chi2tail(e(jdf), e(j))
  9.         noisily di "COMB|`tag'|`yv'|`b'|`se'|`p'|" e(widstat) "|" e(j) "|`Jp'|" e(N)
 10.     }
 11.     else noisily di "COMB|`tag'|`yv'|FAIL|.|.|.|.|.|."
 12. end

. 
. foreach yv in g_int g_vol g_shr lnpc lngdp {
  2.     _ci, yv(`yv') insts(tourism_int)             tag(tour)   sample(1==1)
  3.     _ci, yv(`yv') insts(feyrer_int)              tag(feyr)   sample(1==1)
  4.     _ci, yv(`yv') insts(tourism_int feyrer_int)  tag(both)   sample(1==1)
  5.     _ci, yv(`yv') insts(tourism_int feyrer_int)  tag(both19) sample(y<=2019)
  6. }
