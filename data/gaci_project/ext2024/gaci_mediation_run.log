. 
. * =====================================================================
. * steps (1)+(3) per outcome x sample; collect mediated shares
. * =====================================================================
. foreach s in sfull sdrop {
  2.     foreach yv in g_int g_vol {
  3. 
.         * (1) total effect
.         ivreghdfe `yv' lnpop (`tr' = tourism_int) if `s', absorb(isocode y) robust
  4.         eststo tot_`yv'_`s'
  5.         estadd scalar KPF = e(widstat)
  6.         scalar bt_`yv'_`s' = _b[`tr']
  7. 
.         * (3) direct effects: mediator(s) as controls, T still instrumented
.         ivreghdfe `yv' lnpop r_bec (`tr' = tourism_int) if `s', absorb(isocode y) robust
  8.         eststo d1_`yv'_`s'
  9.         estadd scalar KPF = e(widstat)
 10.         scalar b1_`yv'_`s' = _b[`tr']
 11.         estadd scalar MSHARE = 100*(1 - b1_`yv'_`s'/bt_`yv'_`s')
 12. 
.         ivreghdfe `yv' lnpop r_vw (`tr' = tourism_int) if `s', absorb(isocode y) robust
 13.         eststo d2_`yv'_`s'
 14.         estadd scalar KPF = e(widstat)
 15.         scalar b2_`yv'_`s' = _b[`tr']
 16.         estadd scalar MSHARE = 100*(1 - b2_`yv'_`s'/bt_`yv'_`s')
 17. 
.         ivreghdfe `yv' lnpop r_bec r_vw (`tr' = tourism_int) if `s', absorb(isocode y) robust
 18.         eststo d3_`yv'_`s'
 19.         estadd scalar KPF = e(widstat)
 20.         scalar b3_`yv'_`s' = _b[`tr']
 21.         estadd scalar MSHARE = 100*(1 - b3_`yv'_`s'/bt_`yv'_`s')
 22.     }
 23. }
