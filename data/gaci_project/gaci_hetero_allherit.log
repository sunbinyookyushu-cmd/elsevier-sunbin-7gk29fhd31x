. capture program drop _hx

. program define _hx
  1.     args modvar modname
  2.     foreach yv in g_int g_vol g_shr lnpc lngdp {
  3.         capture drop cwm_m z_m
  4.         gen double cwm_m = ln_gaci_cwm * `modvar'
  5.         gen double z_m   = tourism_all  * `modvar'
  6.         capture noisily ivreghdfe `yv' lnpop (ln_gaci_cwm cwm_m = tourism_all z_m), absorb(isocode y) robust
  7.         if _rc==0 {
  8.             local F=e(widstat)
  9.             local bm=_b[ln_gaci_cwm]
 10.             local sm=_se[ln_gaci_cwm]
 11.             local pm=2*ttail(e(df_r),abs(`bm'/`sm'))
 12.             local bi=_b[cwm_m]
 13.             local si=_se[cwm_m]
 14.             local pi=2*ttail(e(df_r),abs(`bi'/`si'))
 15.             noisily di "HETA|`modname'|`yv'|main|`bm'|`sm'|`pm'|`F'|" e(N)
 16.             noisily di "HETA|`modname'|`yv'|inter|`bi'|`si'|`pi'|`F'|" e(N)
 17.         }
 18.         else noisily di "HETA|`modname'|`yv'|FAIL|.|.|.|.|."
 19.         capture drop cwm_m z_m
 20.     }
 21. end

. 
. di _n "############ remoteness ############"

############ remoteness ############

. _hx rem_c remote
