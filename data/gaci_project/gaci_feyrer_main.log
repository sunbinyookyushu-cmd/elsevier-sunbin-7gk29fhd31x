. do gaci_feyrer_main.do 

. *============================================================================
> ==
. * gaci_feyrer_main.do  --  MAIN results: OLS + IV (ivreghdfe), 3 trade outcom
> es
. *   spec       : COUNTRY+YEAR FE (absorb isocode y), robust SE
. *   treatment  : lng (GACI_sum) and ln_gaci_cwm (hub quality)
. *   instrument : feyrer_int = a_t * ln(air_MA_1996)   [Feyrer air-vs-sea, sur
> vives FE]
. *   control    : ln_sea_ma (maritime channel; +lngdp for the volume outcome)
. *   outcomes   : trade_share (% openness) | trade_intensity ln(trade/GDP) | l
> n_tradevol
. *   diagnostic : ivreghdfe 'first' -> Kleibergen-Paap first-stage F = e(widst
> at)
. *   each model prints a PAPER line: IV beta / SE / p-value / KP first-stage F
>  / OLS / N
. *============================================================================
> ==
. clear all

. set more off

. version 14

. cd "C:/Users/sunbi/managi-lab Dropbox/Sunbin Yoo/Research Box ^-^/2026/GACI"
C:\Users\sunbi\managi-lab Dropbox\Sunbin Yoo\Research Box ^-^\2026\GACI

. import delimited "gaci_panel_feyrer.csv", clear varnames(1) encoding("utf-8")
(40 vars, 4,714 obs)

. ds c reg, not
y             gaci_cwmean   lnpop         close_sum     ln_air_ma
trade_share   gaci_mean     lnland        close_mean    ln_sea_ma
ln_tradevol   ln_unesco     abslat        betw_sum      ln_feyrer
lngdp         unesco_cum    n_air         betw_mean     a_t
lng           unesco_cum~t  deg_sum       regimp_sum    feyrer_int
ln_gaci_cwm   lnz           deg_mean      regimp_mean   adv_int
ln_gaci_mean  lnz_own       eig_sum       cap_sum
lncap         lnpc          eig_mean      cap_mean

. destring `r(varlist)', replace force
y already numeric; no replace
trade_share already numeric; no replace
ln_tradevol already numeric; no replace
lngdp already numeric; no replace
lng already numeric; no replace
ln_gaci_cwm already numeric; no replace
ln_gaci_mean already numeric; no replace
lncap already numeric; no replace
gaci_cwmean already numeric; no replace
gaci_mean already numeric; no replace
ln_unesco already numeric; no replace
unesco_cum already numeric; no replace
unesco_cum_nat already numeric; no replace
lnz already numeric; no replace
lnz_own already numeric; no replace
lnpc already numeric; no replace
lnpop already numeric; no replace
lnland already numeric; no replace
abslat already numeric; no replace
n_air already numeric; no replace
deg_sum already numeric; no replace
deg_mean already numeric; no replace
eig_sum already numeric; no replace
eig_mean already numeric; no replace
close_sum already numeric; no replace
close_mean already numeric; no replace
betw_sum already numeric; no replace
betw_mean already numeric; no replace
regimp_sum already numeric; no replace
regimp_mean already numeric; no replace
cap_sum already numeric; no replace
cap_mean already numeric; no replace
ln_air_ma already numeric; no replace
ln_sea_ma already numeric; no replace
ln_feyrer already numeric; no replace
a_t already numeric; no replace
feyrer_int already numeric; no replace
adv_int already numeric; no replace

. encode c, gen(isocode)

. encode reg, gen(regcode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. gen trade_intensity = ln_tradevol - lngdp

. label var lng         "ln GACI_sum"

. label var ln_gaci_cwm "ln cap-wtd-mean GACI (hub quality)"

. label var feyrer_int  "Feyrer air/sea x a_t (IV)"

. label var ln_sea_ma   "ln sea market access (control)"

. 
. capture which ivreghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
.     ssc install ivreghdfe, replace
. }

. 
. *============================================================================
> ==
. * TREATMENT = lng (GACI_sum)
. *============================================================================
> ==
. di _n "==================== trade_share  <-  lng ===================="

