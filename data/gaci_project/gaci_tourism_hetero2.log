. capture program drop _hc

. program define _hc
  1.     args lbl cond
  2.     foreach yv in g_vol g_int g_shr lnpc lngdp {
  3.         capture noisily quietly ivreghdfe `yv' lnpop (ln_gaci_cwm = tourism_int) if `cond', absorb(isocode y) robust
  4.         if _rc == 0 {
  5.             local b  = _b[ln_gaci_cwm]
  6.             local se = _se[ln_gaci_cwm]
  7.             local p  = 2*ttail(e(df_r), abs(`b'/`se'))
  8.             noisily di "RES2|" "`yv'" "|" "`lbl'" "|" `b' "|" `se' "|" `p' "|" e(widstat) "|" e(N)
  9.         }
 10.         else noisily di "RES2|`yv'|`lbl'|FAIL|.|.|.|."
 11.     }
 12. end

