. encode c, gen(isocode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. 
. gen g_int = merch_intensity

. 
. capture which reghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
. }

. 
. * ---- baseline (1996) moderators ----
. gen tmp = lnpc if y==1996
(4,493 missing values generated)

. bysort isocode: egen base_lnpc = max(tmp)
(522 missing values generated)

. drop tmp

. gen tmp = ln_gaci_cwm if y==1996
(4,493 missing values generated)

. bysort isocode: egen base_cwm = max(tmp)
(522 missing values generated)

. drop tmp

. 
. * ---- country-level quintiles over the estimation sample ----
. gen byte insamp = !missing(g_int) & !missing(lnpop) & !missing(tourism_int)

. preserve

. keep if insamp
(0 observations deleted)

. collapse (first) base_lnpc base_cwm ln_remote, by(isocode)

. xtile q_inc = base_lnpc, nq(5)

. xtile q_con = base_cwm, nq(5)

. xtile q_rem = ln_remote, nq(5)

. tempfile qq

. save `qq'
file C:\Users\sunbi\AppData\Local\Temp\ST_8574_000002.tmp saved

. restore

. merge m:1 isocode using `qq', nogen keepusing(q_inc q_con q_rem)
(label isocode already defined)

    Result                           # of obs.
    -----------------------------------------
    not matched                             0
    matched                             4,643  
    -----------------------------------------

. 
. tempname R

. postfile `R' str8 mod byte bin double(b se) long(nn) using "_rf_tmp", replace
(note: file _rf_tmp.dta not found)

. 
. foreach m in inc con rem {
  2.     di _n "==================== MODERATOR: `m' ===================="
  3.     reghdfe g_int ibn.q_`m'#c.tourism_int lnpop, absorb(isocode y) vce(robust)
  4.     local nn = e(N)
  5.     forvalues k = 1/5 {
  6.         local bb = _b[`k'.q_`m'#c.tourism_int]
  7.         local sse = _se[`k'.q_`m'#c.tourism_int]
  8.         di "  Q`k': b = " %9.4f `bb' "  se = " %9.4f `sse'
  9.         post `R' ("`m'") (`k') (`bb') (`sse') (`nn')
 10.     }
 11. }

