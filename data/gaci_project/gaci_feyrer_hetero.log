. *----------------------------------------------------------------------------
> --
. * program: run all 3 outcomes within one subgroup, emit RESULT lines (with p-
> value)
. *----------------------------------------------------------------------------
> --
. capture program drop _hcell

. program define _hcell
  1.     args lbl cond
  2.     foreach yv in trade_share trade_intensity ln_tradevol {
  3.         local extra ""
  4.         if "`yv'" == "ln_tradevol" local extra "lngdp"
  5.         capture noisily ivreghdfe `yv' lnpop ln_sea_ma `extra' (lng = feyr
> er_int) ///
>             if `cond', absorb(isocode y) robust
  6.         if _rc == 0 {
  7.             local b  = _b[lng]
  8.             local se = _se[lng]
  9.             local p  = 2*ttail(e(df_r), abs(`b'/`se'))
 10.             local F  = e(widstat)
 11.             di as txt "RESULT | " %-16s "`yv'" " | " %-12s "`lbl'" " | b="
>  as res %9.4f `b' ///
>                as txt " se=" as res %9.4f `se' as txt " p=" as res %6.4f `p' 
> ///
>                as txt " | KP-firstF=" as res %8.2f `F' as txt " N=" as res e(
> N)
 12.         }
 13.         else di as err "RESULT | `yv' | `lbl' | FAILED rc=" _rc
 14.     }
 15. end

. 
. di _n "############### 1) AVIATION ADVANTAGE (adv_base median split) ########
> #######"

