. 
. di _n "######## also: treatment = hub quality (cwm) with sea_int ########"

######## also: treatment = hub quality (cwm) with sea_int ########

. foreach yv in trade_share trade_intensity ln_tradevol {
  2.     local extra ""
  3.     if "`yv'" == "ln_tradevol" local extra "lngdp"
  4.     capture noisily quietly ivreghdfe `yv' lnpop `extra' sea_int (ln_gaci_cwm = feyrer_int), absorb(isocode y) robust
  5.     if _rc == 0 {
  6.         noisily di "RESB|exo_cwm|`yv'|" _b[ln_gaci_cwm] "|" _se[ln_gaci_cwm] "|" 2*ttail(e(df_r), abs(_b[ln_gaci_cwm]/_se[ln_gaci_cwm])) "|" e(widstat) "|" e(N)
  7.     }
  8. }
