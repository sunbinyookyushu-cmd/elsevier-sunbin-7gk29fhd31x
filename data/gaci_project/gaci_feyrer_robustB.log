. do gaci_feyrer_robustB.do 

. *============================================================================
> ==
. * gaci_feyrer_robustB.do  --  Robustness B: EXOGENOUS (Bartik) maritime contr
> ol
. *   Concern (co-author): contemporaneous MA_sea (ln_sea_ma) is a "bad control
> "
. *     (endogenous, correlated with eps); since Z shares geography with sea ac
> cess,
. *     conditioning on an endogenous MA_sea does not purge the maritime->trade
>  path
. *     and can break the exclusion restriction.
. *   Fix B: replace ln_sea_ma with an EXOGENOUS maritime Bartik control
. *     sea_int = a_t * ln(sea_MA_1996)  = feyrer_int - adv_int   (no time-vary
> ing foreign pop)
. *   Test: does the instrument feyrer_int still identify (KP F) and does beta 
> survive,
. *         once the maritime channel is absorbed by an exogenous control?
. *============================================================================
> ==
. clear all

. set more off

. set linesize 255

. version 14

. cd "C:/Users/sunbi/managi-lab Dropbox/Sunbin Yoo/Research Box ^-^/2026/GACI"
C:\Users\sunbi\managi-lab Dropbox\Sunbin Yoo\Research Box ^-^\2026\GACI

. import delimited "gaci_panel_feyrer.csv", clear varnames(1) encoding("utf-8")
(40 vars, 4,714 obs)

. ds c reg, not
y             lngdp         ln_gaci_mean  gaci_mean     unesco_cum~t  lnpc          abslat        deg_mean      close_sum     betw_mean     cap_sum       ln_sea_ma     feyrer_int
trade_share   lng           lncap         ln_unesco     lnz           lnpop         n_air         eig_sum       close_mean    regimp_sum    cap_mean      ln_feyrer     adv_int
ln_tradevol   ln_gaci_cwm   gaci_cwmean   unesco_cum    lnz_own       lnland        deg_sum       eig_mean      betw_sum      regimp_mean   ln_air_ma     a_t

. destring `r(varlist)', replace force
y already numeric; no replace
trade_share already numeric; no replace
ln_tradevol already numeric; no replace
lngdp already numeric; no replace
lng already numeric; no replace
ln_gaci_cwm already numeric; no replace
ln_gaci_mean already numeric; no replace
lncap already numeric; no replace
gaci_cwmean already numeric; no replace
gaci_mean already numeric; no replace
ln_unesco already numeric; no replace
unesco_cum already numeric; no replace
unesco_cum_nat already numeric; no replace
lnz already numeric; no replace
lnz_own already numeric; no replace
lnpc already numeric; no replace
lnpop already numeric; no replace
lnland already numeric; no replace
abslat already numeric; no replace
n_air already numeric; no replace
deg_sum already numeric; no replace
deg_mean already numeric; no replace
eig_sum already numeric; no replace
eig_mean already numeric; no replace
close_sum already numeric; no replace
close_mean already numeric; no replace
betw_sum already numeric; no replace
betw_mean already numeric; no replace
regimp_sum already numeric; no replace
regimp_mean already numeric; no replace
cap_sum already numeric; no replace
cap_mean already numeric; no replace
ln_air_ma already numeric; no replace
ln_sea_ma already numeric; no replace
ln_feyrer already numeric; no replace
a_t already numeric; no replace
feyrer_int already numeric; no replace
adv_int already numeric; no replace

. encode c, gen(isocode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. gen trade_intensity = ln_tradevol - lngdp

. 
. * exogenous maritime Bartik control = a_t * ln(sea_MA_1996)
. gen sea_int = feyrer_int - adv_int
(12 missing values generated)

. label var sea_int   "a_t x ln(sea MA 1996), exogenous maritime control"

. label var feyrer_int "a_t x ln(air MA 1996), instrument"

. 
. di _n "==== how much independent variation? correlations ===="

==== how much independent variation? correlations ====

. pwcorr feyrer_int sea_int ln_sea_ma, obs

             | feyrer~t  sea_int ln_sea~a
-------------+---------------------------
  feyrer_int |   1.0000 
             |     4702
             |
     sea_int |   0.9997   1.0000 
             |     4702     4702
             |
   ln_sea_ma |   0.2403   0.2460   1.0000 
             |     4702     4702     4702
             |

. 
. capture program drop _runB

. program define _runB
  1.     args lbl ctrl
  2.     foreach yv in trade_share trade_intensity ln_tradevol {
  3.         local extra ""
  4.         if "`yv'" == "ln_tradevol" local extra "lngdp"
  5.         capture noisily quietly ivreghdfe `yv' lnpop `extra' `ctrl' (lng = feyrer_int), absorb(isocode y) robust
  6.         if _rc == 0 {
  7.             noisily di "RESB|`lbl'|`yv'|" _b[lng] "|" _se[lng] "|" 2*ttail(e(df_r), abs(_b[lng]/_se[lng])) "|" e(widstat) "|" e(N)
  8.         }
  9.     }
 10. end

. 
. di _n "######## B1: control = sea_int (EXOGENOUS Bartik) -- the fix ########"

######## B1: control = sea_int (EXOGENOUS Bartik) -- the fix ########

. _runB exo_seaint "sea_int"
