. * =====================================================================
. * A) subperiod first stages
. * =====================================================================
. tempname S

. postfile `S' str24 samp double(b se t pF) long(nn) using "_fs_tmp", replace
(note: file _fs_tmp.dta not found)

. 
. local cond1 "1"

. local lab1  "full_1996-2023"

. local cond2 "y < 2006"

. local lab2  "1996-2005"

. local cond3 "y >= 2006"

. local lab3  "2006-2023"

. local cond4 "y >= 2006 & y != 2008 & y != 2009"

. local lab4  "2006-2023_exGFC"

. local cond5 "y < 2010"

. local lab5  "1996-2009"

. local cond6 "y >= 2010"

. local lab6  "2010-2023"

. local cond7 "y >= 2010 & y != 2020 & y != 2021"

. local lab7  "2010-2023_exCOVID"

. 
. forvalues i = 1/7 {
  2.     quietly reghdfe ln_gaci_cwm feyrer_int lnpop ln_sea_ma if `cond`i'', absorb(isocode y) vce(robust)
  3.     local bb = _b[feyrer_int]
  4.     local ss = _se[feyrer_int]
  5.     quietly test feyrer_int
  6.     di "FS `lab`i'': b=" %8.4f `bb' " se=" %7.4f `ss' " t=" %6.2f `bb'/`ss' " F=" %8.1f r(F) " N=" e(N)
  7.     post `S' ("`lab`i''") (`bb') (`ss') (`bb'/`ss') (r(F)) (e(N))
  8. }
