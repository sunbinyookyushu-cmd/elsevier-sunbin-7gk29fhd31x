. * =====================================================================
. * B) year-specific first-stage slopes (base year 1996)
. * =====================================================================
. quietly reghdfe ln_gaci_cwm c.feyrer_int#ib1996.y lnpop ln_sea_ma, absorb(isocode y) vce(robust)

. tempname Y

. postfile `Y' int y double(b se) using "_fsy_tmp", replace
(note: file _fsy_tmp.dta not found)

. forvalues t = 1996/2023 {
  2.     if `t' == 1996 {
  3.         post `Y' (1996) (0) (0)
  4.     }
  5.     else {
  6.         capture local bb = _b[c.feyrer_int#`t'.y]
  7.         capture local ss = _se[c.feyrer_int#`t'.y]
  8.         di "FSYEAR `t': b_rel1996=" %8.4f `bb' " se=" %7.4f `ss'
  9.         post `Y' (`t') (`bb') (`ss')
 10.     }
 11. }
