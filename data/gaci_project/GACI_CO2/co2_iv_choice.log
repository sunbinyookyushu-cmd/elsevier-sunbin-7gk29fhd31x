. tempname R

. postfile `R' str4 iv str24 item str18 outc double(b se p f) long(nn) using "_ivc_tmp", replace
(note: file _ivc_tmp.dta not found)

. global RH `R'

. program define pst
  1.     args iv item outc v f
  2.     local bb = _b[`v']
  3.     local sse = _se[`v']
  4.     post $RH ("`iv'") ("`item'") ("`outc'") (`bb') (`sse') (2*normal(-abs(`bb'/`sse'))) (`f') (e(N))
  5.     di "IVC [`iv'] `item' `outc': b = " %9.3f `bb' " (se " %8.3f `sse' ")  F = " %7.1f `f' "  N = " %6.0f e(N)
  6. end

. 
. foreach IV in A B C {
  2.     if "`IV'" == "A" {
  3.         local z "feyrer_int"
  4.         local ctl "lnpop ln_sea_ma"
  5.     }
  6.     if "`IV'" == "B" {
  7.         local z "adv_int"
  8.         local ctl "lnpop ln_sea_ma"
  9.     }
 10.     if "`IV'" == "C" {
 11.         local z "feyrer_int"
 12.         local ctl "lnpop ln_sea_ma fey_sea"
 13.     }
 14.     di _n "=============== IV `IV': z = `z' ; controls = `ctl' ==============="
 15.     * first stage
.     reghdfe ln_gaci_cwm `z' `ctl', absorb(isocode y) vce(cluster isocode)
 16.     test `z'
 17.     pst `IV' firststage ln_gaci_cwm `z' r(F)
 18.     * 2SLS main outcomes
.     foreach yv in ln_co2_tot ln_skm ln_intensity {
 19.         ivreghdfe `yv' `ctl' (ln_gaci_cwm = `z'), absorb(isocode y) cluster(isocode)
 20.         pst `IV' iv `yv' ln_gaci_cwm e(widstat)
 21.     }
 22.     * placebo outcomes (reduced form)
.     foreach yv in ln_co2_exav ln_coal ln_cement ln_ed_power ln_ed_transp_exav {
 23.         capture noisily reghdfe `yv' `z' `ctl', absorb(isocode y) vce(cluster isocode)
 24.         if _rc == 0 pst `IV' rf_placebo `yv' `z' .
 25.     }
 26.     reghdfe ln_co2_tot `z' `ctl', absorb(isocode y) vce(cluster isocode)
 27.     pst `IV' rf_aviation ln_co2_tot `z' .
 28.     * horse race: world GDP x own geography of the instrument
.     if "`IV'" == "B" {
 29.         capture gen adv_gdp = g_gdp * (ln_air96 - ln_sea96)
 30.         reghdfe ln_gaci_cwm `z' adv_gdp `ctl', absorb(isocode y) vce(cluster isocode)
 31.         test `z'
 32.         pst `IV' fs_plus_gdpcycle ln_gaci_cwm `z' r(F)
 33.         capture noisily ivreghdfe ln_co2_tot `ctl' adv_gdp (ln_gaci_cwm = `z'), absorb(isocode y) cluster(isocode)
 34.         if _rc == 0 pst `IV' iv_plus_gdpcycle ln_co2_tot ln_gaci_cwm e(widstat)
 35.         reghdfe ln_gaci_cwm `z' fey_oil `ctl', absorb(isocode y) vce(cluster isocode)
 36.         test `z'
 37.         pst `IV' fs_plus_oilcycle ln_gaci_cwm `z' r(F)
 38.     }
 39.     else {
 40.         reghdfe ln_gaci_cwm `z' fey_gdp `ctl', absorb(isocode y) vce(cluster isocode)
 41.         test `z'
 42.         pst `IV' fs_plus_gdpcycle ln_gaci_cwm `z' r(F)
 43.         capture noisily ivreghdfe ln_co2_tot `ctl' fey_gdp (ln_gaci_cwm = `z'), absorb(isocode y) cluster(isocode)
 44.         if _rc == 0 pst `IV' iv_plus_gdpcycle ln_co2_tot ln_gaci_cwm e(widstat)
 45.         reghdfe ln_gaci_cwm `z' fey_oil `ctl', absorb(isocode y) vce(cluster isocode)
 46.         test `z'
 47.         pst `IV' fs_plus_oilcycle ln_gaci_cwm `z' r(F)
 48.     }
 49.     * world GDP x SEA geography as a general-growth control (for A and B)
.     capture noisily ivreghdfe ln_co2_tot `ctl' fey_gdp_sea (ln_gaci_cwm = `z'), absorb(isocode y) cluster(isocode)
 50.     if _rc == 0 pst `IV' iv_plus_gdp_x_sea ln_co2_tot ln_gaci_cwm e(widstat)
 51.     * zero first stage: top tercile
.     reghdfe ln_gaci_cwm `z' `ctl' if con3 == 3, absorb(isocode y) vce(cluster isocode)
 52.     test `z'
 53.     pst `IV' zfs_firststage_top ln_gaci_cwm `z' r(F)
 54.     reghdfe ln_co2_tot `z' `ctl' if con3 == 3, absorb(isocode y) vce(cluster isocode)
 55.     pst `IV' zfs_rf_top ln_co2_tot `z' .
 56.     * overid with lagged fatal accidents
.     capture noisily ivreghdfe ln_co2_tot `ctl' (ln_gaci_cwm = `z' lag_fatal), absorb(isocode y) cluster(isocode)
 57.     if _rc == 0 {
 58.         pst `IV' overid_accident ln_co2_tot ln_gaci_cwm e(widstat)
 59.         post $RH ("`IV'") ("hansen_p_accident") ("ln_co2_tot") (e(j)) (.) (e(jp)) (.) (e(N))
 60.         di "IVC [`IV'] Hansen J with accidents = " %6.2f e(j) "  p = " %5.3f e(jp)
 61.     }
 62.     * controls end-point
.     capture noisily ivreghdfe ln_co2_tot `ctl' lngdp trade_gdp urban fdi (ln_gaci_cwm = `z'), absorb(isocode y) cluster(isocode)
 63.     if _rc == 0 pst `IV' iv_with_controls ln_co2_tot ln_gaci_cwm e(widstat)
 64.     * post-2010 excluding COVID
.     capture noisily ivreghdfe ln_co2_tot `ctl' (ln_gaci_cwm = `z') if y >= 2010 & !inlist(y, 2020, 2021), absorb(isocode y) cluster(isocode)
 65.     if _rc == 0 pst `IV' iv_post2010_excovid ln_co2_tot ln_gaci_cwm e(widstat)
 66. }

