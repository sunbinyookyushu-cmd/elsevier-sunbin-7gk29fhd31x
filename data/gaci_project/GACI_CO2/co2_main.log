.     ssc install estout, replace
. }

. 
. eststo clear

. 
. * =====================================================================
. * PANEL A: headline treatment ln_gaci_cwm, all outcomes, OLS + 2SLS
. * =====================================================================
. local outcomes ln_co2_bunker ln_co2_lto ln_co2_5050 ln_co2_bunker_intl ln_seatkm ln_intensity

