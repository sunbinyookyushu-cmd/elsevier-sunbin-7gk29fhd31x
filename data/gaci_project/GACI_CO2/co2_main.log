. 
. foreach yv of local outcomes {
  2.     reghdfe `yv' ln_gaci_cwm lnpop, absorb(isocode y) vce(robust)
  3.     eststo ols_`yv'
  4.     ivreghdfe `yv' lnpop (ln_gaci_cwm = tourism_int), absorb(isocode y) robust
  5.     eststo iv_`yv'
  6.     estadd scalar KPF = e(widstat)
  7.     * H1 Wald: beta = 1
.     test ln_gaci_cwm = 1
  8.     estadd scalar Wald1p = r(p)
  9.     di "  `yv': 2SLS b = " %9.3f _b[ln_gaci_cwm] " (se " %9.3f _se[ln_gaci_cwm] ")  H1 Wald p(b=1) = " %6.3f r(p)
 10. }
