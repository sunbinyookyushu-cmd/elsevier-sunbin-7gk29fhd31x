. do co2_feyrer_intl.do 

. *============================================================================
> ==
. * co2_feyrer_intl.do
. * Decisive check: does the CO2 headline (ln intl bunker CO2) hold under the
. * Feyrer air/sea IV, which survives all size-x-cycle stress tests?
. *============================================================================
> ==
. clear all

. set more off

. set varabbrev off

. set linesize 255

. version 14

. cd "C:/Users/sunbi/managi-lab Dropbox/Sunbin Yoo/Research Box ^-^/2026/GACI/GACI_CO2"
C:\Users\sunbi\managi-lab Dropbox\Sunbin Yoo\Research Box ^-^\2026\GACI\GACI_CO2

. 
. import delimited "co2_country_year.csv", clear varnames(1) encoding("utf-8")
(20 vars, 6,107 obs)

. keep iso3 year co2_bunker co2_bunker_intl co2_lto dep_seat_km

. rename iso3 c

. rename year y

. tempfile co2

. save `co2'
file C:\Users\sunbi\AppData\Local\Temp\ST_8e0c_000001.tmp saved

. 
. import delimited "../gaci_panel_combined.csv", clear varnames(1) encoding("utf-8")
(44 vars, 4,643 obs)

. ds c reg, not
y             lngdp         ln_gaci_mean  gaci_mean     unesco_cum~t  lnpc          abslat        deg_mean      close_sum     betw_mean     cap_sum       nat_endow     tourism_int   feyrer_int
trade_share   lng           lncap         ln_unesco     lnz           lnpop         n_air         eig_sum       close_mean    regimp_sum    cap_mean      merch_share   tourism_cum   ln_sea_ma
ln_tradevol   ln_gaci_cwm   gaci_cwmean   unesco_cum    lnz_own       lnland        deg_sum       eig_mean      betw_sum      regimp_mean   tour_shift    merch_inte~y  ln_remote     ln_air_ma

. destring `r(varlist)', replace force
y already numeric; no replace
trade_share already numeric; no replace
ln_tradevol already numeric; no replace
lngdp already numeric; no replace
lng already numeric; no replace
ln_gaci_cwm already numeric; no replace
ln_gaci_mean already numeric; no replace
lncap already numeric; no replace
gaci_cwmean already numeric; no replace
gaci_mean already numeric; no replace
ln_unesco already numeric; no replace
unesco_cum already numeric; no replace
unesco_cum_nat already numeric; no replace
lnz already numeric; no replace
lnz_own already numeric; no replace
lnpc already numeric; no replace
lnpop already numeric; no replace
lnland already numeric; no replace
abslat already numeric; no replace
n_air already numeric; no replace
deg_sum already numeric; no replace
deg_mean already numeric; no replace
eig_sum already numeric; no replace
eig_mean already numeric; no replace
close_sum already numeric; no replace
close_mean already numeric; no replace
betw_sum already numeric; no replace
betw_mean already numeric; no replace
regimp_sum already numeric; no replace
regimp_mean already numeric; no replace
cap_sum already numeric; no replace
cap_mean already numeric; no replace
tour_shift already numeric; no replace
nat_endow already numeric; no replace
merch_share already numeric; no replace
merch_intensity already numeric; no replace
tourism_int already numeric; no replace
tourism_cum already numeric; no replace
ln_remote already numeric; no replace
feyrer_int already numeric; no replace
ln_sea_ma already numeric; no replace
ln_air_ma already numeric; no replace

. merge 1:1 c y using `co2', keep(1 3) nogenerate

    Result                           # of obs.
    -----------------------------------------
    not matched                             0
    matched                             4,643  
    -----------------------------------------

. encode c, gen(isocode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. 
. gen ln_co2_intl = ln(co2_bunker_intl) if co2_bunker_intl > 0
(1 missing value generated)

. gen ln_co2_tot = ln(co2_bunker) if co2_bunker > 0

. gen ln_intensity = ln(co2_bunker) - ln(dep_seat_km) if co2_bunker > 0 & dep_seat_km > 0

. 
. gen tmp = lngdp if y==1996
(4,493 missing values generated)

. bysort isocode: egen lngdp96 = max(tmp)
(522 missing values generated)

. drop tmp

. gen tmp = lnpop if y==1996
(4,493 missing values generated)

. bysort isocode: egen lnpop96 = max(tmp)
(522 missing values generated)

. drop tmp

. gen at_lngdp = tour_shift * lngdp96
(522 missing values generated)

. gen at_lnpop = tour_shift * lnpop96
(522 missing values generated)

. 
. capture which ivreghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
.     ssc install ivreghdfe, replace
. }

. 
. foreach yv in ln_co2_intl ln_co2_tot ln_intensity {
  2.     ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int), absorb(isocode y) robust
  3.     di "FEYCO2 `yv' baseline:      b = " %8.3f _b[ln_gaci_cwm] " (se " %7.3f _se[ln_gaci_cwm] ")  KP F = " %8.1f e(widstat) "  N = " %8.0f e(N)
  4.     ivreghdfe `yv' lnpop ln_sea_ma at_lnpop at_lngdp (ln_gaci_cwm = feyrer_int), absorb(isocode y) robust
  5.     di "FEYCO2 `yv' + size cycles: b = " %8.3f _b[ln_gaci_cwm] " (se " %7.3f _se[ln_gaci_cwm] ")  KP F = " %8.1f e(widstat) "  N = " %8.0f e(N)
  6. }
(dropped 1 singleton observations)
(MWFE estimator converged in 5 iterations)

