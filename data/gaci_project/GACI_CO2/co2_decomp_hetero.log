. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
.     ssc install ivreghdfe, replace
. }

. 
. * common samples per segment
. foreach S in tot intl dom {
  2.     gen byte ok_`S' = !missing(ln_co2_`S') & !missing(ln_flights_`S') & !missing(ln_gauge_`S') & !missing(ln_stage_`S') & !missing(ln_intensity_`S') & !missing(lnpop) & !missing(ln_sea_ma) & !missing(feyrer_int) & !missing(ln_gaci_cwm)
  3. }

. 
. tempname M

. postfile `M' str12 block str12 grp str6 seg str16 outc double(b se p kpf) long(nn) using "_decomp_tmp", replace
(note: file _decomp_tmp.dta not found)

. 
. program define runblock
  1.     args block grp seg cond
  2.     foreach comp in co2 flights gauge stage intensity {
  3.         quietly ivreghdfe ln_`comp'_`seg' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int) if ok_`seg' & (`cond'), absorb(isocode y) robust
  4.         local bb = _b[ln_gaci_cwm]
  5.         local sse = _se[ln_gaci_cwm]
  6.         local pp = 2*normal(-abs(`bb'/`sse'))
  7.         di "DECOMP `block' `grp' `seg' `comp': b = " %9.3f `bb' " (se " %8.3f `sse' ")  KP F = " %7.1f e(widstat) "  N = " %8.0f e(N)
  8.         post $MH ("`block'") ("`grp'") ("`seg'") ("ln_`comp'") (`bb') (`sse') (`pp') (e(widstat)) (e(N))
  9.     }
 10. end

. global MH `M'

