. encode c, gen(isocode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. 
. gen ln_co2_tot = ln(co2_bunker) if co2_bunker > 0

. gen ln_co2_intl = ln(co2_bunker_intl) if co2_bunker_intl > 0

. gen ln_skm = ln(dep_seat_km) if dep_seat_km > 0

. gen ln_intensity = ln_co2_tot - ln_skm

. 
. * =====================================================================
. * A) measures: cwm / sum / max x 4 outcomes
. * =====================================================================
. tempname M

. postfile `M' str16 meas str16 outc double(b se p kpf) long(nn) using "_meas_tmp", replace
(note: file _meas_tmp.dta not found)

. foreach tr in ln_gaci_cwm lng ln_gaci_max {
  2.     foreach yv in ln_co2_tot ln_co2_intl ln_skm ln_intensity {
  3.         quietly ivreghdfe `yv' lnpop ln_sea_ma (`tr' = feyrer_int), absorb(isocode y) robust
  4.         local bb = _b[`tr']
  5.         local ss = _se[`tr']
  6.         local pp = 2*normal(-abs(`bb'/`ss'))
  7.         di "MEAS `tr' `yv': b = " %9.3f `bb' " (se " %8.3f `ss' ")  KP F = " %7.1f e(widstat) "  N = " %8.0f e(N)
  8.         post `M' ("`tr'") ("`yv'") (`bb') (`ss') (`pp') (e(widstat)) (e(N))
  9.     }
 10. }
MEAS ln_gaci_cwm ln_co2_tot: b =     5.347 (se    0.398)  KP F =   153.6  N =     4634
MEAS ln_gaci_cwm ln_co2_intl: b =     5.192 (se    0.386)  KP F =   153.6  N =     4634
MEAS ln_gaci_cwm ln_skm: b =     5.641 (se    0.425)  KP F =   153.6  N =     4634
MEAS ln_gaci_cwm ln_intensity: b =    -0.294 (se    0.116)  KP F =   153.6  N =     4634
MEAS lng ln_co2_tot: b =     2.153 (se    0.214)  KP F =    90.3  N =     4634
MEAS lng ln_co2_intl: b =     2.091 (se    0.219)  KP F =    90.3  N =     4634
MEAS lng ln_skm: b =     2.272 (se    0.237)  KP F =    90.3  N =     4634
MEAS lng ln_intensity: b =    -0.118 (se    0.050)  KP F =    90.3  N =     4634
MEAS ln_gaci_max ln_co2_tot: b =     4.548 (se    0.317)  KP F =   172.0  N =     4634
MEAS ln_gaci_max ln_co2_intl: b =     4.416 (se    0.317)  KP F =   172.0  N =     4634
MEAS ln_gaci_max ln_skm: b =     4.798 (se    0.344)  KP F =   172.0  N =     4634
MEAS ln_gaci_max ln_intensity: b =    -0.250 (se    0.099)  KP F =   172.0  N =     4634

. postclose `M'

. preserve

. use "_meas_tmp", clear

. export delimited "_feyrer_measures.csv", replace
file _feyrer_measures.csv saved

. restore

. erase "_meas_tmp.dta"

. 
. * =====================================================================
. * B) ASN accident IV
. * =====================================================================
. gen ash_deaths = asinh(deaths)

. gen ash_com_deaths = asinh(com_deaths)

. gen byte d_major = n_major > 0

. gen byte d_fatal = n_fatal > 0

. 
. tempname R

. postfile `R' str12 stage str16 z str16 outc double(b se p kpf jp) long(nn) using "_asn_tmp", replace
(note: file _asn_tmp.dta not found)

. 
. * ---- B1: first stage, lagged accident measures ----
. foreach z in ash_deaths ash_com_deaths n_fatal n_major d_major d_fatal {
  2.     quietly reghdfe ln_gaci_cwm L.`z' lnpop ln_sea_ma, absorb(isocode y) vce(robust)
  3.     local bb = _b[L.`z']
  4.     local ss = _se[L.`z']
  5.     local pp = 2*normal(-abs(`bb'/`ss'))
  6.     quietly test L.`z'
  7.     local ff = r(F)
  8.     di "FS L.`z': b = " %9.4f `bb' " (se " %8.4f `ss' ")  partial F = " %7.1f `ff' "  N = " %8.0f e(N)
  9.     post `R' ("FS_lag") ("L.`z'") ("ln_gaci_cwm") (`bb') (`ss') (`pp') (`ff') (.) (e(N))
 10. }
FS L.ash_deaths: b =    0.0016 (se   0.0011)  partial F =     2.0  N =     4446
FS L.ash_com_deaths: b =    0.0022 (se   0.0011)  partial F =     3.6  N =     4446
FS L.n_fatal: b =    0.0035 (se   0.0017)  partial F =     4.4  N =     4446
FS L.n_major: b =    0.0027 (se   0.0064)  partial F =     0.2  N =     4446
FS L.d_major: b =    0.0017 (se   0.0073)  partial F =     0.1  N =     4446
FS L.d_fatal: b =    0.0042 (se   0.0038)  partial F =     1.2  N =     4446

. * contemporaneous, for comparison (endogeneity check: sign should differ)
. foreach z in ash_deaths n_fatal {
  2.     quietly reghdfe ln_gaci_cwm `z' lnpop ln_sea_ma, absorb(isocode y) vce(robust)
  3.     local bb = _b[`z']
  4.     local ss = _se[`z']
  5.     local pp = 2*normal(-abs(`bb'/`ss'))
  6.     quietly test `z'
  7.     local ff = r(F)
  8.     di "FS contemp `z': b = " %9.4f `bb' " (se " %8.4f `ss' ")  partial F = " %7.1f `ff'
  9.     post `R' ("FS_contemp") ("`z'") ("ln_gaci_cwm") (`bb') (`ss') (`pp') (`ff') (.) (e(N))
 10. }
FS contemp ash_deaths: b =    0.0028 (se   0.0011)  partial F =     6.4
FS contemp n_fatal: b =    0.0063 (se   0.0016)  partial F =    15.6

. 
. * ---- B2: 2SLS with the strongest lagged accident IV(s), just-identified ----
. foreach z in ash_deaths n_fatal d_fatal {
  2.     foreach yv in ln_co2_tot ln_co2_intl ln_intensity {
  3.         capture noisily quietly ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = L.`z'), absorb(isocode y) robust
  4.         if _rc == 0 {
  5.             local bb = _b[ln_gaci_cwm]
  6.             local ss = _se[ln_gaci_cwm]
  7.             local pp = 2*normal(-abs(`bb'/`ss'))
  8.             di "IV L.`z' -> `yv': b = " %9.3f `bb' " (se " %8.3f `ss' ")  KP F = " %7.1f e(widstat)
  9.             post `R' ("IV_asn") ("L.`z'") ("`yv'") (`bb') (`ss') (`pp') (e(widstat)) (.) (e(N))
 10.         }
 11.     }
 12. }
IV L.ash_deaths -> ln_co2_tot: b =     5.262 (se    3.118)  KP F =     2.0
IV L.ash_deaths -> ln_co2_intl: b =     4.239 (se    2.799)  KP F =     2.0
IV L.ash_deaths -> ln_intensity: b =    -0.284 (se    0.989)  KP F =     2.0
IV L.n_fatal -> ln_co2_tot: b =     5.588 (se    2.246)  KP F =     4.4
IV L.n_fatal -> ln_co2_intl: b =     4.572 (se    1.805)  KP F =     4.4
IV L.n_fatal -> ln_intensity: b =    -0.922 (se    0.653)  KP F =     4.4
IV L.d_fatal -> ln_co2_tot: b =     6.045 (se    4.311)  KP F =     1.2
IV L.d_fatal -> ln_co2_intl: b =     5.340 (se    3.984)  KP F =     1.2
IV L.d_fatal -> ln_intensity: b =    -1.020 (se    1.490)  KP F =     1.2

. 
. * ---- B3: over-ID, feyrer_int + lagged accident IV jointly (Hansen J) ----
. foreach z in ash_deaths n_fatal {
  2.     foreach yv in ln_co2_tot ln_co2_intl ln_intensity {
  3.         capture noisily quietly ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int L.`z'), absorb(isocode y) robust
  4.         if _rc == 0 {
  5.             local bb = _b[ln_gaci_cwm]
  6.             local ss = _se[ln_gaci_cwm]
  7.             local pp = 2*normal(-abs(`bb'/`ss'))
  8.             local jp = e(jp)
  9.             di "OVERID feyrer+L.`z' -> `yv': b = " %9.3f `bb' "  KP F = " %7.1f e(widstat) "  Hansen J p = " %6.3f `jp'
 10.             post `R' ("OVERID") ("fey+L.`z'") ("`yv'") (`bb') (`ss') (`pp') (e(widstat)) (`jp') (e(N))
 11.         }
 12.     }
 13. }
OVERID feyrer+L.ash_deaths -> ln_co2_tot: b =     5.083  KP F =    66.3  Hansen J p =  0.952
OVERID feyrer+L.ash_deaths -> ln_co2_intl: b =     4.895  KP F =    66.3  Hansen J p =  0.820
OVERID feyrer+L.ash_deaths -> ln_intensity: b =    -0.331  KP F =    66.3  Hansen J p =  0.961
OVERID feyrer+L.n_fatal -> ln_co2_tot: b =     5.087  KP F =    66.8  Hansen J p =  0.805
OVERID feyrer+L.n_fatal -> ln_co2_intl: b =     4.897  KP F =    66.8  Hansen J p =  0.859
OVERID feyrer+L.n_fatal -> ln_intensity: b =    -0.339  KP F =    66.8  Hansen J p =  0.270

. 
. postclose `R'

. preserve

. use "_asn_tmp", clear

. list, clean

