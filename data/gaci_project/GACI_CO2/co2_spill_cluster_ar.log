. * =====================================================================
. * C) single-endogenous contig and knn5: AR CI by grid, cluster(isocode)
. * =====================================================================
. di _n "===== C) single-endogenous AR ====="

===== C) single-endogenous AR =====

. foreach W in contig knn5 b1 {
  2.     local hc ""
  3.     if inlist("`W'", "contig", "b1") local hc "has_`W'"
  4.     local lo = .
  5.     local hi = .
  6.     local prev = 0
  7.     forvalues b0 = -4(0.1)12 {
  8.         quietly gen yb = ln_co2_tot - `b0'*nbr_g_`W'
  9.         quietly reghdfe yb nbr_f_`W' feyrer_int lnpop ln_sea_ma `hc', absorb(isocode y) vce(cluster isocode)
 10.         quietly test nbr_f_`W'
 11.         local acc = r(p) > 0.05
 12.         if `acc' & `prev' == 0 local lo = `b0'
 13.         if `acc' local hi = `b0'
 14.         local prev = `acc'
 15.         drop yb
 16.     }
 17.     quietly ivreghdfe ln_co2_tot feyrer_int lnpop ln_sea_ma `hc' (nbr_g_`W' = nbr_f_`W'), absorb(isocode y) cluster(isocode)
 18.     postone C single_`W'_AR nbr_g_`W' e(widstat) . . `lo' `hi'
 19. }
