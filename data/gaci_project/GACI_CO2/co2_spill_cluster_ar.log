. 
. * =====================================================================
. * B) joint, clustered, with clustered SW F and subset AR grid for the neighbour term
. * =====================================================================
. di _n "===== B) joint, clustered ====="

===== B) joint, clustered =====

. foreach W in contig knn5 b1 {
  2.     local hc ""
  3.     if inlist("`W'", "contig", "b1") local hc "has_`W'"
  4.     capture noisily ivreghdfe ln_co2_tot lnpop ln_sea_ma `hc' (ln_gaci_cwm nbr_g_`W' = feyrer_int nbr_f_`W'), absorb(isocode y) cluster(isocode) ffirst
  5.     if _rc == 0 {
  6.         local kp = e(widstat)
  7.         local bn = _b[nbr_g_`W']
  8.         local swo = .
  9.         local swn = .
 10.         capture matrix FS = e(first)
 11.         if _rc == 0 {
 12.             local rn : rownames FS
 13.             local k = 1
 14.             foreach r of local rn {
 15.                 if "`r'" == "SWF" {
 16.                     local swo = FS[`k', 1]
 17.                     local swn = FS[`k', 2]
 18.                 }
 19.                 local k = `k' + 1
 20.             }
 21.         }
 22.         * subset AR for the neighbour coefficient: for each b0, y - b0*nbr_g is regressed
.         * with own still instrumented; test that the excluded neighbour instrument is zero
.         local lo = .
 23.         local hi = .
 24.         local prev = 0
 25.         forvalues b0 = -4(0.1)12 {
 26.             quietly gen yb = ln_co2_tot - `b0'*nbr_g_`W'
 27.             capture quietly ivreghdfe yb lnpop ln_sea_ma `hc' nbr_f_`W' (ln_gaci_cwm = feyrer_int), absorb(isocode y) cluster(isocode)
 28.             if _rc == 0 {
 29.                 quietly test nbr_f_`W'
 30.                 local acc = r(p) > 0.05
 31.                 if `acc' & `prev' == 0 local lo = `b0'
 32.                 if `acc' local hi = `b0'
 33.                 local prev = `acc'
 34.             }
 35.             drop yb
 36.         }
 37.         di "AR grid for `W': accepted b0 from " `lo' " to " `hi'
 38.         quietly ivreghdfe ln_co2_tot lnpop ln_sea_ma `hc' (ln_gaci_cwm nbr_g_`W' = feyrer_int nbr_f_`W'), absorb(isocode y) cluster(isocode)
 39.         postone B joint_`W'_isocode ln_gaci_cwm `kp' `swo' `swn' . .
 40.         postone B joint_`W'_isocode nbr_g_`W' `kp' `swo' `swn' `lo' `hi'
 41.     }
 42. }
