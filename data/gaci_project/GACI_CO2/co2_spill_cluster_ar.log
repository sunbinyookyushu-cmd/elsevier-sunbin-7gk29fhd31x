. encode c, gen(isocode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. gen ln_co2_tot = ln(co2_bunker) if co2_bunker > 0

. encode subregion, gen(srid)

. egen sry = group(srid y)
(8 missing values generated)

. 
. tempname R

. postfile `R' str10 panel str32 item str16 var double(b se p kpf swf_own swf_nbr ar_lo ar_hi) long(nn) using "_spar_tmp", replace
(note: file _spar_tmp.dta not found)

. global RH `R'

. program define postone
  1.     args panel item v kpf swo swn lo hi
  2.     local bb = _b[`v']
  3.     local sse = _se[`v']
  4.     local pp = 2*normal(-abs(`bb'/`sse'))
  5.     di "CLU [`panel'] `item' `v': b = " %8.3f `bb' " (se " %7.3f `sse' ")  KP F = " %7.1f `kpf' "  SWF own/nbr = " %6.1f `swo' " / " %6.1f `swn' "  AR = [" %6.2f `lo' ", " %6.2f `hi' "]  N = " %6.0f e(N)
  6.     post $RH ("`panel'") ("`item'") ("`v'") (`bb') (`sse') (`pp') (`kpf') (`swo') (`swn') (`lo') (`hi') (e(N))
  7. end

. 
. * =====================================================================
. * A) single-endogenous under clustering
. * =====================================================================
. di _n "===== A) single-endogenous, clustered ====="

===== A) single-endogenous, clustered =====

. foreach W in contig knn5 b1 k500 inv {
  2.     local hc ""
  3.     if inlist("`W'", "contig", "b1") local hc "has_`W'"
  4.     foreach cl in isocode srid {
  5.         capture noisily ivreghdfe ln_co2_tot feyrer_int lnpop ln_sea_ma `hc' (nbr_g_`W' = nbr_f_`W'), absorb(isocode y) cluster(`cl')
  6.         if _rc == 0 postone A single_`W'_`cl' nbr_g_`W' e(widstat) . . . .
  7.         capture noisily ivreghdfe ln_co2_tot feyrer_int lnpop ln_sea_ma `hc' (nbr_g_`W' = nbr_f_`W'), absorb(isocode sry) cluster(`cl')
  8.         if _rc == 0 postone A single_`W'_`cl'_rxy nbr_g_`W' e(widstat) . . . .
  9.     }
 10. }
