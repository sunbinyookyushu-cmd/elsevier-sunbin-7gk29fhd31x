. * =====================================================================
. * B) first-stage structural break: sup-Wald over candidate cutoffs
. * =====================================================================
. tempname B

. postfile `B' int cut double(wald pval b_z b_zpost) using "_brk_tmp", replace
(note: file _brk_tmp.dta not found)

. forvalues c = 2002/2019 {
  2.     gen byte post_c = (y >= `c')
  3.     gen z_post = feyrer_int * post_c
  4.     quietly reghdfe ln_gaci_cwm feyrer_int z_post lnpop ln_sea_ma, absorb(isocode y) vce(robust)
  5.     local bz = _b[feyrer_int]
  6.     local bzp = _b[z_post]
  7.     quietly test z_post
  8.     di "BREAK c=`c': W=" %8.2f r(F) " p=" %7.5f r(p) " b_z=" %7.3f `bz' " b_zpost=" %7.3f `bzp'
  9.     post `B' (`c') (r(F)) (r(p)) (`bz') (`bzp')
 10.     drop post_c z_post
 11. }
