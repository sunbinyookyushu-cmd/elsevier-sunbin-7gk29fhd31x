. * =====================================================================
. * C) interacted 2SLS: does the elasticity differ post vs pre?
. * =====================================================================
. tempname C

. postfile `C' str8 variant int cut double(b_pre se_pre b_diff se_diff p_diff kpf) long(nn) using "_ivd_tmp", replace
(note: file _ivd_tmp.dta not found)

. forvalues c = 2002/2019 {
  2.     gen byte post_c = (y >= `c')
  3.     gen g_post = ln_gaci_cwm * post_c
  4.     gen z_post = feyrer_int * post_c
  5.     capture noisily quietly ivreghdfe ln_co2_tot lnpop ln_sea_ma (ln_gaci_cwm g_post = feyrer_int z_post), absorb(isocode y) robust
  6.     if _rc == 0 {
  7.         local b1 = _b[ln_gaci_cwm]
  8.         local s1 = _se[ln_gaci_cwm]
  9.         local b2 = _b[g_post]
 10.         local s2 = _se[g_post]
 11.         di "IVDIFF all c=`c': b_pre=" %7.3f `b1' " b_diff=" %7.3f `b2' " se_diff=" %6.3f `s2' " F=" %7.1f e(widstat)
 12.         post `C' ("all") (`c') (`b1') (`s1') (`b2') (`s2') (2*normal(-abs(`b2'/`s2'))) (e(widstat)) (e(N))
 13.     }
 14.     capture noisily quietly ivreghdfe ln_co2_tot lnpop ln_sea_ma (ln_gaci_cwm g_post = feyrer_int z_post) if y != 2008 & y != 2009, absorb(isocode y) robust
 15.     if _rc == 0 {
 16.         local b1 = _b[ln_gaci_cwm]
 17.         local s1 = _se[ln_gaci_cwm]
 18.         local b2 = _b[g_post]
 19.         local s2 = _se[g_post]
 20.         di "IVDIFF exG c=`c': b_pre=" %7.3f `b1' " b_diff=" %7.3f `b2' " se_diff=" %6.3f `s2' " F=" %7.1f e(widstat)
 21.         post `C' ("exGFC") (`c') (`b1') (`s1') (`b2') (`s2') (2*normal(-abs(`b2'/`s2'))) (e(widstat)) (e(N))
 22.     }
 23.     drop post_c g_post z_post
 24. }
