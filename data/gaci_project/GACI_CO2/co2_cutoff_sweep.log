. * =====================================================================
. * A) cutoff sweep, pre/post, all vs exGFC
. * =====================================================================
. tempname S

. postfile `S' str8 variant int cut str4 side double(b se p kpf) long(nn) using "_cut_tmp", replace
(note: file _cut_tmp.dta not found)

. forvalues c = 2002/2019 {
  2.     quietly ivreghdfe ln_co2_tot lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int) if y < `c', absorb(isocode y) robust
  3.     local bb = _b[ln_gaci_cwm]
  4.     local ss = _se[ln_gaci_cwm]
  5.     di "SWEEP all  c=`c' pre : b=" %7.3f `bb' " se=" %6.3f `ss' " F=" %7.1f e(widstat) " N=" e(N)
  6.     post `S' ("all") (`c') ("pre") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (e(widstat)) (e(N))
  7.     quietly ivreghdfe ln_co2_tot lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int) if y >= `c', absorb(isocode y) robust
  8.     local bb = _b[ln_gaci_cwm]
  9.     local ss = _se[ln_gaci_cwm]
 10.     di "SWEEP all  c=`c' post: b=" %7.3f `bb' " se=" %6.3f `ss' " F=" %7.1f e(widstat) " N=" e(N)
 11.     post `S' ("all") (`c') ("post") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (e(widstat)) (e(N))
 12.     quietly ivreghdfe ln_co2_tot lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int) if y < `c' & y != 2008 & y != 2009, absorb(isocode y) robust
 13.     local bb = _b[ln_gaci_cwm]
 14.     local ss = _se[ln_gaci_cwm]
 15.     di "SWEEP exG  c=`c' pre : b=" %7.3f `bb' " se=" %6.3f `ss' " F=" %7.1f e(widstat) " N=" e(N)
 16.     post `S' ("exGFC") (`c') ("pre") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (e(widstat)) (e(N))
 17.     quietly ivreghdfe ln_co2_tot lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int) if y >= `c' & y != 2008 & y != 2009, absorb(isocode y) robust
 18.     local bb = _b[ln_gaci_cwm]
 19.     local ss = _se[ln_gaci_cwm]
 20.     di "SWEEP exG  c=`c' post: b=" %7.3f `bb' " se=" %6.3f `ss' " F=" %7.1f e(widstat) " N=" e(N)
 21.     post `S' ("exGFC") (`c') ("post") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (e(widstat)) (e(N))
 22. }
