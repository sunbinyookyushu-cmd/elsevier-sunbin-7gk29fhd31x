. foreach yv in ln_flights ln_skm ln_gauge ln_stage intl_share {
  2.     quietly ivreghdfe `yv' feyrer_int lnpop ln_sea_ma (nbr_lngaci = nbr_feyrer), absorb(isocode y) robust
  3.     local bb = _b[nbr_lngaci]
  4.     local ss = _se[nbr_lngaci]
  5.     di "SPM `yv': b=" %8.3f `bb' " se=" %8.3f `ss' " F=" %7.1f e(widstat)
  6.     post `S' ("`yv'") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (e(widstat)) (e(N))
  7. }
