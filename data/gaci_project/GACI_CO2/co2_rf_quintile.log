. tempname R

. postfile `R' str8 mod byte bin double(b se) long(nn) using "_co2_rf_tmp2", replace
(note: file _co2_rf_tmp2.dta not found)

. 
. foreach m in inc con rem {
  2.     di _n "==================== MODERATOR: `m' ===================="
  3.     reghdfe ln_co2_bunker_intl ibn.q_`m'#c.tourism_int lnpop, absorb(isocode y) vce(robust)
  4.     local nn = e(N)
  5.     forvalues k = 1/5 {
  6.         local bb = _b[`k'.q_`m'#c.tourism_int]
  7.         local sse = _se[`k'.q_`m'#c.tourism_int]
  8.         di "  Q`k': b = " %9.4f `bb' "  se = " %9.4f `sse'
  9.         post `R' ("`m'") (`k') (`bb') (`sse') (`nn')
 10.     }
 11. }

