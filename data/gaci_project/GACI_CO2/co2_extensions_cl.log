. * =====================================================================
. * A) measures x 6 outcomes
. * =====================================================================
. tempname M

. postfile `M' str16 meas str16 outc double(b se p kpf) long(nn) using "_m6_tmp_cl", replace
(note: file _m6_tmp_cl.dta not found)

. foreach tr in lng ln_gaci_max ln_gaci_mean {
  2.     foreach yv in ln_co2_tot ln_co2_lto ln_co2_5050 ln_co2_intl ln_skm ln_intensity {
  3.         quietly ivreghdfe `yv' lnpop ln_sea_ma (`tr' = feyrer_int), absorb(isocode y) cluster(isocode)
  4.         local bb = _b[`tr']
  5.         local ss = _se[`tr']
  6.         di "M6 `tr' `yv': b = " %9.3f `bb' "  KP F = " %7.1f e(widstat)
  7.         post `M' ("`tr'") ("`yv'") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (e(widstat)) (e(N))
  8.     }
  9. }
