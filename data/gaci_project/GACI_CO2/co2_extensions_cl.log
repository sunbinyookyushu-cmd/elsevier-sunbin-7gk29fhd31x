. * =====================================================================
. * B) mediation
. * =====================================================================
. tempname D

. postfile `D' str12 method str16 med double(a sa b sb cprime scp ctot acme sobel_se sobel_p prop) using "_med_tmp_cl", replace
(note: file _med_tmp_cl.dta not found)

. 
. * --- B1: IV product of coefficients ---
. foreach mv in ln_flights ln_skm intl_share {
  2.     quietly ivreghdfe ln_co2_tot lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int), absorb(isocode y) cluster(isocode)
  3.     local ctot = _b[ln_gaci_cwm]
  4.     quietly ivreghdfe `mv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int), absorb(isocode y) cluster(isocode)
  5.     local aa = _b[ln_gaci_cwm]
  6.     local sa = _se[ln_gaci_cwm]
  7.     quietly ivreghdfe ln_co2_tot `mv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int), absorb(isocode y) cluster(isocode)
  8.     local bb = _b[`mv']
  9.     local sb = _se[`mv']
 10.     local cp = _b[ln_gaci_cwm]
 11.     local scp = _se[ln_gaci_cwm]
 12.     local acme = `aa'*`bb'
 13.     local sse = sqrt(`aa'^2*`sb'^2 + `bb'^2*`sa'^2)
 14.     local sz = `acme'/`sse'
 15.     local sp2 = 2*normal(-abs(`sz'))
 16.     local pr = `acme'/`ctot'
 17.     di "MED-IV `mv': a=" %7.3f `aa' " b=" %7.3f `bb' " ACME=" %7.3f `acme' " Sobel p=" %6.4f `sp2' " prop=" %6.3f `pr'
 18.     post `D' ("IV_product") ("`mv'") (`aa') (`sa') (`bb') (`sb') (`cp') (`scp') (`ctot') (`acme') (`sse') (`sp2') (`pr')
 19. }
MED-IV ln_flights: a=  6.760 b=  0.667 ACME=  4.508 Sobel p=0.0002 prop= 0.843
MED-IV ln_skm: a=  5.641 b=  0.801 ACME=  4.521 Sobel p=0.0000 prop= 0.845
MED-IV intl_share: a=  0.019 b= -1.605 ACME= -0.031 Sobel p=     . prop=-0.006

. 
. * --- B2: Imai et al. (2010) medeff, OLS with country+year dummies ---
. foreach mv in ln_flights ln_skm intl_share {
  2.     capture noisily medeff (regress `mv' ln_gaci_cwm lnpop ln_sea_ma i.isocode i.y) ///
>         (regress ln_co2_tot ln_gaci_cwm `mv' lnpop ln_sea_ma i.isocode i.y), ///
>         treat(ln_gaci_cwm) mediate(`mv') sims(200)
  3.     if _rc == 0 {
  4.         local d1 = r(delta1)
  5.         local z1 = r(zeta1)
  6.         local tau = r(tau)
  7.         local pr = `d1'/`tau'
  8.         di "MED-IMAI `mv': ACME=" %7.3f `d1' " ADE=" %7.3f `z1' " total=" %7.3f `tau' " prop=" %6.3f `pr'
  9.         post `D' ("Imai_medeff") ("`mv'") (.) (.) (.) (.) (`z1') (.) (`tau') (`d1') (.) (.) (`pr')
 10.     }
 11. }
Using 0 and 1 as treatment values
factor-variable operators not allowed
