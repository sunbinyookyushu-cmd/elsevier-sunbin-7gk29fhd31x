. * =====================================================================
. * C) temporal heterogeneity
. * =====================================================================
. tempname T

. postfile `T' str12 period str16 outc double(b se p kpf) long(nn) using "_tmp_tmp_cl", replace
(note: file _tmp_tmp_cl.dta not found)

. foreach yv in ln_co2_tot ln_co2_intl ln_skm ln_intensity {
  2.     quietly ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int), absorb(isocode y) cluster(isocode)
  3.     local bb = _b[ln_gaci_cwm]
  4.     local ss = _se[ln_gaci_cwm]
  5.     post `T' ("full") ("`yv'") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (e(widstat)) (e(N))
  6.     quietly ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int) if y < 2010, absorb(isocode y) cluster(isocode)
  7.     local bb = _b[ln_gaci_cwm]
  8.     local ss = _se[ln_gaci_cwm]
  9.     di "TEMP pre `yv': b=" %8.3f `bb' " F=" %7.1f e(widstat)
 10.     post `T' ("1996-2009") ("`yv'") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (e(widstat)) (e(N))
 11.     quietly ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int) if y >= 2010, absorb(isocode y) cluster(isocode)
 12.     local bb = _b[ln_gaci_cwm]
 13.     local ss = _se[ln_gaci_cwm]
 14.     di "TEMP post `yv': b=" %8.3f `bb' " F=" %7.1f e(widstat)
 15.     post `T' ("2010-2023") ("`yv'") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (e(widstat)) (e(N))
 16. }
