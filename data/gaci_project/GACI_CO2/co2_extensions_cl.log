. * =====================================================================
. * D) spatial spillovers
. * =====================================================================
. tempname S

. postfile `S' str8 stage str16 outc str12 var double(b se p kpf) long(nn) using "_sp_tmp_cl", replace
(note: file _sp_tmp_cl.dta not found)

. foreach yv in ln_co2_tot ln_co2_intl ln_intensity g_vol {
  2.     * reduced form
.     quietly reghdfe `yv' feyrer_int nbr_feyrer lnpop ln_sea_ma, absorb(isocode y) vce(cluster isocode)
  3.     foreach v in feyrer_int nbr_feyrer {
  4.         local bb = _b[`v']
  5.         local ss = _se[`v']
  6.         post `S' ("RF") ("`yv'") ("`v'") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (.) (e(N))
  7.     }
  8.     * 2SLS, own + neighbour connectivity both endogenous
.     capture noisily quietly ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm nbr_lngaci = feyrer_int nbr_feyrer), absorb(isocode y) cluster(isocode)
  9.     if _rc == 0 {
 10.         foreach v in ln_gaci_cwm nbr_lngaci {
 11.             local bb = _b[`v']
 12.             local ss = _se[`v']
 13.             di "SPILL IV `yv' `v': b=" %8.3f `bb' " se=" %8.3f `ss' " F=" %7.1f e(widstat)
 14.             post `S' ("IV") ("`yv'") ("`v'") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (e(widstat)) (e(N))
 15.         }
 16.     }
 17. }
