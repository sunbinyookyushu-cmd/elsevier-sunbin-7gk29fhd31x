. program define runcell
  1.     args panel grp yv xv cond
  2.     quietly count if (`cond') & !missing(`yv', `xv')
  3.     if r(N) < 200 {
  4.         di as err "SKIP `panel' `grp' `yv': N = " r(N)
  5.         exit
  6.     }
  7.     capture noisily reghdfe `yv' `xv' if `cond', absorb(apid cyr) vce(cluster apid)
  8.     if _rc exit
  9.     local bb = _b[`xv']
 10.     local sse = _se[`xv']
 11.     local pp = 2*normal(-abs(`bb'/`sse'))
 12.     di "APH [`panel'] `grp' `yv' on `xv': b = " %8.3f `bb' " (se " %7.3f `sse' ")  N = " %8.0f e(N) "  airports = " %6.0f e(N_clust)
 13.     post $RH ("`panel'") ("`grp'") ("`yv'") (`bb') (`sse') (`pp') (e(N)) (e(N_clust))
 14. end

. 
. foreach yv in ln_co2 ln_skm ln_intensity intl_share_skm {
  2.     runcell ALL all `yv' ln_gaci "1==1"
  3.     * hub status
.     runcell HUB nat_hub `yv' ln_gaci "hub_nat==1"
  4.     runcell HUB non_hub `yv' ln_gaci "hub_nat==0"
  5.     runcell HUB top5 `yv' ln_gaci "top5==1"
  6.     runcell HUB not_top5 `yv' ln_gaci "top5==0"
  7.     runcell HUB top1 `yv' ln_gaci "top1==1"
  8.     runcell HUB not_top1 `yv' ln_gaci "top1==0"
  9.     * baseline connectivity
.     foreach g in 1 2 3 {
 10.         runcell GAC gac`g' `yv' ln_gaci "gac3==`g'"
 11.         runcell SKM skm`g' `yv' ln_gaci "skm3==`g'"
 12.         runcell INC inc`g' `yv' ln_gaci "inc3==`g'"
 13.     }
 14.     * orientation
.     runcell ORI domestic_only `yv' ln_gaci "orient==0"
 15.     runcell ORI mixed `yv' ln_gaci "orient==1"
 16.     runcell ORI international `yv' ln_gaci "orient==2"
 17.     * region
.     foreach r in EU AS AF LA ME NA SW {
 18.         runcell REG `r' `yv' ln_gaci `"mreg=="`r'""'
 19.     }
 20.     * topology-only regressors, full sample
.     runcell TOPO eig `yv' ln_eig "1==1"
 21.     runcell TOPO close `yv' ln_close "1==1"
 22.     runcell TOPO betw `yv' ln_betw "1==1"
 23.     runcell TOPO deg `yv' ln_deg "1==1"
 24. }
