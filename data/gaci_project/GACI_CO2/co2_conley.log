ln_tradevol   ln_gaci_mean  ln_unesco     lnz_own       abslat        eig_sum       betw_sum      cap_sum       merch_share   ln_remote     z_nat         ln_gaci_max   n_arr_flig~s  co2_bunker    dep_seat_k~l  co2_lto_intl  ln_co2_lto    ln_flights
lngdp         lncap         unesco_cum    lnpc          n_air         eig_mean      betw_mean     cap_mean      merch_inte~y  nat_e         z_mix         n_dep_flig~s  dep_co2_cr~g  co2_5050      n_arr_flig~l  co2_bunker~l  ln_co2_5050

