ln_remote already numeric; no replace
feyrer_int already numeric; no replace
ln_sea_ma already numeric; no replace
ln_air_ma already numeric; no replace

. merge 1:1 c y using `co2', keep(1 3) nogenerate

    Result                           # of obs.
    -----------------------------------------
    not matched                             0
    matched                             4,643  
    -----------------------------------------

. encode c, gen(isocode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. 
. gen ln_co2_tot = ln(co2_bunker) if co2_bunker > 0

. gen ln_skm = ln(dep_seat_km) if dep_seat_km > 0

. gen ln_intensity = ln_co2_tot - ln_skm

. gen ln_flights = ln(n_dep_flights) if n_dep_flights > 0

. gen ln_gauge = ln(dep_seats/n_dep_flights) if n_dep_flights > 0 & dep_seats > 0

. gen ln_stage = ln(dep_seat_km/dep_seats) if dep_seats > 0 & dep_seat_km > 0

. gen lto_share = co2_lto/co2_bunker if co2_bunker > 0

. gen intl_share = dep_seat_km_intl/dep_seat_km if dep_seat_km > 0

. replace intl_share = 1 if intl_share > 1 & !missing(intl_share)
(0 real changes made)

. 
. capture which ivreghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
.     ssc install ivreghdfe, replace
. }

. 
. * =====================================================================
. * Mechanism outcomes, Feyrer IV
. * =====================================================================
. tempname M

. postfile `M' str16 outc double(b se kpf) long(nn) using "_fey_mech_tmp", replace
(note: file _fey_mech_tmp.dta not found)

. foreach yv in ln_co2_tot ln_skm ln_flights ln_gauge ln_stage ln_intensity lto_share intl_share {
  2.     ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int), absorb(isocode y) robust
  3.     di "MECH `yv': b = " %9.3f _b[ln_gaci_cwm] " (se " %8.3f _se[ln_gaci_cwm] ")  KP F = " %7.1f e(widstat) "  N = " %8.0f e(N)
  4.     post `M' ("`yv'") (_b[ln_gaci_cwm]) (_se[ln_gaci_cwm]) (e(widstat)) (e(N))
  5. }
(dropped 1 singleton observations)
