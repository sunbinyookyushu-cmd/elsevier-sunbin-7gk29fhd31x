. postfile `R' str10 panel str24 item str14 var double(b se p kpf) long(nn) double(v12 v22 v13 v23 v33) using "_yifu_tmp_cl", replace
(note: file _yifu_tmp_cl.dta not found)

. global RH `R'

. program define postone
  1.     args panel item v kpf
  2.     local bb = _b[`v']
  3.     local sse = _se[`v']
  4.     local pp = 2*normal(-abs(`bb'/`sse'))
  5.     di "YIFU [`panel'] `item' `v': b = " %10.4f `bb' " (se " %9.4f `sse' ")  KP F = " %7.1f `kpf' "  N = " %7.0f e(N)
  6.     post $RH ("`panel'") ("`item'") ("`v'") (`bb') (`sse') (`pp') (`kpf') (e(N)) (.) (.) (.) (.) (.)
  7. end

. 
. * =====================================================================
. * C) sample moments (posted as rows; b = value)
. * =====================================================================
. gen byte insamp = !missing(ln_co2_tot, ln_gaci_cwm, feyrer_int, lnpop, ln_sea_ma)

. foreach v in gaci co2_mt ln_gaci_cwm gaci0 lg0 {
  2.     quietly summarize `v' if insamp, detail
  3.     post $RH ("C") ("moment_`v'") ("mean") (r(mean)) (r(sd)) (.) (.) (r(N)) (r(p10)) (r(p25)) (r(p50)) (r(p75)) (r(p90))
  4.     di "MOMENT `v': mean " %9.4f r(mean) "  p10 " %9.4f r(p10) "  p50 " %9.4f r(p50) "  p90 " %9.4f r(p90)
  5. }
MOMENT gaci: mean    1.0852  p10    0.7126  p50    0.9874  p90    1.6414
MOMENT co2_mt: mean    3.8145  p10    0.0298  p50    0.3606  p90    9.4849
MOMENT ln_gaci_cwm: mean    0.0254  p10   -0.3388  p50   -0.0127  p90    0.4955
MOMENT gaci0: mean    1.0133  p10    0.6963  p50    0.9264  p90    1.4782
MOMENT lg0: mean   -0.0364  p10   -0.3620  p50   -0.0764  p90    0.3908

. quietly summarize dev if insamp, detail

. post $RH ("C") ("moment_dev") ("mean") (r(mean)) (r(sd)) (.) (.) (r(N)) (r(p10)) (r(p25)) (r(p50)) (r(p75)) (r(p90))

. di "centre lg0 mean = " %8.4f `m0'
centre lg0 mean =  -0.0509

. post $RH ("C") ("centre_lg0") ("m0") (`m0') (.) (.) (.) (.) (.) (.) (.) (.) (.)

