. encode c, gen(isocode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. gen ln_co2_tot = ln(co2_bunker) if co2_bunker > 0

. gen ln_co2_intl = ln(co2_bunker_intl) if co2_bunker_intl > 0

. gen co2_dom = co2_bunker - co2_bunker_intl

. gen ln_co2_dom = ln(co2_dom) if co2_dom > 0
(1,066 missing values generated)

. gen ln_skm = ln(dep_seat_km) if dep_seat_km > 0

. gen ln_intensity = ln_co2_tot - ln_skm

. gen ln_flights = ln(n_dep_flights) if n_dep_flights > 0

. gen ln_gauge = ln(dep_seats/n_dep_flights) if n_dep_flights > 0 & dep_seats > 0

. gen ln_stage = ln(dep_seat_km/dep_seats) if dep_seats > 0 & dep_seat_km > 0

. gen intl_share = dep_seat_km_intl/dep_seat_km if dep_seat_km > 0

. replace intl_share = 1 if intl_share > 1 & !missing(intl_share)
(0 real changes made)

. encode subregion, gen(srid)

. egen sry = group(srid y)
(8 missing values generated)

. 
. tempname R

. postfile `R' str12 panel str32 item str16 var double(b se p kpf) long(nn) using "_spsupp_tmp", replace
(note: file _spsupp_tmp.dta not found)

. global RH `R'

. program define postone
  1.     args panel item v
  2.     local bb = _b[`v']
  3.     local sse = _se[`v']
  4.     local pp = 2*normal(-abs(`bb'/`sse'))
  5.     di "SUP [`panel'] `item' `v': b = " %9.3f `bb' " (se " %8.3f `sse' ")  KP F = " %7.1f e(widstat) "  N = " %7.0f e(N)
  6.     post $RH ("`panel'") ("`item'") ("`v'") (`bb') (`sse') (`pp') (e(widstat)) (e(N))
  7. end

. 
. * joint IV specs under three clusterings
. foreach W in contig knn5 b1 k1000 {
  2.     foreach cl in robust country subregion twoway {
  3.         if "`cl'" == "robust" local vo "robust"
  4.         if "`cl'" == "country" local vo "cluster(isocode)"
  5.         if "`cl'" == "subregion" local vo "cluster(srid)"
  6.         if "`cl'" == "twoway" local vo "cluster(isocode y)"
  7.         capture noisily ivreghdfe ln_co2_tot lnpop ln_sea_ma has_contig (ln_gaci_cwm nbr_g_`W' = feyrer_int nbr_f_`W'), absorb(isocode y) `vo'
  8.         if _rc == 0 {
  9.             postone JOINT `W'_`cl' ln_gaci_cwm
 10.             postone JOINT `W'_`cl' nbr_g_`W'
 11.         }
 12.     }
 13. }
