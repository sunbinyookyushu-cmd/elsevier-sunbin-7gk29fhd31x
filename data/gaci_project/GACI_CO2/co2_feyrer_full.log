. * =====================================================================
. * D) Conley UCI (gamma = direct effect of feyrer_int, [0, gmax])
. * =====================================================================
. tempname R

. postfile `R' str16 outc double(betaiv seiv rfcoef lb10 lb20 lb30 ub0 fstar nn) using "_fey_conley_tmp", replace
(note: file _fey_conley_tmp.dta not found)

. foreach yv in ln_co2_intl ln_co2_tot ln_intensity {
  2.     reghdfe `yv' feyrer_int lnpop ln_sea_ma, absorb(isocode y) vce(robust)
  3.     local rfc = _b[feyrer_int]
  4.     ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int), absorb(isocode y) robust
  5.     local biv = _b[ln_gaci_cwm]
  6.     local siv = _se[ln_gaci_cwm]
  7.     local nn = e(N)
  8.     local ub0 = `biv' + 1.959964*`siv'
  9.     foreach f in 10 20 30 {
 10.         local g = (`f'/100)*`rfc'
 11.         capture drop ytil
 12.         gen ytil = `yv' - `g'*feyrer_int
 13.         quietly ivreghdfe ytil lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int), absorb(isocode y) robust
 14.         local lb`f' = _b[ln_gaci_cwm] - 1.959964*_se[ln_gaci_cwm]
 15.         drop ytil
 16.     }
 17.     local sgn = 1
 18.     if `biv' < 0 {
 19.         local sgn = -1
 20.     }
 21.     local fstar = 0
 22.     local f = 0
 23.     local go = 1
 24.     while `go' {
 25.         local f = `f' + 0.01
 26.         if `f' > 2.001 {
 27.             local go = 0
 28.         }
 29.         else {
 30.             local g = `f'*`rfc'
 31.             capture drop ytil
 32.             gen ytil = `yv' - `g'*feyrer_int
 33.             quietly ivreghdfe ytil lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int), absorb(isocode y) robust
 34.             local lbf = `sgn'*(_b[ln_gaci_cwm] - `sgn'*1.959964*_se[ln_gaci_cwm])
 35.             drop ytil
 36.             if `lbf' > 0 {
 37.                 local fstar = `f'
 38.             }
 39.             else {
 40.                 local go = 0
 41.             }
