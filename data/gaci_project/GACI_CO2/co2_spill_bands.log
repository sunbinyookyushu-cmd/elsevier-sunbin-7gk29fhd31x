. * A3.. joint IV under alternative W (with SW conditional F)
. foreach W in inv contig knn5 b1 k500 k1000 {
  2.     capture noisily ivreghdfe ln_co2_tot lnpop ln_sea_ma has_contig (ln_gaci_cwm nbr_g_`W' = feyrer_int nbr_f_`W'), absorb(isocode y) robust ffirst
  3.     if _rc == 0 {
  4.         local sw_own = .
  5.         local sw_nbr = .
  6.         capture matrix FS = e(first)
  7.         if _rc == 0 {
  8.             local rn : rownames FS
  9.             local cn : colnames FS
 10.             local ri = 0
 11.             local k = 1
 12.             foreach r of local rn {
 13.                 if "`r'" == "SWF" local ri = `k'
 14.                 local k = `k' + 1
 15.             }
 16.             if `ri' > 0 {
 17.                 local sw_own = FS[`ri', 1]
 18.                 local sw_nbr = FS[`ri', 2]
 19.             }
 20.         }
 21.         postone A joint_`W' ln_gaci_cwm e(widstat) `sw_own'
 22.         postone A joint_`W' nbr_g_`W' e(widstat) `sw_nbr'
 23.     }
 24.     else di as err "JOINT IV FAILED for W = `W'"
 25. }
