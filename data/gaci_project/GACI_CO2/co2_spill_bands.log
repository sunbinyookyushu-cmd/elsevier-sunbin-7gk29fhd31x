. postfile `R' str10 panel str32 item str16 var double(b se p kpf swf) long(nn) using "_spill_tmp", replace
(note: file _spill_tmp.dta not found)

. global RH `R'

. 
. program define postone
  1.     * post coefficient on `v' from the last estimation, with optional swf
.     args panel item v kpf swf
  2.     local bb = _b[`v']
  3.     local sse = _se[`v']
  4.     local pp = 2*normal(-abs(`bb'/`sse'))
  5.     di "SPL [`panel'] `item' `v': b = " %9.3f `bb' " (se " %8.3f `sse' ")  KP F = " %7.1f `kpf' "  SWF = " %7.1f `swf' "  N = " %7.0f e(N)
  6.     post $RH ("`panel'") ("`item'") ("`v'") (`bb') (`sse') (`pp') (`kpf') (`swf') (e(N))
  7. end

. 
