. encode c, gen(isocode)

. xtset isocode y
       panel variable:  isocode (unbalanced)
        time variable:  y, 1996 to 2023, but with gaps
                delta:  1 unit

. 
. gen ln_co2_tot = ln(co2_bunker) if co2_bunker > 0

. gen ln_co2_intl = ln(co2_bunker_intl) if co2_bunker_intl > 0
(1 missing value generated)

. gen ln_skm = ln(dep_seat_km) if dep_seat_km > 0

. gen ln_intensity = ln_co2_tot - ln_skm

. 
. local cond1 "y < 2008"

. local lab1  "1996-2007"

. local cond2 "y < 2010"

. local lab2  "1996-2009"

. local cond3 "y >= 2010 & y != 2020 & y != 2021"

. local lab3  "2010-2023_exCOVID"

. local cond4 "y >= 2010 & y <= 2019"

. local lab4  "2010-2019"

. local cond5 "y >= 2006 & y != 2020 & y != 2021"

. local lab5  "2006-2023_exCOVID"

. local cond6 "y >= 2012 & y != 2020 & y != 2021"

. local lab6  "2012-2023_exCOVID"

. 
. tempname T

. postfile `T' str24 samp str16 outc double(b se p kpf) long(nn) using "_tp8_tmp", replace
(note: file _tp8_tmp.dta not found)

. foreach yv in ln_co2_tot ln_co2_intl ln_skm ln_intensity {
  2.     forvalues i = 1/6 {
  3.         quietly ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int) if `cond`i'', absorb(isocode y) robust
  4.         local bb = _b[ln_gaci_cwm]
  5.         local ss = _se[ln_gaci_cwm]
  6.         di "XC `lab`i'' `yv': b=" %7.3f `bb' " se=" %6.3f `ss' " F=" %7.1f e(widstat) " N=" e(N)
  7.         post `T' ("`lab`i''") ("`yv'") (`bb') (`ss') (2*normal(-abs(`bb'/`ss'))) (e(widstat)) (e(N))
  8.     }
  9. }
