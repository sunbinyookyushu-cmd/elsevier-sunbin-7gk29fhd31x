. do co2_feyrer_mechanism_cl.do 

. * COUNTRY-CLUSTERED COPY generated by _make_cl_dofiles.py on 2026-09-03 from 
> co2_feyrer_mechanism.do (vce -> cluster(isocode); outputs *_cl.csv)
. *============================================================================
> ==
. * co2_feyrer_mechanism.do
. * MECHANISM DECOMPOSITION under the Feyrer air/sea IV.
. * Identity: CO2 = flights x (seats/flight) x (km/seat) x (CO2/seat-km)
. * so in logs: b(CO2) = b(flights) + b(gauge) + b(stage) + b(intensity).
. * Outcomes:
. *   ln_flights   = ln n_dep_flights            (frequency margin)
. *   ln_gauge     = ln(dep_seats/n_dep_flights)  (aircraft up-gauging)
. *   ln_stage     = ln(dep_seat_km/dep_seats)    (stage length)
. *   ln_intensity = ln(CO2/seat-km)              (fuel intensity)
. *   lto_share    = co2_lto/co2_bunker           (LTO amortisation)
. *   intl_share   = dep_seat_km_intl/dep_seat_km (composition)
. * Exports: _feyrer_mechanism.csv
. *============================================================================
> ==
. clear all

. set more off

. set varabbrev off

. set linesize 255

. version 14

. cd "C:/Users/sunbi/managi-lab Dropbox/Sunbin Yoo/Research Box ^-^/2026/GACI/GACI_CO2"
C:\Users\sunbi\managi-lab Dropbox\Sunbin Yoo\Research Box ^-^\2026\GACI\GACI_CO2

. 
. * ---- build merged dataset (same as co2_feyrer_full.do) ----
. import delimited "co2_country_year.csv", clear varnames(1) encoding("utf-8")
(20 vars, 6,777 obs)

. keep iso3 year co2_bunker co2_bunker_intl co2_lto co2_5050 dep_seat_km n_dep_flights dep_seats dep_seat_km_intl

. rename iso3 c

. rename year y

. tempfile co2

. save `co2'
file C:\Users\sunbi\AppData\Local\Temp\ST_3db4_000001.tmp saved

. 
. import delimited "../gaci_panel_combined.csv", clear varnames(1) encoding("utf-8")
(44 vars, 4,643 obs)

. ds c reg, not
y             lngdp         ln_gaci_mean  gaci_mean     unesco_cum~t  lnpc          abslat        deg_mean      close_sum     betw_mean     cap_sum       nat_endow     tourism_int   feyrer_int
trade_share   lng           lncap         ln_unesco     lnz           lnpop         n_air         eig_sum       close_mean    regimp_sum    cap_mean      merch_share   tourism_cum   ln_sea_ma
ln_tradevol   ln_gaci_cwm   gaci_cwmean   unesco_cum    lnz_own       lnland        deg_sum       eig_mean      betw_sum      regimp_mean   tour_shift    merch_inte~y  ln_remote     ln_air_ma

. destring `r(varlist)', replace force
