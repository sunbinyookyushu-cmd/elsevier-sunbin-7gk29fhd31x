. tempname M

. postfile `M' str12 block str12 grp str6 seg str16 outc double(b se p kpf) long(nn) using "_decomp_tmp_cl", replace
(note: file _decomp_tmp_cl.dta not found)

. 
. program define runblock
  1.     args block grp seg cond
  2.     foreach comp in co2 flights gauge stage intensity {
  3.         quietly ivreghdfe ln_`comp'_`seg' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int) if ok_`seg' & (`cond'), absorb(isocode y) cluster(isocode)
  4.         local bb = _b[ln_gaci_cwm]
  5.         local sse = _se[ln_gaci_cwm]
  6.         local pp = 2*normal(-abs(`bb'/`sse'))
  7.         di "DECOMP `block' `grp' `seg' `comp': b = " %9.3f `bb' " (se " %8.3f `sse' ")  KP F = " %7.1f e(widstat) "  N = " %8.0f e(N)
  8.         post $MH ("`block'") ("`grp'") ("`seg'") ("ln_`comp'") (`bb') (`sse') (`pp') (e(widstat)) (e(N))
  9.     }
 10. end

. global MH `M'

