. * common samples per segment
. foreach S in tot intl dom {
  2.     gen byte ok_`S' = !missing(ln_co2_`S') & !missing(ln_flights_`S') & !missing(ln_gauge_`S') & !missing(ln_stage_`S') & !missing(ln_intensity_`S') & !missing(lnpop) & !missing(ln_sea_ma) & !missing(feyrer_int) & !missing(ln_gaci_cwm)
  3. }

