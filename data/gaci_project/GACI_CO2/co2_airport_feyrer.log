. * 2SLS and reduced forms
. foreach yv in ln_co2 ln_skm ln_intensity intl_share_skm {
  2.     capture noisily ivreghdfe `yv' (ln_gaci = z_air), absorb(apid cyr) cluster(apid)
  3.     if _rc == 0 {
  4.         di "AIV baseline `yv': b = " %8.3f _b[ln_gaci] " (se " %7.3f _se[ln_gaci] ")  KP F = " %8.1f e(widstat) "  N = " %8.0f e(N)
  5.         post `R' ("iv_baseline") ("`yv'") (_b[ln_gaci]) (_se[ln_gaci]) (2*normal(-abs(_b[ln_gaci]/_se[ln_gaci]))) (e(widstat)) (e(N))
  6.     }
  7.     capture noisily ivreghdfe `yv' z_cap96 z_gaci96 (ln_gaci = z_air), absorb(apid cyr) cluster(apid)
  8.     if _rc == 0 {
  9.         di "AIV stressed `yv': b = " %8.3f _b[ln_gaci] " (se " %7.3f _se[ln_gaci] ")  KP F = " %8.1f e(widstat)
 10.         post `R' ("iv_stressed") ("`yv'") (_b[ln_gaci]) (_se[ln_gaci]) (2*normal(-abs(_b[ln_gaci]/_se[ln_gaci]))) (e(widstat)) (e(N))
 11.     }
 12.     reghdfe `yv' z_air, absorb(apid cyr) vce(cluster apid)
 13.     post `R' ("rf_baseline") ("`yv'") (_b[z_air]) (_se[z_air]) (2*normal(-abs(_b[z_air]/_se[z_air]))) (.) (e(N))
 14.     reghdfe `yv' ln_gaci, absorb(apid cyr) vce(cluster apid)
 15.     post `R' ("ols") ("`yv'") (_b[ln_gaci]) (_se[ln_gaci]) (2*normal(-abs(_b[ln_gaci]/_se[ln_gaci]))) (.) (e(N))
 16. }
