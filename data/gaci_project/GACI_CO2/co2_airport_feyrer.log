. do co2_airport_feyrer.do 

. *============================================================================
> ==
. * co2_airport_feyrer.do   (LZ comment 2, identification pilot, 2026-09-03)
. * Airport-level 2SLS with the airport Feyrer shifter z_air = a_t x ln airMA_a
> ,1996
. * under airport FE + country x year FE (cluster airport).
. *   (1) first stage, (2) 2SLS on ln CO2 / ln seat-km / ln intensity / intl sh
> are,
. *   (3) size-by-cycle stress: add a_t x ln seat-km_1996 and a_t x ln GACI_199
> 6,
. *   (4) reduced forms.
. * Decision rule (pre-registered in the response plan): the pilot is adopted o
> nly if
. * the first stage survives (3) with KP F above 10.
. * Export: _airport_feyrer.csv (item outc b se p kpf nn)
. *============================================================================
> ==
. clear all

. set more off

. set varabbrev off

. set linesize 255

. version 14

. cd "C:/Users/sunbi/managi-lab Dropbox/Sunbin Yoo/Research Box ^-^/2026/GACI/GACI_CO2"
C:\Users\sunbi\managi-lab Dropbox\Sunbin Yoo\Research Box ^-^\2026\GACI\GACI_CO2

. 
. import delimited "airport_feyrer_panel.csv", clear varnames(1) encoding("utf-8")
(10 vars, 79,958 obs)

. ds airport_iata iso3, not
year        ln_airma96  ln_skm96    ln_gaci96   a_t         z_air       z_cap96     z_gaci96

. destring `r(varlist)', replace force
year already numeric; no replace
ln_airma96 already numeric; no replace
ln_skm96 already numeric; no replace
ln_gaci96 already numeric; no replace
a_t already numeric; no replace
z_air already numeric; no replace
z_cap96 already numeric; no replace
z_gaci96 already numeric; no replace

. tempfile z

. save `z'
file C:\Users\sunbi\AppData\Local\Temp\ST_6914_000001.tmp saved

. import delimited "airport_co2_panel.csv", clear varnames(1) encoding("utf-8")
(14 vars, 97,165 obs)

. ds airport_iata iso3 region, not
year          gaci          ln_gaci       co2_bunker    co2_lto       ln_co2        ln_skm        ln_intensity  intl_share~m  n_dep_flig~s  dep_seat_km

. destring `r(varlist)', replace force
year already numeric; no replace
gaci already numeric; no replace
ln_gaci already numeric; no replace
co2_bunker already numeric; no replace
co2_lto already numeric; no replace
ln_co2 already numeric; no replace
ln_skm already numeric; no replace
ln_intensity already numeric; no replace
intl_share_skm already numeric; no replace
n_dep_flights already numeric; no replace
dep_seat_km already numeric; no replace

. merge 1:1 airport_iata year using `z', keep(3) nogenerate

    Result                           # of obs.
    -----------------------------------------
    not matched                             0
    matched                            79,958  
    -----------------------------------------

. encode airport_iata, gen(apid)

. encode iso3, gen(cid)

. egen cyr = group(cid year)

. 
. capture which ivreghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
.     ssc install ivreghdfe, replace
. }

. 
. tempname R

. postfile `R' str24 item str16 outc double(b se p kpf) long(nn) using "_apf_tmp", replace
(note: file _apf_tmp.dta not found)

. 
. * first stages
. reghdfe ln_gaci z_air, absorb(apid cyr) vce(cluster apid)
