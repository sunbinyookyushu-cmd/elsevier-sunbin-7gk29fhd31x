. * =====================================================================
. * D) zero-first-stage test (top baseline connectivity tercile)
. * =====================================================================
. di _n "===== D) zero first stage ====="

===== D) zero first stage =====

. foreach g in 1 2 3 {
  2.     quietly reghdfe ln_gaci_cwm feyrer_int lnpop ln_sea_ma if con3 == `g', absorb(isocode y) vce(cluster isocode)
  3.     local bb = _b[feyrer_int]
  4.     local sse = _se[feyrer_int]
  5.     quietly test feyrer_int
  6.     local ff = r(F)
  7.     post $RH ("D") ("con`g'") ("FS") (`bb') (`sse') (2*normal(-abs(`bb'/`sse'))) (`ff') (e(N))
  8.     di "FS  [D] con`g': pi = " %9.4f `bb' "  F = " %8.1f `ff'
  9.     quietly reghdfe ln_co2_tot feyrer_int lnpop ln_sea_ma if con3 == `g', absorb(isocode y) vce(cluster isocode)
 10.     local bb = _b[feyrer_int]
 11.     local sse = _se[feyrer_int]
 12.     post $RH ("D") ("con`g'") ("RF") (`bb') (`sse') (2*normal(-abs(`bb'/`sse'))) (.) (e(N))
 13.     di "RF  [D] con`g': b = " %9.4f `bb' " (se " %8.4f `sse' ")"
 14.     quietly reghdfe ln_intensity feyrer_int lnpop ln_sea_ma if con3 == `g', absorb(isocode y) vce(cluster isocode)
 15.     local bb = _b[feyrer_int]
 16.     local sse = _se[feyrer_int]
 17.     post $RH ("D") ("con`g'_intens") ("RF") (`bb') (`sse') (2*normal(-abs(`bb'/`sse'))) (.) (e(N))
 18. }
