. postfile `R' str10 panel str28 item str10 stat double(b se p f) long(nn) using "_excl_tmp", replace
(note: file _excl_tmp.dta not found)

. global RH `R'

. 
. program define postrf
  1.     * RF of `yv' on `iv' (plus controls), post coefficient on `iv'
.     args panel item yv iv extra
  2.     quietly reghdfe `yv' `iv' lnpop ln_sea_ma `extra', absorb(isocode y) vce(robust)
  3.     local bb = _b[`iv']
  4.     local sse = _se[`iv']
  5.     local pp = 2*normal(-abs(`bb'/`sse'))
  6.     di "RF  [`panel'] `item': b(`iv') = " %9.4f `bb' " (se " %8.4f `sse' ")  N = " %7.0f e(N)
  7.     post $RH ("`panel'") ("`item'") ("RF") (`bb') (`sse') (`pp') (.) (e(N))
  8. end

. 
. program define postiv
  1.     * 2SLS of `yv' on ln_gaci_cwm instrumented by `iv' (plus controls)
.     args panel item yv iv extra
  2.     capture noisily ivreghdfe `yv' lnpop ln_sea_ma `extra' (ln_gaci_cwm = `iv'), absorb(isocode y) robust
  3.     if _rc {
  4.         di as err "IV FAILED [`panel'] `item'"
  5.         exit
  6.     }
  7.     local bb = _b[ln_gaci_cwm]
  8.     local sse = _se[ln_gaci_cwm]
  9.     local pp = 2*normal(-abs(`bb'/`sse'))
 10.     di "IV  [`panel'] `item': b = " %9.4f `bb' " (se " %8.4f `sse' ")  KP F = " %8.1f e(widstat) "  N = " %7.0f e(N)
 11.     post $RH ("`panel'") ("`item'") ("IV") (`bb') (`sse') (`pp') (e(widstat)) (e(N))
 12. end

. 
. program define postfs
  1.     * first stage: ln_gaci_cwm on `iv' (plus extra), coefficient and partial F on `iv'
.     args panel item iv extra
  2.     quietly reghdfe ln_gaci_cwm `iv' lnpop ln_sea_ma `extra', absorb(isocode y) vce(robust)
  3.     local bb = _b[`iv']
  4.     local sse = _se[`iv']
  5.     local pp = 2*normal(-abs(`bb'/`sse'))
  6.     quietly test `iv'
  7.     local ff = r(F)
  8.     di "FS  [`panel'] `item': pi(`iv') = " %9.4f `bb' " (se " %8.4f `sse' ")  F = " %8.1f `ff' "  N = " %7.0f e(N)
  9.     post $RH ("`panel'") ("`item'") ("FS") (`bb') (`sse') (`pp') (`ff') (e(N))
 10. end

