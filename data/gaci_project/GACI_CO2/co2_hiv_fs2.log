. do co2_hiv_fs2.do 

. *============================================================================
> ==
. * co2_hiv_firststage.do
. * PILOT: first stage of the airport-level heritage-proximity instrument.
. *   z_jt = a_t (global tourism cycle) x fixed natural+mixed-site exposure of
. *   airport j (n100 / n200 / inverse-distance within 300km).
. *   Spec 1: airport FE + year FE           (cross-country + within variation)
. *   Spec 2: airport FE + country x year FE (within-country only, demanding)
. *   SE clustered by airport; F = cluster-robust F on the instrument.
. *============================================================================
> ==
. clear all

. set more off

. set varabbrev off

. set linesize 255

. version 14

. cd "C:/Users/sunbi/managi-lab Dropbox/Sunbin Yoo/Research Box ^-^/2026/GACI/GACI_CO2"
C:\Users\sunbi\managi-lab Dropbox\Sunbin Yoo\Research Box ^-^\2026\GACI\GACI_CO2

. 
. import delimited "airport_hiv_panel2.csv", clear varnames(1) encoding("utf-8")
(23 vars, 97,165 obs)

. ds airport_iata iso3 region, not
year          ln_gaci       co2_lto       ln_skm        intl_share~m  dep_seat_km   exp_n200      a_t           z_n200        exp_gw
gaci          co2_bunker    ln_co2        ln_intensity  n_dep_flig~s  exp_n100      exp_invd      z_n100        z_invd        z_gw

. destring `r(varlist)', replace force
year already numeric; no replace
gaci already numeric; no replace
ln_gaci already numeric; no replace
co2_bunker already numeric; no replace
co2_lto already numeric; no replace
ln_co2 already numeric; no replace
ln_skm already numeric; no replace
ln_intensity already numeric; no replace
intl_share_skm already numeric; no replace
n_dep_flights already numeric; no replace
dep_seat_km already numeric; no replace
exp_n100 already numeric; no replace
exp_n200 already numeric; no replace
exp_invd already numeric; no replace
a_t already numeric; no replace
z_n100 already numeric; no replace
z_n200 already numeric; no replace
z_invd already numeric; no replace
exp_gw already numeric; no replace
z_gw already numeric; no replace

. encode airport_iata, gen(apid)

. encode iso3, gen(cid)

. egen cyr = group(cid year)
(2,245 missing values generated)

. 
. capture which reghdfe

. if _rc {
.     ssc install ftools, replace
.     ssc install reghdfe, replace
. }

. 
. foreach z in z_gw z_n200 {
  2.     reghdfe ln_gaci `z', absorb(apid year) vce(cluster apid)
  3.     test `z'
  4.     local f1 = r(F)
  5.     local b1 = _b[`z']
  6.     local s1 = _se[`z']
  7.     local n1 = e(N)
  8.     reghdfe ln_gaci `z', absorb(apid cyr) vce(cluster apid)
  9.     test `z'
 10.     di "FS `z': ap+yr  b = " %9.4f `b1' " (se " %8.4f `s1' ")  F = " %8.1f `f1' " N = " %9.0f `n1'
 11.     di "FS `z': ap+cxy b = " %9.4f _b[`z'] " (se " %8.4f _se[`z'] ")  F = " %8.1f r(F) " N = " %9.0f e(N)
 12. }
