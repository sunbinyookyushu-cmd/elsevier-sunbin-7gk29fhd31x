. * ---- B1: first stage, lagged accident measures (cluster-robust partial F) ----
. foreach z in ash_deaths ash_com_deaths n_fatal n_major d_major d_fatal {
  2.     quietly reghdfe ln_gaci_cwm L.`z' lnpop ln_sea_ma, absorb(isocode y) vce(cluster isocode)
  3.     local bb = _b[L.`z']
  4.     local ss = _se[L.`z']
  5.     local pp = 2*normal(-abs(`bb'/`ss'))
  6.     quietly test L.`z'
  7.     local ff = r(F)
  8.     di "FS L.`z': b = " %9.4f `bb' " (se " %8.4f `ss' ")  partial F = " %7.1f `ff' "  N = " %8.0f e(N)
  9.     post `R' ("FS_lag") ("L.`z'") ("ln_gaci_cwm") (`bb') (`ss') (`pp') (`ff') (.) (e(N))
 10. }
FS L.ash_deaths: b =    0.0016 (se   0.0013)  partial F =     1.5  N =     4446
FS L.ash_com_deaths: b =    0.0022 (se   0.0014)  partial F =     2.3  N =     4446
FS L.n_fatal: b =    0.0035 (se   0.0017)  partial F =     4.2  N =     4446
FS L.n_major: b =    0.0027 (se   0.0090)  partial F =     0.1  N =     4446
FS L.d_major: b =    0.0017 (se   0.0100)  partial F =     0.0  N =     4446
FS L.d_fatal: b =    0.0042 (se   0.0040)  partial F =     1.1  N =     4446

. 
. * ---- B2: 2SLS, lagged accident IV alone ----
. foreach z in ash_deaths n_fatal d_fatal {
  2.     foreach yv in ln_co2_tot ln_co2_intl ln_intensity {
  3.         capture noisily quietly ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = L.`z'), absorb(isocode y) cluster(isocode)
  4.         if _rc == 0 {
  5.             local bb = _b[ln_gaci_cwm]
  6.             local ss = _se[ln_gaci_cwm]
  7.             local pp = 2*normal(-abs(`bb'/`ss'))
  8.             di "IV L.`z' -> `yv': b = " %9.3f `bb' " (se " %8.3f `ss' ")  KP F = " %7.1f e(widstat) "  N = " %8.0f e(N)
  9.             post `R' ("IV_asn") ("L.`z'") ("`yv'") (`bb') (`ss') (`pp') (e(widstat)) (.) (e(N))
 10.         }
 11.     }
 12. }
IV L.ash_deaths -> ln_co2_tot: b =     5.262 (se    3.412)  KP F =     1.5  N =     4446
IV L.ash_deaths -> ln_co2_intl: b =     4.239 (se    3.023)  KP F =     1.5  N =     4446
IV L.ash_deaths -> ln_intensity: b =    -0.284 (se    0.942)  KP F =     1.5  N =     4446
IV L.n_fatal -> ln_co2_tot: b =     5.588 (se    2.239)  KP F =     4.2  N =     4446
IV L.n_fatal -> ln_co2_intl: b =     4.572 (se    1.824)  KP F =     4.2  N =     4446
IV L.n_fatal -> ln_intensity: b =    -0.922 (se    0.692)  KP F =     4.2  N =     4446
IV L.d_fatal -> ln_co2_tot: b =     6.045 (se    4.832)  KP F =     1.1  N =     4446
IV L.d_fatal -> ln_co2_intl: b =     5.340 (se    4.284)  KP F =     1.1  N =     4446
IV L.d_fatal -> ln_intensity: b =    -1.020 (se    1.298)  KP F =     1.1  N =     4446

. 
. * ---- B3: over-ID, Feyrer + lagged accident IV jointly (cluster-robust Hansen J) ----
. foreach z in ash_deaths n_fatal {
  2.     foreach yv in ln_co2_tot ln_co2_intl ln_intensity {
  3.         capture noisily quietly ivreghdfe `yv' lnpop ln_sea_ma (ln_gaci_cwm = feyrer_int L.`z'), absorb(isocode y) cluster(isocode)
  4.         if _rc == 0 {
  5.             local bb = _b[ln_gaci_cwm]
  6.             local ss = _se[ln_gaci_cwm]
  7.             local pp = 2*normal(-abs(`bb'/`ss'))
  8.             local jp = e(jp)
  9.             di "OVERID feyrer+L.`z' -> `yv': b = " %9.3f `bb' " (se " %8.3f `ss' ")  KP F = " %7.1f e(widstat) "  Hansen J p = " %6.3f `jp' "  N = " %8.0f e(N)
 10.             post `R' ("OVERID") ("fey+L.`z'") ("`yv'") (`bb') (`ss') (`pp') (e(widstat)) (`jp') (e(N))
 11.         }
 12.     }
 13. }
